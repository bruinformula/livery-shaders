#ifndef ENTRY_CAMERA_PROJECTOR
    #define DEFAULT_CAMERA_PROJECTOR(x) = x
    #define ENTRY_CAMERA_PROJECTOR shader
#else
    #define DEFAULT_CAMERA_PROJECTOR(x)
#endif

ENTRY_CAMERA_PROJECTOR CameraProjector (

    // Camera parameters
    point camera        DEFAULT_CAMERA_PROJECTOR(0),
    point target        DEFAULT_CAMERA_PROJECTOR(0),
    vector right        DEFAULT_CAMERA_PROJECTOR(0),
    float fov           DEFAULT_CAMERA_PROJECTOR(0),
    vector aspect       DEFAULT_CAMERA_PROJECTOR(vector(16, 9, 0)),
    vector up           DEFAULT_CAMERA_PROJECTOR(vector(0, 0, 1)),

    // Projection controls
    float overScan      DEFAULT_CAMERA_PROJECTOR(0.0) [[ string label = "OverScan (percent)" ]],
    int backface        DEFAULT_CAMERA_PROJECTOR(0)   [[ string label = "Project on Back" ]],

    // Texture
    string filename     DEFAULT_CAMERA_PROJECTOR("uv-grid.png"),
    int autoGamma       DEFAULT_CAMERA_PROJECTOR(1),
    float manualGamma   DEFAULT_CAMERA_PROJECTOR(1.0),

    // Outputs
    output point uv     DEFAULT_CAMERA_PROJECTOR(0),
    output color col    DEFAULT_CAMERA_PROJECTOR(0),
    output float alpha DEFAULT_CAMERA_PROJECTOR(0)
)
{
    col = 0;
    alpha = 0;

    vector toTarget = normalize(target - camera);

    // Backface culling
    if (dot(transform("world", N), toTarget) > 0.0 && backface == 0)
        return;

    vector toRight = normalize(right);
    vector toTop   = cross(toRight, toTarget);

    vector toPoint = normalize(P - camera);
    float dotTarget = dot(toTarget, toPoint);

    // Must be in front of camera
    if (dotTarget <= 0.0)
        return;

    // Project to unit distance
    toPoint /= dotTarget;

    float aspectRatio = aspect[1] / aspect[0];
    float x = dot(toPoint, toRight);
    float y = dot(toPoint, toTop) / aspectRatio;

    float fovRadians = fov > M_PI ? radians(fov) : fov;
    float invTan = 1.0 / tan(fovRadians * 0.5);

    x *= invTan / (1.0 + overScan / 100.0);
    y *= invTan / (1.0 + overScan / 100.0);

    // Convert to 0–1 UV space
    x = (x + 1.0) * 0.5;
    y = (y + 1.0) * 0.5;

    uv = point(x, y, 0);

    // Outside projection
    if (x < 0.0 || x > 1.0 || y < 0.0 || y > 1.0)
        return;

    alpha = 1.0;
    col = texture(filename, x, 1.0 - y, "alpha", alpha);

    int channels = 0;
    gettextureinfo(filename, "channels", channels);

    if (channels < 4)
        alpha = 1.0;

    // Gamma handling
    if (autoGamma) {
        if (!endswith(filename, ".exr") &&
            !endswith(filename, ".EXR") &&
            !endswith(filename, ".hdr") &&
            !endswith(filename, ".HDR") &&
            !endswith(filename, ".tx")  &&
            !endswith(filename, ".TX")) {
            col = pow(col, 2.2);
        }
    } else if (manualGamma != 1.0) {
        col = pow(col, manualGamma);
    }
}
