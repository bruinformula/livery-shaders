#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.1
    upAxis = "Y"
    renderSettingsPrimPath = "/World/Render/RenderSettings"
)

def "World" (
    references = @colors.mtlx@</MaterialX>
)
{
    def Scope "ShadeBalls"
    {
        def Xform "Ball_RVinylOlympicBlue" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            references = @../assets/sphere.usda@</ShadeBall>
        )
        {
            rel material:binding = </World/Materials/RVinylOlympicBlue> (bindMaterialAs = "strongerThanDescendants")
            double3 xformOp:translate = (-2.5, 2.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "Ball_RVinylOceanBlue" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            references = @../assets/sphere.usda@</ShadeBall>
        )
        {
            rel material:binding = </World/Materials/RVinylOceanBlue> (bindMaterialAs = "strongerThanDescendants")
            double3 xformOp:translate = (0, 2.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "Ball_RVinylVividBlue" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            references = @../assets/sphere.usda@</ShadeBall>
        )
        {
            rel material:binding = </World/Materials/RVinylVividBlue> (bindMaterialAs = "strongerThanDescendants")
            double3 xformOp:translate = (2.5, 2.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "Ball_RVinylYellow" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            references = @../assets/sphere.usda@</ShadeBall>
        )
        {
            rel material:binding = </World/Materials/RVinylYellow> (bindMaterialAs = "strongerThanDescendants")
            double3 xformOp:translate = (-2.5, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "Ball_RVinylMediumYellow" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            references = @../assets/sphere.usda@</ShadeBall>
        )
        {
            rel material:binding = </World/Materials/RVinylMediumYellow> (bindMaterialAs = "strongerThanDescendants")
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "Ball_RVinylDarkYellow" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            references = @../assets/sphere.usda@</ShadeBall>
        )
        {
            rel material:binding = </World/Materials/RVinylDarkYellow> (bindMaterialAs = "strongerThanDescendants")
            double3 xformOp:translate = (2.5, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "Ball_ChassisRAL5011" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            references = @../assets/sphere.usda@</ShadeBall>
        )
        {
            rel material:binding = </World/Materials/ChassisRAL5011> (bindMaterialAs = "strongerThanDescendants")
            double3 xformOp:translate = (-2.5, -2.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "Ball_SuspensionRAL5015" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            references = @../assets/sphere.usda@</ShadeBall>
        )
        {
            rel material:binding = </World/Materials/SuspensionRAL5015> (bindMaterialAs = "strongerThanDescendants")
            double3 xformOp:translate = (0, -2.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "Ball_JackingPointRAL2009" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            references = @../assets/sphere.usda@</ShadeBall>
        )
        {
            rel material:binding = </World/Materials/JackingPointRAL2009> (bindMaterialAs = "strongerThanDescendants")
            double3 xformOp:translate = (2.5, -2.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Mesh "Background"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-5, -5, 0), (5, -5, 0), (5, 5, 0), (-5, 5, 0)]
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        double3 xformOp:translate = (0, 0, -2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "Camera"
    {
        float2 clippingRange = (0.001, 1000)
        float focalLength = 96
        float horizontalAperture = 36
        float verticalAperture = 36
        double3 xformOp:translate = (0, 0, 24)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Render"
    {
        def RenderSettings "RenderSettings"
        {
            rel camera = </World/Camera>
            rel products = </World/Render/Products/Beauty>
            int2 resolution = (256, 256)
        }

        def Scope "Products"
        {
            def RenderProduct "Beauty"
            {
                token productName = "out.exr"
                token productType = "raster"
            }
        }
    }

    def DomeLight "DomeLight1"
    {
        asset inputs:texture:file = @../assets/env.exr@
        token inputs:texture:format = "latlong"
    }
}

