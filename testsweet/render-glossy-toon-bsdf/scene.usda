#usda 1.0
(
    metersPerUnit = 0.1
    upAxis = "Y"
    defaultPrim = "World"
)

def "World" (
    references = @glossy_toon.mtlx@</MaterialX>
) {
    def Scope "ShadeBalls" {
        def Xform "Ball1" (
            prepend apiSchemas = [ "MaterialBindingAPI" ]
            instanceable = true
            references = @sphere.usda@</ShadeBall>
        ) {
            rel material:binding = </World/Materials/Glossy_Toon_1> (
                bindMaterialAs = "strongerThanDescendants"
            )

            double3 xformOp:translate = (1.5, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "Ball2" (
            prepend apiSchemas = [ "MaterialBindingAPI" ]
            instanceable = true
            references = @sphere.usda@</ShadeBall>
        ) {
            rel material:binding = </World/Materials/Glossy_Toon_2> (
                bindMaterialAs = "strongerThanDescendants"
            )

            double3 xformOp:translate = (-1.5, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Mesh "Background" {
        int[] faceVertexCounts  = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-5, -5, 0), (5, -5, 0), (5, 5, 0), (-5, 5, 0)]
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]

        double3 xformOp:translate = (0, 0, -2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DistantLight "KeyLight" {
        float inputs:intensity  = 1.0
        float inputs:exposure   = 0.0
        color3f inputs:color    = (1.0, 1.0, 1.0)
        float inputs:angle      = 0.53
        bool inputs:normalize   = 1

        double3 xformOp:rotateXYZ = (-45, 45, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Camera "Camera" {
        float2 clippingRange = (0.01, 100000)
        float focalLength = 36
        float verticalAperture = 36
        float horizontalAperture = 36
        double3 xformOp:translate = (0, 0, 8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    } 

    def Scope "Render" { 
        def RenderSettings "RenderSettings" {
            int2 resolution = (256, 256)
            rel camera = </World/Camera>
            rel products = </World/Render/Products/Beauty>
        }
        def Scope "Products" {
            def RenderProduct "Beauty" {
                token productType = "raster"
                token productName = "out-arnold.exr"
            }
        }
    }
}