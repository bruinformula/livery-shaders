      <input name="color" type="color3" value="0.8, 0.8, 0.8"/>
      <input name="size" type="float" value="0.5"/>
      <input name="smooth" type="float" value="0.0"/>
    </glossy_toon_bsdf>

  <surfacematerial name="Glossy_Toon_2" type="material">
