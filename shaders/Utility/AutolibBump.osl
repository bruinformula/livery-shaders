shader AutolibBump [[
    string category = "autolib"
]] (
    int Invert = 0 [[ string widget = "boolean", int min = 0, int max = 1, string help = "Invert the bump direction" ]],
    normal BaseNormal = N [[ string widget = "null", string help = "Base normal to perturb" ]],
    vector Tangent = dPdu [[ string widget = "null", string help = "Surface tangent" ]],
    vector Bitangent = dPdv [[ string widget = "null", string help = "Surface bitangent" ]],
    float Scale = 1.0 [[ float min = 0, int interactive = 1 ]],
    float Height = 0.0 [[ string widget = "null", string help = "Height value to bump from", int interpolated = 1 ]],
    output normal Normal = N
) {
    float scale = Scale;
    if (Invert) {
        scale *= -1.0;
    }

    float SOBEL_SCALE_FACTOR = 1.0 / 16.0;

    // Compute screen-space gradients of height and UVs.
    float dHdx = Dx(Height) * scale * SOBEL_SCALE_FACTOR;
    float dHdy = Dy(Height) * scale * SOBEL_SCALE_FACTOR;
    float dUdx = Dx(u);
    float dUdy = Dy(u);
    float dVdx = Dx(v);
    float dVdy = Dy(v);

    // Build a screen-space tangent frame from the height field.
    vector tgt = vector(dUdx, dVdx, dHdx);
    vector btn = vector(dUdy, dVdy, dHdy);
    vector n   = cross(tgt, btn);

    // Decode into a 0-1 encoded normal.
    vector heightNormal;
    if (dot(n, n) < 1e-16) {
        heightNormal = vector(0, 0, 1);
    } else if (n[2] < 0.0) {
        heightNormal = normalize(-n) * 0.5 + 0.5;
    } else {
        heightNormal = normalize(n) * 0.5 + 0.5;
    }

    vector v3 = heightNormal * 2.0 - 1.0;

    vector N_ = BaseNormal;
    vector Tn = normalize(Tangent - dot(Tangent, N_) * N_);
    vector Bn = normalize(Bitangent - dot(Bitangent, N_) * N_ - dot(Bitangent, Tn) * Tn);

    Normal = normalize(Tn * v3[0] + Bn * v3[1] + N_ * v3[2]);
}