// AutolibAmbientOcclusion

shader AutolibAmbientOcclusion [[
    string label = "Ambient Occlusion",
    string help = "Traces one jittered occlusion ray around the normal per sample: Occlusion is 1 in the open and "
                  "falls toward 0 as nearby geometry gets closer, and Color blends from Hit Color to Input Color "
                  "with it. Indirect diffuse rays get Input Color unoccluded, which keeps GI cheap.",
    string rfh_classification = "RenderMan/Autolib/Geometry",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/geometry"
]] (
    color InputColor = 1 [[
        string label = "Unoccluded Color",
        string help = "Color in the open."
    ]],
    color HitColor = 0 [[
        string label = "Occluded Color",
        string help = "Color where geometry is right next to the surface."
    ]],
    float AOAngle = 0.95 [[
        string label = "Spread",
        string help = "How far the occlusion rays scatter around the normal (0 straight along it).",
        float min = 0, float max = 2, int slider = 1
    ]],
    float MaxDistance = 25.0 [[
        string label = "Max Distance",
        string help = "Occluders further than this, in scene units, do not count; hits closer than it darken in proportion.",
        float min = 0, float slidermax = 50
    ]],
    vector BumpNormal = 0 [[
        string label = "Normal Offset",
        string help = "Added to the shading normal before tracing; connect a bump's offset to follow it."
    ]],

    output color Color = color(1, 0, 0) [[ string label = "Color" ]],
    output float Occlusion = 1 [[ string label = "Occlusion", string help = "1 unoccluded, 0 fully occluded." ]]
) {
    Color = InputColor;
    Occlusion = 1;
    if (raytype("diffuse"))
        return;

    // Jitter the trace direction around the normal with a hash of the shading position, so every
    // pixel sample gets its own direction and the pixel filter averages them (hashing the direction
    // itself repeats the same ray across a flat surface and shows as a grid).
    vector Nn = normalize(N + BumpNormal);
    vector jitter = 2 * (vector)noise("hash", P) - 1;
    vector DirTrace = normalize(Nn + AOAngle * jitter);
    if (dot(DirTrace, Nn) < 0)
        DirTrace = reflect(DirTrace, Nn);

    if (trace(P, DirTrace, "maxdist", MaxDistance)) {
        float hitDistance = MaxDistance;
        getmessage("trace", "hitdist", hitDistance);
        // a gradient between the two colors gives smoother AO than a hard hit / miss
        Occlusion = clamp(hitDistance / MaxDistance, 0.0, 1.0);
        Color = mix(HitColor, InputColor, Occlusion);
    }
}
