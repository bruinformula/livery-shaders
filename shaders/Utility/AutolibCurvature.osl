shader AutolibCurvature [[
    string label = "Curvature",
    string help = "Measures surface curvature by tracing short probe rays around the shading point: a principal "
                  "direction field for hatching and the Gaussian curvature.",
    string rfh_classification = "RenderMan/Autolib/Geometry",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/geometry"
]] (
    float SampleDist = 0.01 [[
        string label = "Sample Distance",
        string help = "Tangent-plane step size of the curvature probes, in scene units.",
        float min = 0, float slidermax = 0.1
    ]],
    float ProbeHeight = 0.02 [[
        string label = "Probe Height",
        string help = "How far above the tangent plane the probe rays start.",
        float min = 0, float slidermax = 0.1
    ]],
    float MaxDist = 1.0 [[
        string label = "Max Distance",
        string help = "Maximum trace distance of the probe rays.",
        float min = 0, float slidermax = 2
    ]],
    int NumSamples = 3 [[
        string label = "Samples",
        string help = "Number of equally spaced tangent directions sampled over a half turn (at least 3).",
        int min = 3, int slidermax = 16,
        int connectable = 0
    ]],

    output vector Field = 0 [[ string label = "Field", string help = "Principal direction field, for Curvature Basic Hatch." ]],
    output float GaussianCurvature = 0 [[ string label = "Gaussian Curvature", string help = "Positive on domes and bowls, negative on saddles, about 0 when flat." ]],
    output float Confidence = 0 [[ string label = "Confidence", string help = "Fraction of probes that hit." ]]
) {
    normal Nn = normalize(N);

    // Orthonormal tangent basis.
    vector U = dPdu - Nn * dot(dPdu, Nn);
    if (length(U) < 1e-6)
        U = cross(Nn, vector(0, 1, 0));
    if (length(U) < 1e-6)
        U = cross(Nn, vector(1, 0, 0));
    U = normalize(U);
    vector V = cross(Nn, U);

    float sumA = 0, sumB = 0, sumC = 0;
    int   hits = 0;

    for (int i = 0; i < NumSamples; i += 1) {
        float theta = M_PI * i / NumSamples;      // curvature is pi-periodic
        vector T = cos(theta) * U + sin(theta) * V;

        point  Pstart = P + T * SampleDist + Nn * ProbeHeight;
        vector Dir    = -Nn;

        int hit = trace(
            Pstart, Dir, 
            "mindist", 0.0001,
            "maxdist", MaxDist
        );

        if (hit) {
            normal Nhit = Nn; // fallback if the query fails
            int gotN = getmessage("trace", "N", Nhit);
            if (!gotN)
                gotN = getmessage("trace", "Ng", Nhit);   // geometric-normal fallback

            if (gotN) {
                Nhit = normalize(Nhit);
                float kappa = dot(Nn - Nhit, T) / SampleDist;

                sumA += kappa;
                sumB += kappa * cos(2.0 * theta);
                sumC += kappa * sin(2.0 * theta);
                hits += 1;
            }
        }
    }

    float A = sumA / hits;                    // mean curvature H = (k1+k2)/2
    float B = (2.0 / hits) * sumB;
    float C = (2.0 / hits) * sumC;

    // (B, C) is the 2-RoSy representation vector of the curvature tensor.
    float R2 = sqrt(B * B + C * C);            // (k1-k2)/2

    // Complex-square it into the 4-RoSy / cross-field representation
    // expected by CrossFieldHatch's FieldTex input:
    //   (X4, Y4) = (B + iC)^2 = (B^2 - C^2, 2BC)
    float X4 = B * B - C * C;
    float Y4 = 2.0 * B * C;

    // k1 = A + R2, k2 = A - R2  =>  K = k1*k2 = A^2 - R2^2
    GaussianCurvature = A * A - R2 * R2;

    Field = vector(X4, Y4, 0);
    Confidence = smoothstep(0.0, 0.02, R2);   // fades near-umbilic regions to 0 like on the poles of a sphere
}
