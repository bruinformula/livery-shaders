#ifndef NOT_MTX_IMPL   
    #define ENTRY_BUMP_TO_ROUGHNESS void 
#endif

#ifndef ENTRY_BUMP_TO_ROUGHNESS
    #define  DEFAULT_BUMP_TO_ROUGHNESS(x) = x
    #define ENTRY_BUMP_TO_ROUGHNESS shader
#else
    #define  DEFAULT_BUMP_TO_ROUGHNESS(x)
#endif

void computePartialDerivs(vector Q, float a, float b,
                          output vector dQda, output vector dQdb)
{
    vector dQdx = Dx(Q);
    vector dQdy = Dy(Q);
    
    float A = Dx(a);
    float B = Dx(b);
    float C = Dy(a);
    float D = Dy(b);
    
    float invdet = 1.0 / (A*D - B*C);

    dQda = (dQdx*D - dQdy*B) * invdet;
    dQdb = (dQdy*A - dQdx*C) * invdet;
}

void covarianceToEigen( float a, float b, float c,
                        output float l1, 
                        output float l2,
                        output vector v1, 
                        output vector v2 )
{
    float discriminant = sqrt(a*a + 4*b*b - 2*a*c + c*c);
    
    l1 = 0.5 * (a + c + discriminant);
    l2 = 0.5 * (a + c - discriminant);
    
    v1 = vector(0);
    v1[1] = 1;
    v1[0] = (l1 - c) / b;
    v1 = normalize(v1);
    
    v2 = vector(0);
    v2[1] = 1;
    v2[0] = (l2 - c) / b;
    v2 = normalize(v2);
}

ENTRY_BUMP_TO_ROUGHNESS BumpToRoughness (    
    vector UV  DEFAULT_BUMP_TO_ROUGHNESS(vector(u, v, 0)) [[ string doc = "UV coordinates for the surface" ]],
    vector bumpNormal  DEFAULT_BUMP_TO_ROUGHNESS(vector(0, 0, 1)) [[ string doc = "Input bump/normal vector (in tangent space or world space)" ]],
    
    int isTangentSpace  DEFAULT_BUMP_TO_ROUGHNESS(1) [[ string widget = "checkBox", string doc = "Is the input normal in tangent space (vs world space)?" ]],
    float baseRoughness  DEFAULT_BUMP_TO_ROUGHNESS(0.001) [[ string doc = "Base roughness at the micro-facet level", float uimin = 0.0, float uimax = 1.0 ]],
    float gain  DEFAULT_BUMP_TO_ROUGHNESS(1.0) [[ string doc = "Multiplier for aggregate roughness", float uimin = 0.0, float uimax = 10.0]],
    float anisotropyGain  DEFAULT_BUMP_TO_ROUGHNESS(1.0) [[ string doc = "Multiplier for aggregate anisotropy", float uimin = 0.0, float uimax = 2.0 ]],
    
    // Outputs
    output normal outNormal  DEFAULT_BUMP_TO_ROUGHNESS(N) [[ string doc = "Computed normal in world space" ]],
    output float outRoughness  DEFAULT_BUMP_TO_ROUGHNESS(0.0) [[ string doc = "Computed roughness value" ]],
    output float outAnisotropy  DEFAULT_BUMP_TO_ROUGHNESS(0.0) [[ string doc = "Computed anisotropy (0=isotropic, 1=max anisotropic)" ]],
    output vector outAnisotropyDirection  DEFAULT_BUMP_TO_ROUGHNESS(vector(0)) [[ string doc = "Direction of anisotropy in world space" ]],
    output float outRoughnessU  DEFAULT_BUMP_TO_ROUGHNESS(0.0) [[ string doc = "Roughness in U direction (major axis)" ]],
    output float outRoughnessV  DEFAULT_BUMP_TO_ROUGHNESS(0.0) [[ string doc = "Roughness in V direction (minor axis)" ]]
)
{
    vector pPps, pPpt;
    computePartialDerivs(P, UV.x, UV.y, pPps, pPpt);
    
    vector PN = cross(pPps, pPpt);
    
    int lefthanded = 0;
    if (dot(PN, Ng) < 0) {
        lefthanded = 1;
    }
    
    PN = normalize(N);
    if (lefthanded == 1) PN = -PN;
    pPps = normalize(cross(pPpt, PN));
    pPpt = cross(PN, pPps);
    
    vector worldNormal;
    if (isTangentSpace == 1) { // input is in tangent space, transform to world
        worldNormal = pPps * bumpNormal[0] + 
                        pPpt * bumpNormal[1] + 
                        PN * bumpNormal[2];
    } else {
        worldNormal = bumpNormal;
    }
    worldNormal = normalize(worldNormal);
    outNormal = worldNormal;

    // get derivatives of the input normal
    vector dNdu, dNdv;
    if (isTangentSpace == 1) {
        vector dNdx = Dx(bumpNormal);
        vector dNdy = Dy(bumpNormal);
        
        float A = Dx(UV.x);
        float B = Dx(UV.y);
        float C = Dy(UV.x);
        float D = Dy(UV.y);
        
        float invdet = 1.0 / (A*D - B*C);
        
        dNdu = (dNdx*D - dNdy*B) * invdet;
        dNdv = (dNdy*A - dNdx*C) * invdet;
    } else {
        computePartialDerivs(worldNormal, UV.x, UV.y, dNdu, dNdv);
    }
    
    // Project derivatives to tangent plane
    dNdu = dNdu - PN * dot(dNdu, PN);
    dNdv = dNdv - PN * dot(dNdv, PN);
    
    // Compute variance in slope
    float dx = length(dNdu);
    float dy = length(dNdv);
    
    // Build covariance matrix from surface curvature
    float vargain = gain * gain;
    float sxx = vargain * dx * dx;
    float syy = vargain * dy * dy;
    float sxy = vargain * dot(dNdu, dNdv);
    
    // Convert covariance to eigenspace
    float l1, l2;
    vector v1, v2;
    covarianceToEigen(sxx, sxy, syy, l1, l2, v1, v2);
    
    // Project eigenvectors to surface tangent space
    vector _pPpu = pPps * v1[0] + pPpt * v1[1];
    vector _pPpv = pPps * v2[0] + pPpt * v2[1];
    
    // Compute roughness from variance
    float base_roughsqr = baseRoughness * baseRoughness;
    float varianceU = l1 + base_roughsqr;
    float varianceV = l2 + base_roughsqr;
    
    float roughnessU = sqrt(varianceU) + 1e-12;
    float roughnessV = sqrt(varianceV) + 1e-12;
    
    // Compute anisotropy
    float rudivrv = roughnessU / roughnessV;
    outAnisotropy = (rudivrv - 1.0) / (rudivrv + 1.0);
    
    // Apply anisotropy gain
    if (anisotropyGain != 1.0) {
        outAnisotropy = clamp(outAnisotropy * anisotropyGain, 0.0, 1.0);
        
        float _alpha = 1.0 / (outAnisotropy * outAnisotropy - 
                                2.0 * outAnisotropy + 2.0);
        
        float variance = varianceU + varianceV;
        varianceU = variance * _alpha;
        varianceV = variance * (1.0 - _alpha);
        
        roughnessU = sqrt(varianceU);
        roughnessV = sqrt(varianceV);
    }

    outRoughness = roughnessU / (1.0 + outAnisotropy);
    outRoughnessU = roughnessU;
    outRoughnessV = roughnessV;
    outAnisotropyDirection = normalize(_pPpu);
}