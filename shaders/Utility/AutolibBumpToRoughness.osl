// AutolibBumpToRoughness

void computePartialDerivs(
    vector Q, float a, float b,           
    output vector dQda, 
    output vector dQdb
) {
    vector dQdx = Dx(Q);
    vector dQdy = Dy(Q);
    
    float A = Dx(a);
    float B = Dx(b);
    float C = Dy(a);
    float D = Dy(b);
    
    float invdet = 1.0 / (A*D - B*C);

    dQda = (dQdx*D - dQdy*B) * invdet;
    dQdb = (dQdy*A - dQdx*C) * invdet;
}

void covarianceToEigen( 
    float a, float b, float c,
    output float l1, 
    output float l2,
    output vector v1, 
    output vector v2
) {
    float discriminant = sqrt(a*a + 4*b*b - 2*a*c + c*c);
    
    l1 = 0.5 * (a + c + discriminant);
    l2 = 0.5 * (a + c - discriminant);
    
    v1 = vector(0);
    v1[1] = 1;
    v1[0] = (l1 - c) / b;
    v1 = normalize(v1);
    
    v2 = vector(0);
    v2[1] = 1;
    v2[0] = (l2 - c) / b;
    v2 = normalize(v2);
}

shader AutolibBumpToRoughness [[ 
    string category = "autolib" 
]] (    
    vector UV = vector(u, v, 0) [[ string help = "UV coordinates for the surface" ]],
    vector bumpNormal = vector(0, 0, 1) [[ string help = "Input bump/normal vector (in tangent space or world space)" ]],
    
    int isTangentSpace = 1 [[ string widget = "checkBox", string help = "Is the input normal in tangent space (vs world space)?" ]],
    float baseRoughness = 0.001 [[ string help = "Base roughness at the micro-facet level", float min = 0.0, float max = 1.0 ]],
    float gain = 1.0 [[ string help = "Multiplier for aggregate roughness", float min = 0.0, float max = 10.0 ]],
    float anisotropyGain = 1.0 [[ string help = "Multiplier for aggregate anisotropy", float min = 0.0, float max = 2.0 ]],
    
    // Outputs
    output normal outNormal = N [[ string help = "Computed normal in world space" ]],
    output float outRoughness = 0.0 [[ string help = "Computed roughness value" ]],
    output float outAnisotropy = 0.0 [[ string help = "Computed anisotropy (0=isotropic, 1=max anisotropic)" ]],
    output vector outAnisotropyDirection = vector(0) [[ string help = "Direction of anisotropy in world space" ]],
    output float outRoughnessU = 0.0 [[ string help = "Roughness in U direction (major axis)" ]],
    output float outRoughnessV = 0.0 [[ string help = "Roughness in V direction (minor axis)" ]]
) {

    vector pPps, pPpt;
    computePartialDerivs(P, UV.x, UV.y, pPps, pPpt);
    
    vector PN = cross(pPps, pPpt);
    
    int lefthanded = 0;
    if (dot(PN, Ng) < 0) {
        lefthanded = 1;
    }
    
    PN = normalize(N);
    if (lefthanded == 1) PN = -PN;
    pPps = normalize(cross(pPpt, PN));
    pPpt = cross(PN, pPps);
    
    vector worldNormal;
    if (isTangentSpace == 1) { // input is in tangent space, transform to world
        worldNormal = pPps * bumpNormal[0] + 
                        pPpt * bumpNormal[1] + 
                        PN * bumpNormal[2];
    } else {
        worldNormal = bumpNormal;
    }
    worldNormal = normalize(worldNormal);
    outNormal = worldNormal;

    // get derivatives of the input normal
    vector dNdu, dNdv;
    if (isTangentSpace == 1) {
        vector dNdx = Dx(bumpNormal);
        vector dNdy = Dy(bumpNormal);
        
        float A = Dx(UV.x);
        float B = Dx(UV.y);
        float C = Dy(UV.x);
        float D = Dy(UV.y);
        
        float invdet = 1.0 / (A*D - B*C);
        
        dNdu = (dNdx*D - dNdy*B) * invdet;
        dNdv = (dNdy*A - dNdx*C) * invdet;
    } else {
        computePartialDerivs(worldNormal, UV.x, UV.y, dNdu, dNdv);
    }
    
    // Project derivatives to tangent plane
    dNdu = dNdu - PN * dot(dNdu, PN);
    dNdv = dNdv - PN * dot(dNdv, PN);
    
    // Compute variance in slope
    float dxdu = dot(dNdu, pPps);
    float dxdv = dot(dNdv, pPps);
    float dydu = dot(dNdu, pPpt);
    float dydv = dot(dNdv, pPpt);

    float dx = dxdu; 
    float dy = dydv;

    float dxdx = dx*dx + dxdv*dxdv;
    float dydy = dy*dy + dydu*dydu;
    float dxdy = dx*dy + dxdv*dydu;

    float vargain = gain * gain;
    float sxx = 2*vargain*(dxdx - dx*dx);
    float sxy = 2*vargain*(dxdy - dx*dy);
    float syy = 2*vargain*(dydy - dy*dy);
    
    // Convert covariance to eigenspace
    float l1, l2;
    vector v1, v2;
    covarianceToEigen(sxx, sxy, syy, l1, l2, v1, v2);
    
    // Project eigenvectors to surface tangent space
    vector _pPpu = -pPps * v1[0] + pPpt * v1[1];
    vector _pPpv = -pPps * v2[0] + pPpt * v2[1];
    
    // Compute roughness from variance
    float base_roughsqr = baseRoughness * baseRoughness;
    float varianceU = l1 + base_roughsqr;
    float varianceV = l2 + base_roughsqr;
    
    float roughnessU = sqrt(varianceU) + 1e-12;
    float roughnessV = sqrt(varianceV) + 1e-12;
    
    // Compute anisotropy
    float rudivrv = roughnessU / roughnessV;
    outAnisotropy = (rudivrv - 1.0) / (rudivrv + 1.0);
    
    // Apply anisotropy gain
    if (anisotropyGain != 1.0) {
        outAnisotropy = clamp(outAnisotropy * anisotropyGain, 0.0, 1.0);
        
        float _alpha = 1.0 / (outAnisotropy * outAnisotropy - 
                                2.0 * outAnisotropy + 2.0);
        
        float variance = varianceU + varianceV;
        varianceU = variance * _alpha;
        varianceV = variance * (1.0 - _alpha);
        
        roughnessU = sqrt(varianceU);
        roughnessV = sqrt(varianceV);
    }

    outRoughness = roughnessU / (1.0 + outAnisotropy);
    outRoughnessU = roughnessU;
    outRoughnessV = roughnessV;
    outAnisotropyDirection = normalize(_pPpu);
}