// AutolibRYB

float cubicInterpolate(float t, float A, float B) {
    float weight = pow(t, 2) * (3 - 2*t);
    return A + weight * (B - A);
}

#define SUGITA 0
#define GOSSETT 1

shader AutolibRYB [[
    string label = "RYB Color",
    string help = "Mixes a color in the painter's red-yellow-blue model (Gossett and Chen), with extra white and "
                  "black, for intuitive paint-like color choices.",
    string rfh_classification = "RenderMan/Autolib/Color",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/color"
]] (
    float Red = 0.5 [[ string label = "Red", float min = 0, float max = 1, int slider = 1 ]],
    float Yellow = 0.5 [[ string label = "Yellow", float min = 0, float max = 1, int slider = 1 ]],
    float Blue = 0.5 [[ string label = "Blue", float min = 0, float max = 1, int slider = 1 ]],
    float White = 0.0 [[ string label = "White", string help = "Tints the result toward white.", float min = 0, float max = 1, int slider = 1 ]],
    float Black = 0.0 [[ string label = "Black", string help = "Shades the result toward black.", float min = 0, float max = 1, int slider = 1 ]],
    output color Color = 1 [[ string label = "Color" ]]
) {

    vector corners[8] = {
        {1,     1,     1    }, // [0] R=0,Y=0,B=0 - white
        {1,     1,     0    }, // [1] R=0,Y=1,B=0 - Yellow
        {1,     0,     0    }, // [2] R=1,Y=0,B=0 - Red
        {1,     0.5,   0    }, // [3] R=1,Y=1,B=0 - orange
        {0.163, 0.373, 0.6  }, // [4] R=0,Y=0,B=1 - Blue
        {0,     0.66,  0.2  }, // [5] R=0,Y=1,B=1 - green
        {0.5,   0,     0.5  }, // [6] R=1,Y=0,B=1 - purple
        {0.2,   0.094, 0    }  // [7] R=1,Y=1,B=1 - dark brown
    };

    // Paint-like mixing: white reduces pigment, black increases pigment density.
    float r = Red;
    float y = Yellow;
    float b = Blue;

    float pigmentScale = 1.0 - White;
    r *= pigmentScale;
    y *= pigmentScale;
    b *= pigmentScale;

    color rgb;
    for (int i = 0; i < 3; i++) {
        float x0 = cubicInterpolate(b, corners[0][i], corners[4][i]);
        float x1 = cubicInterpolate(b, corners[1][i], corners[5][i]);
        float x2 = cubicInterpolate(b, corners[2][i], corners[6][i]);
        float x3 = cubicInterpolate(b, corners[3][i], corners[7][i]);
        float y0 = cubicInterpolate(y, x0, x1);
        float y1 = cubicInterpolate(y, x2, x3);
        rgb[i]   = cubicInterpolate(r, y0, y1);
    }

    Color = rgb;

    if (Black > 0.0) {
        // Black pigment darkens after RYB->RGB conversion.
        Color = mix(Color, color(0, 0, 0), Black);
    }
    
}