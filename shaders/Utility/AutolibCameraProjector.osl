// AutolibCameraProjector

shader AutolibCameraProjector [[
    string label = "Camera Projector",
    string help = "Projects an image onto the surface from a virtual camera (position, target, up / right vectors "
                  "and field of view), returning the projected UVs, color and alpha.",
    string rfh_classification = "RenderMan/Autolib/Decal",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/decal"
]] (
    string Filename = "" [[
        string label = "Image",
        string help = "Image to project.",
        string widget = "assetIdInput",
        string options = "texture",
        int connectable = 0,
        string page = "Image",
        int page_open = 1
    ]],
    int UseWidthImageAspect = 1 [[
        string label = "Use Image Aspect",
        string help = "Take the aspect ratio from the image resolution instead of Aspect.",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Image"
    ]],
    vector Aspect = vector(1, 1, 0) [[
        string label = "Aspect",
        string help = "Width and height of the projection (only the ratio matters).",
        string page = "Image",
        string conditionalVisOp = "equalTo",
        string conditionalVisPath = "../UseWidthImageAspect",
        string conditionalVisValue = "0"
    ]],

    point CameraPosition = 0 [[
        string label = "Camera Position",
        string help = "Projector position (world space, or object space with Object Space on).",
        string page = "Camera",
        int page_open = 1
    ]],
    point TargetPosition = 0 [[
        string label = "Target Position",
        string help = "Point the projector looks at.",
        string page = "Camera"
    ]],
    vector RightDirection = vector(0, 1, 0) [[
        string label = "Right Direction",
        string help = "Projector's horizontal axis.",
        string page = "Camera"
    ]],
    vector UpDirection = vector(0, 0, 1) [[
        string label = "Up Direction",
        string help = "Projector's vertical axis.",
        string page = "Camera"
    ]],
    float FOV = 1 [[
        string label = "Field of View",
        string help = "Horizontal field of view, in radians (values above pi are read as degrees).",
        float min = 0, float slidermax = 3.14159,
        string page = "Camera"
    ]],
    float OverScan = 0.0 [[
        string label = "Overscan",
        string help = "Extra coverage around the frame, in percent.",
        float min = 0, float slidermax = 50,
        string page = "Camera"
    ]],
    int ObjectSpace = 0 [[
        string label = "Object Space",
        string help = "Camera inputs are in object space, so the projection moves with the object.",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Camera"
    ]],
    int Backface = 0 [[
        string label = "Project on Back",
        string help = "Also project onto surfaces facing away from the projector.",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Camera"
    ]],

    output point UV = 0 [[ string label = "UV", string help = "Projected coordinates (0-1 inside the frame)." ]],
    output float Alpha = 0 [[ string label = "Alpha", string help = "Image alpha inside the frame, 0 outside." ]],
    output color Color = 0 [[ string label = "Color" ]]
) {
    point camPos, targetPos, surfacePos;
    vector rightDir, upDir, surfaceNormal;

    int textureExists = 0;
    gettextureinfo(Filename, "exists", textureExists);
    if (!textureExists)
        return;
    
    if (ObjectSpace) {
        camPos        = transform("", "object", CameraPosition);
        targetPos     = transform("", "object", TargetPosition);
        rightDir      = normalize(transform("", "object", RightDirection));
        upDir         = normalize(transform("", "object", UpDirection));
        surfacePos    = transform("object", P);
        surfaceNormal = normalize(transform("", "object", N));
    } else {
        camPos        = CameraPosition;
        targetPos     = TargetPosition;
        rightDir      = normalize(RightDirection);
        upDir         = normalize(UpDirection);
        surfacePos    = P;
        surfaceNormal = N;
    }

    vector toTarget = normalize(targetPos - camPos);

    // Backface culling
    if (dot(surfaceNormal, toTarget) > 0.0 && Backface == 0)
        return;

    vector toRight = normalize(rightDir);
    vector toTop   = cross(toRight, toTarget);

    vector toPoint = normalize(surfacePos - camPos);
    float dotTarget = dot(toTarget, toPoint);

    if (dotTarget <= 0.0)
        return;

    toPoint /= dotTarget;

    float aspectRatio;
    if (UseWidthImageAspect) {
        int resolution[2];
        gettextureinfo(Filename, "resolution", resolution);
        aspectRatio = (float)resolution[1] / (float)resolution[0];
    } else {
        aspectRatio = Aspect[1] / Aspect[0];
    }

    float U = dot(toPoint, toRight);
    float V = dot(toPoint, toTop) / aspectRatio;

    float fovRadians = FOV > M_PI ? radians(FOV) : FOV;
    float invTan = 1.0 / tan(fovRadians * 0.5);

    U *= invTan / (1.0 + OverScan / 100.0);
    V *= invTan / (1.0 + OverScan / 100.0);

    U = (U + 1.0) * 0.5;
    V = (V + 1.0) * 0.5;

    if (U < 0.0 || U > 1.0 || V < 0.0 || V > 1.0)
        return;

    UV = point(U, V, 0);

    Color = texture(Filename, U, 1.0 - V, "alpha", Alpha);

    int channels = 0;
    gettextureinfo(Filename, "channels", channels);
    if (channels < 4)
        Alpha = 1.0;
}