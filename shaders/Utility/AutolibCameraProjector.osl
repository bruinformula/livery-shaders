// AutolibCameraProjector

shader AutolibCameraProjector [[ 
    string category = "autolib" 
]] (
    string filename = "" [[ string page = "Decal" ]],
    vector aspect = vector(1, 1, 0) [[ string help = "Aspect ratio (width/height) of the projection" ]],
    int useWidthImageAspect = 1 [[ int min = 0, int max = 1 ]],

    // Camera parameters
    point cameraPosition = 0,
    point targetPosition = 0,
    vector rightDirection = vector(0,1,0),
    vector upDirection = vector(0,0,1),

    // Projection controls
    float fov = 1 [[ float min = 0 ]],
    float overScan = 0.0 [[ float min = 0 ]],
    int backface = 0 [[ string label = "Project on Back", int min = 0, int max = 1 ]],
    int objectSpace = 0 [[ int min = 0, int max = 1 ]],

    // Outputs
    output point outUV = 0,
    output float outAlpha = 0,
    output color outColor = 0
) {
    point camPos, targetPos, surfacePos;
    vector rightDir, upDir, surfaceNormal;

    int textureExists = 0;
    gettextureinfo(filename, "exists", textureExists);
    if (!textureExists)
        return;
    
    if (objectSpace) {
        camPos        = transform("", "object", cameraPosition);
        targetPos     = transform("", "object", targetPosition);
        rightDir      = normalize(transform("", "object", rightDirection));
        upDir         = normalize(transform("", "object", upDirection));
        surfacePos    = transform("object", P);
        surfaceNormal = normalize(transform("", "object", N));
    } else {
        camPos        = cameraPosition;
        targetPos     = targetPosition;
        rightDir      = normalize(rightDirection);
        upDir         = normalize(upDirection);
        surfacePos    = P;
        surfaceNormal = N;
    }

    vector toTarget = normalize(targetPos - camPos);

    // Backface culling
    if (dot(surfaceNormal, toTarget) > 0.0 && backface == 0)
        return;

    vector toRight = normalize(rightDir);
    vector toTop   = cross(toRight, toTarget);

    vector toPoint = normalize(surfacePos - camPos);
    float dotTarget = dot(toTarget, toPoint);

    if (dotTarget <= 0.0)
        return;

    toPoint /= dotTarget;

    float aspectRatio;
    if (useWidthImageAspect) {
        int resolution[2];
        gettextureinfo(filename, "resolution", resolution);
        aspectRatio = (float)resolution[1] / (float)resolution[0];
    } else {
        aspectRatio = aspect[1] / aspect[0];
    }

    float U = dot(toPoint, toRight);
    float V = dot(toPoint, toTop) / aspectRatio;

    float fovRadians = fov > M_PI ? radians(fov) : fov;
    float invTan = 1.0 / tan(fovRadians * 0.5);

    U *= invTan / (1.0 + overScan / 100.0);
    V *= invTan / (1.0 + overScan / 100.0);

    U = (U + 1.0) * 0.5;
    V = (V + 1.0) * 0.5;

    if (U < 0.0 || U > 1.0 || V < 0.0 || V > 1.0)
        return;

    outUV = point(U, V, 0);

    outColor = texture(filename, U, 1.0 - V, "alpha", outAlpha);

    int channels = 0;
    gettextureinfo(filename, "channels", channels);
    if (channels < 4)
        outAlpha = 1.0;
}