#include "Decal.h"

float median(float r, float g, float b) {
    return max(min(r, g), min(max(r, g), b));
}

void computeWorldUV(
    output DecalData Data
) {
    // We need delP/delU and delP/delV — the world-space tangent vectors for the input UV
    // OSL gives us derivatives w.r.t. two screen differentials x,y:
    //
    //   dPdx = delP/delx    dPdy = delP/dely
    //
    //   dUdx = delU/delx    dUdy = delU/dely
    //   dVdx = delV/delx    dVdy = delV/dely
    //
    // By the chain rule:
    //   dPdx = delP/delU * dUdx + delP/delV * dVdx
    //   dPdy = delP/delU * dUdy + delP/delV * dVdy
    //
    // A 2×2 system (per component of P).  Inverting the
    // UV Jacobian gives us delP/delU and delP/delV.

    vector dPdx = Dx(P);
    vector dPdy = Dy(P);

    vector dUVdx = Dx(Data.UV);
    vector dUVdy = Dy(Data.UV);

    float dUdx = dUVdx.x;
    float dVdx = dUVdx.y;
    float dUdy = dUVdy.x;
    float dVdy = dUVdy.y;

    // Determinant of the UV Jacobian
    float det = dUdx * dVdy - dVdx * dUdy;

    float worldPerU, worldPerV;

    if (abs(det) < 1e-12) return;

    // delP/delU = ( dVdy * dPdx - dVdx * dPdy) / det
    // delP/delV = (-dUdy * dPdx + dUdx * dPdy) / det
    vector dPdU = ( dVdy * dPdx - dVdx * dPdy) / det;
    vector dPdV = (-dUdy * dPdx + dUdx * dPdy) / det;

    worldPerU = length(dPdU);
    worldPerV = length(dPdV);

    if (worldPerU <= 0) return;
    if (worldPerV <= 0) return;

    Data.WorldPerU = worldPerU;
    Data.WorldPerV = worldPerV;
}

shader AutolibDecal [[ 
    string category = "autolib",
    string help = "The driving UV set used to orient and scale the decal. "
                  "In 'Sticker Mode', the shader uses this coordinate's "
                  "world-space derivatives to ensure the decal maintains "
                  "its physical width regardless of geometry density."
]] (
    point UV = point(u,v,0) [[ string help = "If in sticker mode, this is used as a base space in mapping from screenspace to world space." ]],
    vector Offset = 0 [[ string help = "Offset applied to the decal projection", int interactive = 1, vector min = -1, vector max = 1 ]],
    float Rotation = 0 [[ string help = "Rotation in degrees around the decal center", int interactive = 1 ]],
    vector Scale = 1 [[ string help = "Scale multiplier for the decal size", int interactive = 1 ]],
    int DisableChaining = 0 [[ string help = "Disables chaining inputs", string widget = "boolean", int min = 0, int max = 1 ]],
    string Filename = "" [[ string path = "file" ]],

    float Width = 0.1 [[ string page = "Texture", string help = "The width of the decal in the specified units. Image maintains aspect ratio", int interactive = 1 ]],
    string Units = "m" [[ string page = "Texture", string widget = "units" ]],
    int StickerMode = 1 [[ string page = "Texture", string widget = "boolean", int min = 0, int max = 1, string help = "UV sizing correction for images to maintain their size in world space" ]],

    float DistanceRange = 6.0 [[ string page = "Texture", float min = 0, string help = "The distance range in world units that the MSDF texture encodes" ]],
    int IsMSDFTexture = 1 [[ string page = "Texture", string widget = "boolean", int min = 0, int max = 1, string help = "Whether the input texture is an MSDF (multi-channel signed distance field) or a regular alpha texture", int interactive = 1 ]],
    float SDFBlurAmount = 0 [[ string page = "Texture", float min = 0, float max = 1, string help = "Blurs the texture read of the SDF channel", int interactive = 1 ]],
    string ColorSpace = "linear" [[ string page = "Texture", string widget = "null" ]],

    // Outputs
    DecalData OtherData = {} [[ string widget = "null" ]], 
    output DecalData Data = {},
    output float Mask = 0 [[ string help = "Clean linework computed from the SDF" ]],
    output float Height = 1 [[ string help = "Accumulation of the decal mask values" ]],
    output float SDFDistance = 0 [[ string help = "Distance from the edge of the decal. Use for wear patterns or whatever." ]],
) {
    if (DisableChaining && isconnected(OtherData)) {
        Data = OtherData;
        Mask = OtherData.Mask;
        Height = OtherData.Height;
        SDFDistance = OtherData.SDFDistance;
        return;
    }

    int textureExists = 0;
    gettextureinfo(Filename, "exists", textureExists);
    if (!textureExists)
        return;
    
    int resolution[2]; // X, Y
    if (!gettextureinfo(Filename, "resolution", resolution))
        return;

    float aspectRatio = (float)resolution[1] / (float)resolution[0];

    // Compute decal dimensions in the specified unit space.
    // The user sets `width`; height follows from the image aspect ratio.
    vector worldDim = transform(Units, "world", vector(Width, Width * aspectRatio, 0));

    int isConnectedUV = isconnected(UV);
    if (isConnectedUV) {
        Data.UV = UV;
    } else {
        Data.UV = OtherData.UV;
    }

    if (!isconnected(OtherData) || isConnectedUV) {
        computeWorldUV(Data);
    } else {
        Data.WorldPerU = OtherData.WorldPerU;
        Data.WorldPerV = OtherData.WorldPerV;
    }

    float U, V;
    if (StickerMode) {
        float uvSpanU = worldDim.x / Data.WorldPerU;
        float uvSpanV = worldDim.y / Data.WorldPerV;

        U = (Data.UV.x - 0.5) / uvSpanU + 0.5;
        V = (Data.UV.y - 0.5) / uvSpanV + 0.5;
    } else {
        point UVw = transform("world", Data.UV);

        float centerU = 0.5;
        float centerV = 0.5;

        U = ((UVw.x - centerU) / worldDim.x) + 0.5;
        V = ((UVw.y - centerV) / worldDim.y) + 0.5;
    }
    // early exit outside the decal rectangle
    //if (SDFBlurAmount == 0 && (U < 0.0 || U > 1.0 || V < 0.0 || V > 1.0)) return;

    float uCentered = U - 0.5;
    float vCentered = V - 0.5;

    float scaleU = (abs(Scale.x) > 1e-6) ? Scale.x : 1.0;
    float scaleV = (abs(Scale.y) > 1e-6) ? Scale.y : 1.0;

    uCentered /= scaleU;
    vCentered /= scaleV;

    if (Rotation != 0) {
        float angle = radians(Rotation);
        float cosA = cos(angle);
        float sinA = sin(angle);

        float uRot = uCentered * cosA - vCentered * sinA;
        float vRot = uCentered * sinA + vCentered * cosA;

        uCentered = uRot;
        vCentered = vRot;
    }

    U = uCentered + 0.5;
    V = vCentered + 0.5;

    U -= Offset.x;
    V -= Offset.y;

    point texCoord = point(U, 1-V, 0);

    if (!IsMSDFTexture) {
        color dummy = texture(Filename, texCoord.x, texCoord.y, "firstchannel", 3, "colorspace", ColorSpace, "alpha", Mask);
        Data.Mask = max(OtherData.Mask, Mask);
        Data.Height = OtherData.Height + Mask;
        Data.SDFDistance = OtherData.SDFDistance;
        Data.SDFMedian = OtherData.SDFMedian;
        Data.PxRange = OtherData.PxRange;
        return;
    }

    // Does the renderer actually support colorspace?
    color texel = texture(Filename, texCoord.x, texCoord.y, "colorspace", ColorSpace);
    float dist = median(texel.r, texel.g, texel.b);

    int res[2] = {1, 1};
    gettextureinfo(Filename, "resolution", res); 
    
    float unitRangeX = DistanceRange / (float)res[0];
    float unitRangeY = DistanceRange / (float)res[1];
    
    float fwU = filterwidth(texCoord.x);
    float fwV = filterwidth(texCoord.y);
    
    float screenTexSizeX = (fwU > 1e-6) ? (1.0 / fwU) : 0.0;
    float screenTexSizeY = (fwV > 1e-6) ? (1.0 / fwV) : 0.0;
    
    float pxRange = max(0.5 * (unitRangeX * screenTexSizeX + unitRangeY * screenTexSizeY), 1.0);
    
    // Calculate final pixel distance and opacity
    float pxDist = pxRange * (dist - 0.5);

    Mask = clamp(pxDist + 0.5, 0.0, 1.0);
    SDFDistance = texture(
        Filename, texCoord.x, texCoord.y, 
        "blur", SDFBlurAmount, 
        "firstchannel", 3, 
        "fill", 0.0,
        "swrap", "black",
        "twrap", "black"
    );

    Data.Mask = max(OtherData.Mask, Mask);
    Data.SDFDistance = max(OtherData.SDFDistance, SDFDistance);
    Data.Height = OtherData.Height + Mask;
    Data.SDFMedian = dist;
    Data.PxRange = pxRange;
}
    