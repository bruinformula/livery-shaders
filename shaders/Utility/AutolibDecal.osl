#include "Decal.h"

float median(float r, float g, float b) {
    return max(min(r, g), min(max(r, g), b));
}

void computeWorldUV(
    output DecalData Data
) {
    vector dPdx = Dx(P);
    vector dPdy = Dy(P);

    vector dUVdx = Dx(Data.UV);
    vector dUVdy = Dy(Data.UV);

    float dUdx = dUVdx.x;
    float dVdx = dUVdx.y;
    float dUdy = dUVdy.x;
    float dVdy = dUVdy.y;

    float det = dUdx * dVdy - dVdx * dUdy;

    float worldPerU, worldPerV;

    if (abs(det) < 1e-12) return;

    vector dPdU = ( dVdy * dPdx - dVdx * dPdy) / det;
    vector dPdV = (-dUdy * dPdx + dUdx * dPdy) / det;

    worldPerU = length(dPdU);
    worldPerV = length(dPdV);

    if (worldPerU <= 0) return;
    if (worldPerV <= 0) return;

    Data.WorldPerU = worldPerU;
    Data.WorldPerV = worldPerV;
}

// The mesh UVs. Arnold's u,v on a mesh are its UVs; RenderMan's are per-face parametric coordinates,
// so read the st primvar when the renderer exposes it (the default of the UV input).
point meshUV() {
    float st[2];
    if (getattribute("primvar", "st", st))
        return point(st[0], st[1], 0);
    return point(u, v, 0);
}

shader AutolibDecal [[
    string label = "Decal",
    string help = "Places an image (MSDF or plain alpha) on the surface by UV: offset, rotated, scaled and sized "
                  "to a physical width with the image's aspect ratio. Decals chain through Other Data so a stack "
                  "of logos comes out of the last node as one color / mask. Sticker Mode keeps the decal's world "
                  "size independent of the UV layout.",
    string rfh_classification = "RenderMan/Autolib/Decal",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/decal"
]] (
    point UV = meshUV() [[
        string label = "UV",
        string help = "UVs the decal is placed in. Defaults to the mesh UVs; a chained decal without a UV "
                      "connection uses the UVs of the decal below it. In Sticker Mode the UV derivatives map "
                      "screen space to world space."
    ]],
    string Filename = "" [[
        string label = "Image",
        string help = "Decal image. Use a RenderMan texture written with its source size in the AutolibResolution "
                      "attribute (power-of-two textures are stretched; the attribute restores the aspect ratio).",
        string widget = "fileInput",
        int connectable = 0,
        string page = "Image",
        int page_open = 1
    ]],
    int IsMSDFTexture = 1 [[
        string label = "MSDF Image",
        string help = "The image is a multi-channel signed distance field (crisp edges at any size) rather than a plain alpha image.",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Image"
    ]],
    float DistanceRange = 6.0 [[
        string label = "Distance Range",
        string help = "Distance range, in texels, that the MSDF encodes (msdfgen -pxrange).",
        float min = 0, float slidermax = 16,
        string page = "Image",
        string conditionalVisOp = "equalTo",
        string conditionalVisPath = "../IsMSDFTexture",
        string conditionalVisValue = "1"
    ]],
    float SDFBlurAmount = 0 [[
        string label = "Edge Blur",
        string help = "Softens the edge read from the distance field.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Image",
        string conditionalVisOp = "equalTo",
        string conditionalVisPath = "../IsMSDFTexture",
        string conditionalVisValue = "1"
    ]],
    string ColorSpace = "linear" [[
        string label = "Color Space",
        string widget = "null",
        int connectable = 0,
        string page = "Image"
    ]],
    color ColorIn = 1 [[
        string label = "Color",
        string help = "Decal color (MSDF and alpha images) or tint.",
        string page = "Image"
    ]],

    float Width = 0.1 [[
        string label = "Width",
        string help = "Width of the decal in UV units (scene units in Sticker Mode); the height follows the image aspect ratio.",
        float min = 0, float slidermax = 1,
        string page = "Placement",
        int page_open = 1
    ]],
    vector Offset = 0 [[
        string label = "Offset",
        string help = "Moves the decal centre from the UV origin.",
        float slidermin = -1, float slidermax = 1,
        string page = "Placement",
        int interactive = 1
    ]],
    float Rotation = 0 [[
        string label = "Rotation",
        string help = "Rotation in degrees about the decal centre.",
        float slidermin = -180, float slidermax = 180,
        string page = "Placement",
        int interactive = 1
    ]],
    vector Scale = 1 [[
        string label = "Scale",
        string help = "Extra scale on top of Width.",
        float slidermin = 0, float slidermax = 4,
        string page = "Placement",
        int interactive = 1
    ]],
    int StickerMode = 0 [[
        string label = "Sticker Mode",
        string help = "Size the decal in scene units using the UV derivatives, so it keeps its physical size however the UVs are laid out.",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Placement"
    ]],

    DecalData OtherData = {} [[
        string label = "Other Data",
        string help = "Connect the Data output of the decal below this one; decals chain bottom to top and the last node holds the combined result.",
        string page = "Chaining"
    ]],
    int DisableChaining = 0 [[
        string label = "Disable Chaining",
        string help = "Ignore Other Data and output only this decal.",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Chaining"
    ]],

    output DecalData Data = {} [[ string label = "Data", string help = "The decal stack so far, for the next decal's Other Data." ]],
    output float Height = 0 [[ string label = "Height", string help = "Accumulated decal mask, for a bump." ]],
    output float Mask = 0 [[ string label = "Mask", string help = "Coverage of the decal stack." ]],
    output float SDFDistance = 0 [[ string label = "Edge Distance", string help = "Distance from the decal edge, for wear or outlines." ]],
    output color Color = 0 [[ string label = "Color", string help = "Color of the decal stack." ]]
) {
    if (DisableChaining && isconnected(OtherData)) {
        Data = OtherData;
        Color = Data.Color;
        Mask = Data.Mask;
        Height = Data.Height;
        SDFDistance = Data.SDFDistance;
        return;
    }

    if (Filename == "" || !isconstant(Filename))
        return;

    int textureExists = 0;
    gettextureinfo(Filename, "exists", textureExists);
    if (!textureExists)
        return;
    
    // RenderMan only reads power-of-two textures, so non-pow2 decals are stretched on conversion
    // and carry their source size in an AutolibResolution attribute.
    int resolution[2];
    if (!gettextureinfo(Filename, "AutolibResolution", resolution) &&
        !gettextureinfo(Filename, "resolution", resolution))
        return;

    float aspectRatio = (float)resolution[1] / (float)resolution[0];

    //float sceneUnitsPerMeter = length(transform("common", "world", vector(1, 0, 0)));
    //float widthWorld = Width * unitToMeters(Units) * sceneUnitsPerMeter;
    //vector worldDim = vector(widthWorld, widthWorld * aspectRatio, 0);

    float widthWorld = Width;
    vector worldDim = vector(widthWorld, widthWorld * aspectRatio, 0);

    int isConnectedUV = isconnected(UV);
    if (isConnectedUV) {
        Data.UV = UV;
    } else {
        Data.UV = isconnected(OtherData) ? OtherData.UV : UV;  // the first decal of a chain falls back to the mesh UVs
    }

    if (!isconnected(OtherData) || isConnectedUV) {
        computeWorldUV(Data);
    } else {
        Data.WorldPerU = OtherData.WorldPerU;
        Data.WorldPerV = OtherData.WorldPerV;
    }

    float U, V;
    if (StickerMode) {
        float uvSpanU = worldDim.x / Data.WorldPerU;
        float uvSpanV = worldDim.y / Data.WorldPerV;

        U = (Data.UV.x - 0.5) / uvSpanU + 0.5;
        V = (Data.UV.y - 0.5) / uvSpanV + 0.5;
    } else {
        // Data.UV is a texture coordinate, not a position: no space transform. (In Arnold and in
        // RenderMan renders "common" is world so a transform was a no-op, but RenderMan's pattern
        // bake shades in another common space and it rotated V into Z.)
        point UVw = Data.UV;

        float centerU = 0.5;
        float centerV = 0.5;

        U = ((UVw.x - centerU) / worldDim.x) + 0.5;
        V = ((UVw.y - centerV) / worldDim.y) + 0.5;
    }

    float uCentered = U - 0.5;
    float vCentered = V - 0.5;

    if (Rotation != 0) {
        float angle = radians(Rotation);
        float cosA = cos(angle);
        float sinA = sin(angle);

        float vPhysical = vCentered * aspectRatio;

        float uRot = uCentered * cosA - vPhysical * sinA;
        float vRot = uCentered * sinA + vPhysical * cosA;

        uCentered = uRot;
        vCentered = vRot / aspectRatio;
    }

    float scaleU = (abs(Scale.x) > 1e-6) ? Scale.x : 1.0;
    float scaleV = (abs(Scale.y) > 1e-6) ? Scale.y : 1.0;

    uCentered /= scaleU;
    vCentered /= scaleV;

    U = uCentered + 0.5;
    V = vCentered + 0.5;

    U -= Offset.x;
    V -= Offset.y;

    point texCoord = point(U, 1-V, 0);

    if (!IsMSDFTexture) {
        color dummy = texture(Filename, texCoord.x, texCoord.y, "firstchannel", 3, "alpha", Mask);
        Data.Mask = max(OtherData.Mask, Mask);
        Data.Height = OtherData.Height + Mask;
        Data.SDFDistance = OtherData.SDFDistance;
        Data.Color = mix(OtherData.Color, ColorIn, Mask);
        Data.SDFMedian = OtherData.SDFMedian;
        Data.PxRange = OtherData.PxRange;
        Mask = Data.Mask;
        Height = Data.Height;
        SDFDistance = Data.SDFDistance;
        return;
    }

    color texel = texture(
        Filename, texCoord.x, texCoord.y,
        "swrap", "clamp",
        "twrap", "clamp"
    );
    float dist = median(texel.r, texel.g, texel.b);

    int res[2] = {resolution[0], resolution[1]};
    
    float unitRangeX = DistanceRange / (float)res[0];
    float unitRangeY = DistanceRange / (float)res[1];
    
    float fwU = filterwidth(texCoord.x);
    float fwV = filterwidth(texCoord.y);
    
    float screenTexSizeX = (fwU > 1e-6) ? (1.0 / fwU) : 0.0;
    float screenTexSizeY = (fwV > 1e-6) ? (1.0 / fwV) : 0.0;
    
    float pxRange = max(0.5 * (unitRangeX * screenTexSizeX + unitRangeY * screenTexSizeY), 1.0);
    
    // Measure how far past the 0..1 border we are in UV coordinates
    float uDist = max(0.0, max(-texCoord.x, texCoord.x - 1.0));
    float vDist = max(0.0, max(-texCoord.y, texCoord.y - 1.0));
    
    // Convert UV boundary spill directly into an absolute pixel distance
    float spillPxDist = length(vector(uDist * screenTexSizeX, vDist * screenTexSizeY, 0.0));

    // Calculate real pixel distance inside the texture space
    float pxDist = pxRange * (dist - 0.5);

    // If we've spilled outside the texture box, seamlessly subtract our raw pixel offset 
    if (spillPxDist > 0.0) {
        pxDist -= spillPxDist;
        // Re-encode a normalized dist that remains proportional to the local pxRange
        dist = (pxDist / pxRange) + 0.5;
    }

    Mask = clamp(pxDist + 0.5, 0.0, 1.0);
    
    SDFDistance = texture(Filename, texCoord.x, texCoord.y, "blur", SDFBlurAmount, "firstchannel", 3, "fill", 0.0, "swrap", "black", "twrap", "black");
    Data.Mask = max(OtherData.Mask, Mask);
    Data.Height = OtherData.Height + Mask;
    Data.SDFDistance = max(OtherData.SDFDistance, SDFDistance);
    Data.Color = mix(OtherData.Color, ColorIn, Mask);

    if (dist >= OtherData.SDFMedian) {
        Data.SDFMedian = dist;
        Data.PxRange = pxRange;
    } else {
        Data.SDFMedian = OtherData.SDFMedian;
        Data.PxRange = OtherData.PxRange;
    }

    Mask = Data.Mask;
    Height = Data.Height;
    SDFDistance = Data.SDFDistance;
    Color = Data.Color;
}
