// AutolibSplatterCoord

point randomCellPosition(int x, int y, float Jitter, int Seed) {
    vector off = cellnoise(vector(x, y, 0), Seed);
    off -= 0.5;
    off *= Jitter;
    off += 0.5;
    return point(x + off[0], y + off[1], 0);
}

float randomLength(int x, int y, float MinRadius, float MaxRadius) {
    float randomValue = noise("cell", vector(x + 123.456, y + 789.012, 0));
    return MinRadius + randomValue * (MaxRadius - MinRadius);
}

vector randomTilt(int x, int y, float ConeTilt, int Seed) {
    float tx = noise("cell", vector(x + 111.111, y + 222.222, Seed)) - 0.5;
    float ty = noise("cell", vector(x + 333.333, y + 444.444, Seed)) - 0.5;
    return vector(tx, ty, 0) * ConeTilt;
}

float smoothMinWeighted(float a, float b, float k, float attrA, float attrB, output float blendedAttr) {
    float ea = exp(-k * a);
    float eb = exp(-k * b);
    float wsum = ea + eb;
    blendedAttr = (attrA * ea + attrB * eb) / wsum;
    return -log(wsum) / k;
}

float ellipseSDF(vector p, vector axisA, float majorRadius, float minorRadius) {
    vector axisB = vector(-axisA[1], axisA[0], 0);
    float projA = dot(p, axisA);
    float projB = dot(p, axisB);
    float k = length(vector(projA / majorRadius, projB / minorRadius, 0));
    return (k - 1.0) * min(majorRadius, minorRadius);
}

shader AutolibSplatterCoord [[
    string category = "autolib"
]] (
    point UV = point(u,v,0),
    float SplatterScale = 20 [[ string page = "Pattern", int interactive = 1 ]],
    int Seed = 433 [[ string page = "Pattern", int interactive = 0 ]],
    float Jitter = 2.0 [[ string page = "Pattern" ]],
    float MinRadius = 0.005 [[ string page = "Pattern" ]],
    float MaxRadius = 0.3 [[ string page = "Pattern" ]],
    float PerimeterSmoothness = 0.15 [[ string page = "Pattern", float min = 0.0, float max = 1.0 ]],
    float UnionSmoothness = 8.0 [[ string page = "Pattern" ]],

    int MarchBound = 1 [[ string help = "Sizes a grid for combining drops" ]],

    float ConeHeight = 0.5 [[ string page = "Cone", float min = 0.001 ]],
    float ConeTilt = 0.3 [[ string page = "Cone", float min = 0.0, float max = 2.0 ]],
    
    output float Mask = 0,
    output point LocalUV = 0,
    output vector SplatterDirection = 0,
) {
    point scaledPos = SplatterScale * UV;

    int cellX = (int)floor(scaledPos[0]);
    int cellY = (int)floor(scaledPos[1]);

    float bestDistance = 1e6;
    float bestTipDist = 1;
    int bestID;

    vector bestAxisA = vector(1, 0, 0);
    float bestMajorRadius = 1.0;
    float bestMinorRadius = 1.0;
    vector bestToSample = vector(0, 0, 0);

    int bound = 2*MarchBound + 1;

    for (int x = -bound; x <= bound; x++) {
        for (int y = -bound; y <= bound; y++) {
            // Get the cell indicies of the current square
            int cx = cellX + x;
            int cy = cellY + y;

            // The goal of this is to build some sort of inution 
            // of how paint will actually land as if it were 
            // coming out of a paint gun of a firing out of a paint gun
            
            // Generate some cone with a center, a radius, and a tilt.
            point cellCenter = randomCellPosition(cx, cy, Jitter, Seed);
            float radius = randomLength(cx, cy, MinRadius, MaxRadius);
            vector tilt = randomTilt(cx, cy, ConeTilt, Seed);

            // The projected cone becomes an elipse with a major
            // and minor axis. 
            float tiltDist = length(tilt);
            float tiltAngle = atan2(tiltDist, ConeHeight);
            float majorRadius = radius / max(cos(tiltAngle), 0.01); // in the direction of the tilt 
            float minorRadius = radius; // perpendicular to the tilt

            vector axisA = (tiltDist > 1e-6) ? normalize(tilt) : vector(1, 0, 0);
            vector toSample = scaledPos - cellCenter;

            float d = ellipseSDF(toSample, axisA, majorRadius, minorRadius);

            vector delta = scaledPos - (cellCenter + tilt);

            vector deltaSquared = pow(delta, 2);
            float ConeHeightSquared = pow(ConeHeight, 2);
            float tipDist = sqrt(deltaSquared.x + deltaSquared.y + ConeHeightSquared);

            if (x == -bound && y == -bound) {
                bestDistance  = d;
                bestTipDist   = tipDist;
                bestAxisA     = axisA;
                bestMajorRadius = majorRadius;
                bestMinorRadius = minorRadius;
                bestToSample  = toSample;
            } else {
                float prevBest = bestDistance;
                bestDistance = smoothMinWeighted(bestDistance, d, UnionSmoothness, bestTipDist, tipDist, bestTipDist);

                // If this cell won the hard comparison, update the ellipse basis
                if (d < prevBest) {
                    bestAxisA       = axisA;
                    bestMajorRadius = majorRadius;
                    bestMinorRadius = minorRadius;
                    bestToSample    = toSample;
                }
            }
        }
    }

    vector bestAxisB = vector(-bestAxisA[1], bestAxisA[0], 0);
    float projA = dot(bestToSample, bestAxisA);
    float projB = dot(bestToSample, bestAxisB);

    LocalUV.x = (projA / bestMajorRadius) * 0.5 + 0.5;
    LocalUV.y = (projB / bestMinorRadius) * 0.5 + 0.5;

    float dynamicSmoothness = PerimeterSmoothness * bestTipDist;
    Mask = 1.0 - smoothstep(0.0, dynamicSmoothness, bestDistance);

    vector sdfGradient = (projA / (bestMajorRadius * bestMajorRadius)) * bestAxisA + (projB / (bestMinorRadius * bestMinorRadius)) * bestAxisB;
    float gradLen = length(sdfGradient);
    SplatterDirection = (gradLen > 1e-6) ? sdfGradient / gradLen : vector(0, 0, 0);
}