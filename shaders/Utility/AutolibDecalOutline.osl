#include "Decal.h"
shader AutolibDecalOutline [[
    string label = "Decal Outline",
    string help = "Adds an outline around the decals chained into it, in screen pixels, inside and / or outside the edge.",
    string rfh_classification = "RenderMan/Autolib/Decal",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/decal"
]] (
    DecalData OtherData = {} [[
        string label = "Other Data",
        string help = "Connect the Data output of the decal below this one; decals chain bottom to top and the last node holds the combined result."
    ]],
    color ColorIn = 1 [[
        string label = "Outline Color"
    ]],
    float OutlineWidthInner = 2 [[
        string label = "Inner Width",
        string help = "Outline thickness inside the decal edge, in screen pixels.",
        float min = 0.0, float slidermax = 10
    ]],
    float OutlineWidthOuter = 0 [[
        string label = "Outer Width",
        string help = "Outline thickness outside the decal edge, in screen pixels.",
        float min = 0.0, float slidermax = 10
    ]],
    int DisableChaining = 0 [[
        string label = "Disable Chaining",
        string help = "Output only the outline, without the decals below.",
        string widget = "checkBox",
        int connectable = 0
    ]],

    output DecalData Data = {} [[ string label = "Data" ]],
    output float Height = 0 [[ string label = "Height" ]],
    output float Mask = 0 [[ string label = "Mask", string help = "Outline only." ]],
    output float SDFDistance = 0 [[ string label = "Edge Distance" ]],
    output color Color = 0 [[ string label = "Color" ]]
) {
    if (DisableChaining && isconnected(OtherData)) {
        Data = OtherData;
        Mask = OtherData.Mask;
        Height = OtherData.Height;
        SDFDistance = OtherData.SDFDistance;
        return;
    }
    
    Data = OtherData;
    float pxRange = OtherData.PxRange;
    float dist = OtherData.SDFMedian;

    if (pxRange < 1e-6) {
        SDFDistance = OtherData.SDFDistance;
        Height = OtherData.Height;
        return;
    }

    float outerPxDist = pxRange * (dist - 0.5) + OutlineWidthOuter;
    float innerPxDist = pxRange * (dist - 0.5 - OutlineWidthInner);
    float outerMask = clamp(outerPxDist + 0.5, 0.0, 1.0);
    float innerMask = clamp(innerPxDist + 0.5, 0.0, 1.0);

    Mask = max(0.0, outerMask - innerMask);

    Data.Mask = Mask;
    Data.Height = OtherData.Height + Mask;
    Data.SDFDistance = OtherData.SDFDistance;
    Data.Color = mix(OtherData.Color, ColorIn, Mask);

    Color = Data.Color;
    Height = Data.Height;
    SDFDistance = Data.SDFDistance;
}