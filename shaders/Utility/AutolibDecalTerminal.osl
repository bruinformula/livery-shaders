#include "Decal.h"

shader AutolibDecalTerminal [[
    string label = "Decal Terminal",
    string help = "Ends or edits a decal chain: overrides (or max-combines) its height, mask, edge distance and "
                  "color with the connected values.",
    string rfh_classification = "RenderMan/Autolib/Decal",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/decal"
]] (
    DecalData OtherData = {} [[ string label = "Other Data", string help = "Connect the Data output of the decal below this one; decals chain bottom to top and the last node holds the combined result." ]],
    float HeightIn = 0 [[ string label = "Height" ]],
    float MaskIn = 0 [[ string label = "Mask" ]],
    float SDFDistanceIn = 0 [[ string label = "Edge Distance" ]],
    color ColorIn = 1 [[ string label = "Color" ]],
    int Override = 1 [[
        string label = "Override",
        string help = "Replace the chain's values with the connected inputs; off combines them (max of masks, color over).",
        string widget = "checkBox",
        int connectable = 0
    ]],
    output DecalData Data = {} [[ string label = "Data" ]],
    output float Height = 0 [[ string label = "Height" ]],
    output float Mask = 0 [[ string label = "Mask" ]],
    output float SDFDistance = 0 [[ string label = "Edge Distance" ]],
    output color Color = 0 [[ string label = "Color" ]]
) {
    if (!isconnected(OtherData)) return;

    Data = OtherData;
    if (Override) {
        if (isconnected(MaskIn)) Data.Height = HeightIn;
        if (isconnected(MaskIn)) Data.Mask = MaskIn;
        if (isconnected(MaskIn)) Data.SDFDistance = SDFDistanceIn;
        if (isconnected(ColorIn)) Data.Color = ColorIn;
    } else {
        Data.Height = max(OtherData.Height, HeightIn);
        Data.Mask = max(OtherData.Mask, MaskIn);
        Data.SDFDistance = max(OtherData.SDFDistance, SDFDistanceIn);
        Data.Color = mix(OtherData.Color, ColorIn, MaskIn); // topmost decal wins
    }

    Data.Color = mix(OtherData.Color, ColorIn, MaskIn);

    Mask = Data.Mask;
    Height = Data.Height;
    SDFDistance = Data.SDFDistance;
    Color = Data.Color;
}