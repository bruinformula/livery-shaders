        layer2, // color baseColor,
        0.3, // float baseRoughness,
        1.4, // float baseIOR,
        
        // metallic/flake layer params
        1.0, // float flakeWeight,
        layer2, // color flakeReflectivity,
        layer2, // color flakeEdgeTint,
        0.1 // float flakeRoughness
