
// retrieves name, hit point and normal of a probe ray
int probeForOutline( 
    vector rayDir, 
    point rayOrigin, 
    output string HitGeomName,
    output point HitPoint, 
    output normal HitNormal 
) {
    int hit = trace(rayOrigin, rayDir);   

    if (hit) {
        getmessage("trace","geom:name", HitGeomName);

        getmessage("trace", "P", HitPoint);
        HitPoint = transform("world", HitPoint);

        getmessage("trace", "N", HitNormal);
        HitNormal = normalize(transform("world", HitNormal));
    }

    return hit;

}

shader AutolibToonOutline [[
    string label = "Toon Outline",
    string help = "Silhouette and crease outlines found by tracing a probe ray just off the surface and comparing "
                  "what it hits by distance and normal. Alpha is 1 on outlines.",
    string rfh_classification = "RenderMan/Autolib/Stylized",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/stylized"
]] (
    float width = 0.01 [[
        string label = "Width",
        string help = "Offset of the probe ray from the surface, which sets the outline width (scene units).",
        float min = 0, float slidermax = 0.1
    ]],
    float DistanceThreshold = 1.1 [[
        string label = "Distance Threshold",
        string help = "Depth difference between the probe hit and the shading point that counts as an outline.",
        float min = 0, float slidermax = 4
    ]],
    float NormalThreshold = 0.1 [[
        string label = "Normal Threshold",
        string help = "Normal difference that counts as a crease outline.",
        float min = 0, float max = 1, int slider = 1
    ]],
    float NoiseScale = 0 [[ string label = "Noise Scale", string help = "Frequency of the wobble along the outline.", float min = 0, float slidermax = 100, string page = "Noise" ]],
    float NoiseAmount = 0 [[ string label = "Noise Amount", string help = "Amount of wobble.", float min = 0, float slidermax = 1, string page = "Noise" ]],
    output float Alpha = 0 [[ string label = "Alpha" ]]
) {

    for (int i = -1; i <= 1; i++) {
        float noisedWidth = width * noise("perlin", P * NoiseScale) * NoiseAmount;

        float eps = 1e-4;

        point rayOrigin1  = P + N * eps;
        point rayOrigin2 = P + N * (eps + width);

        vector rayDir = normalize(-I);

        string name1 = "nogeo";
        string name2;

        point hitPoint1;
        point hitPoint2;

        normal hitNormal1;
        normal hitNormal2;

        int hit1 = probeForOutline(rayDir, rayOrigin1, name1, hitPoint1, hitNormal1);
        if(!hit1) {
            Alpha = 1;
            break;
        }

        int hit2 = probeForOutline(rayDir, rayOrigin2, name2, hitPoint2, hitNormal2);
        if(!hit2) {
            Alpha = 1;
            break;
        }

        int meetsNameCriteria = (name1 != name2);
        int meetsDistanceCriteria = dot(hitPoint1, hitPoint2) < (1 - DistanceThreshold);
        int meetsNormalCriteria = dot(hitNormal1, hitNormal2) < (1.0 - NormalThreshold);

        //if the normals are different enough, or the distance is large enough, or the names are different enough, we have an outline
        if (meetsDistanceCriteria || meetsNormalCriteria || meetsNameCriteria) {
            Alpha = 1;
            break;
        }
    }
}