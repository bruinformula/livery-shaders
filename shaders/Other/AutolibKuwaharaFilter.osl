
// The mesh UVs. Arnold's u,v on a mesh are its UVs; RenderMan's are per-face parametric coordinates,
// so read the st primvar when the renderer exposes it (the default of the UV input).
point meshUV() {
    float st[2];
    if (getattribute("primvar", "st", st))
        return point(st[0], st[1], 0);
    return point(u, v, 0);
}

shader AutolibKuwaharaFilter [[
    string label = "Kuwahara Filter",
    string help = "Reads an image through a Kuwahara filter (the smoothest of four neighbourhoods), giving a "
                  "painterly, edge-preserving look.",
    string rfh_classification = "RenderMan/Autolib/Stylized",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/stylized"
]] (
    vector UV = meshUV() [[
        string label = "UV",
        string help = "Texture coordinates. Defaults to the mesh UVs (st); connect a Manifold to transform or replace them."
    ]],
    string FileName = "" [[
        string label = "Image",
        string widget = "assetIdInput",
        string options = "texture",
        int connectable = 0,
        string page = "Image",
        int page_open = 1
    ]],
    string FileColorSpace = "" [[
        string label = "Color Space",
        string help = "OCIO color space of the image; the result is converted to ACEScg.",
        int connectable = 0,
        string page = "Image"
    ]],
    float Radius = 0.003 [[
        string label = "Radius",
        string help = "Filter radius in UV units (larger is more painterly and slower).",
        float min = 0, float slidermax = 0.02
    ]],
    output color Color = color(0.0) [[ string label = "Color" ]]
)

{
    int radSteps = int(Radius * 1000); // Convert radius to integer steps
    if (radSteps < 1)
        radSteps = 1;

    color mean[4] = { color(0), color(0), color(0), color(0) };
    float variance[4] = { 0.0, 0.0, 0.0, 0.0 };

    // Offset directions for the four neighborhoods
    int offset_x[4] = { -1, 1, -1, 1 };
    int offset_y[4] = { -1, -1, 1, 1 };

    // Get the base UV coordinates
    //vector uv = transform("raster", P);
    vector uv = UV;

    // Loop through the four neighborhoods
    for (int n = 0; n < 4; n++) {
        color sum = color(0.0);
        float sumSq = 0.0;
        int count = 0;

        // Sample the neighborhood
        for (int x = 0; x <= radSteps; x++) {
            for (int y = 0; y <= radSteps; y++) {
                // Compute texture coordinates with offsets
                float uOffset = offset_x[n] * x * Radius;
                float vOffset = offset_y[n] * y * Radius;
                float uNew = uv[0] + uOffset;
                float vNew = uv[1] + vOffset;

                // Wrap UV coordinates to stay within 0 to 1
                uNew = uNew - floor(uNew);
                vNew = vNew - floor(vNew);

                // Sample texture at offset
                color sample = texture(FileName, uNew, vNew);
                sum += sample;
                sumSq += dot(sample, sample);
                count++;
            }
        }

        // Calculate mean and variance for the neighborhood
        mean[n] = sum / count;
        variance[n] = (sumSq / count) - dot(mean[n], mean[n]);
    }

    // Find the neighborhood with the minimum variance
    int minIndex = 0;
    float minVariance = variance[0];
    for (int i = 1; i < 4; i++) {
        if (variance[i] < minVariance) {
            minVariance = variance[i];
            minIndex = i;
        }
    }

    // Set the output color to the mean of the selected neighborhood
    color output_mean = mean[minIndex];

    color textureSampleRAW = transformc("ACEScg", "scene-linear Rec.709-sRGB", output_mean);
    Color = transformc(FileColorSpace, "ACEScg", textureSampleRAW);

}