#ifndef SOLO_SHADER   
    #define ENTRY_SPLATTER_LAYER void 
#endif

#ifndef ENTRY_SPLATTER_LAYER
    #define DEFAULT_SPLATTER_LAYER(x) = x
    #define ENTRY_SPLATTER_LAYER shader
#else
    #define DEFAULT_SPLATTER_LAYER(x)
#endif

#include "Material/MetallicPaint.h"
#include "Pattern/Splatter.h"

struct SplatterLayerParams {
    float scale;
    int seed;
    float jitter;
    float scaleRadius;
    float minRadius;
    float maxRadius;
    float unionSmoothness;

    float spikeAmount;
    float spikePeak;
    float spikeFrequency;
    float spikePerimeterSmoothness;
    float spikeTrimWidth;

    float basinHeight;
    float basinCenter;
    float basinSmoothness;

    //paint
    float splatterBumpStrength;
    color primerColor;
    
    //base layer params
    float baseWeight;
    color baseColor;
    float baseRoughness;
    float baseIOR;
    
    //metallic/flake layer params
    float flakeWeight;
    color flakeReflectivity;
    color flakeEdgeTint;
    float flakeRoughness;
};

SplatterLayerParams jitterSplatterParams(
    SplatterLayerParams baseParams,
    int sublayerIndex,
    float jitterAmount
) {
    SplatterLayerParams jittered = baseParams;
    
    float rand1 = noise("hash", vector(baseParams.seed + sublayerIndex, 0, 0));
    float rand2 = noise("hash", vector(baseParams.seed + sublayerIndex, 1, 0));
    float rand3 = noise("hash", vector(baseParams.seed + sublayerIndex, 2, 0));
    float rand4 = noise("hash", vector(baseParams.seed + sublayerIndex, 3, 0));
    float rand5 = noise("hash", vector(baseParams.seed + sublayerIndex, 4, 0));
    
    // geometric properties
    jittered.seed = baseParams.seed + sublayerIndex;
    jittered.scaleRadius = baseParams.scaleRadius * (1.0 + (rand1 - 0.5) * jitterAmount * 0.2);
    jittered.minRadius = baseParams.minRadius * (1.0 + (rand2 - 0.5) * jitterAmount * 0.3);
    jittered.maxRadius = baseParams.maxRadius * (1.0 + (rand3 - 0.5) * jitterAmount * 0.3);
    
    // spike properties
    jittered.spikeAmount = clamp(baseParams.spikeAmount + (rand4 - 0.5) * jitterAmount * 0.2, 0.0, 1.0);
    jittered.spikePeak = baseParams.spikePeak * (1.0 + (rand5 - 0.5) * jitterAmount * 0.4);
    
    // basin properties
    float rand6 = noise("hash", vector(baseParams.seed + sublayerIndex, 5, 0));
    jittered.basinHeight = clamp(baseParams.basinHeight + (rand6 - 0.5) * jitterAmount * 0.15, 0.0, 1.0);
    
    // paint properties slightly
    float rand7 = noise("hash", vector(baseParams.seed + sublayerIndex, 6, 0));
    float rand8 = noise("hash", vector(baseParams.seed + sublayerIndex, 7, 0));
    float rand9 = noise("hash", vector(baseParams.seed + sublayerIndex, 8, 0));
    
    jittered.baseRoughness = clamp(baseParams.baseRoughness + (rand7 - 0.5) * jitterAmount * 0.1, 0.0, 1.0);
    jittered.flakeRoughness = clamp(baseParams.flakeRoughness + (rand8 - 0.5) * jitterAmount * 0.1, 0.0, 1.0);
    
    // Subtle color variation
    color colorJitter = color(
        (rand7 - 0.5) * jitterAmount * 0.05,
        (rand8 - 0.5) * jitterAmount * 0.05,
        (rand9 - 0.5) * jitterAmount * 0.05
    );
    jittered.baseColor = clamp(baseParams.baseColor + colorJitter, color(0), color(1));
    jittered.flakeReflectivity = clamp(baseParams.flakeReflectivity + colorJitter, color(0), color(1));
    jittered.flakeEdgeTint = clamp(baseParams.flakeEdgeTint + colorJitter, color(0), color(1));
    
    return jittered;
}

void generateSplatter(
    vector UV,
    SplatterLayerParams layerParams,
    output float layerHeight,
    output float layerMask
) {
    Splatter(
        UV,
        layerParams.seed,
        layerParams.jitter,
        layerParams.scaleRadius,
        layerParams.minRadius,
        layerParams.maxRadius,
        layerParams.unionSmoothness,

        layerParams.spikeAmount,
        layerParams.spikePeak,
        layerParams.spikeFrequency,
        layerParams.spikePerimeterSmoothness,
        layerParams.spikeTrimWidth,

        layerParams.basinHeight,
        layerParams.basinCenter,
        layerParams.basinSmoothness,

        layerHeight,
        layerMask
    );
}

ENTRY_SPLATTER_LAYER SplatterLayer [[
    string nodegroup = "autolib",
]] (
    vector UV  DEFAULT_SPLATTER_LAYER(vector(u, v, 0)),
    int useUV  DEFAULT_SPLATTER_LAYER(0) [[ string doc = "Defaults to P otherwise", string widget = "checkBox" ]],
    
    float scale DEFAULT_SPLATTER_LAYER(36) [[ string uifolder = "Pattern" ]],
    int seed  DEFAULT_SPLATTER_LAYER(433) [[ string uifolder = "Pattern" ]],
    float jitter  DEFAULT_SPLATTER_LAYER(2.0) [[ string uifolder = "Pattern" ]],
    float scaleRadius  DEFAULT_SPLATTER_LAYER(0.8) [[ string uifolder = "Pattern" ]],
    float minRadius  DEFAULT_SPLATTER_LAYER(0.005) [[ string uifolder = "Pattern" ]],
    float maxRadius  DEFAULT_SPLATTER_LAYER(0.3) [[ string uifolder = "Pattern" ]],
    float unionSmoothness  DEFAULT_SPLATTER_LAYER(8.0) [[ string uifolder = "Pattern", string doc = "Controls the smoothness between overlapping drops" ]],

    //splatter spikes control
    float spikeAmount  DEFAULT_SPLATTER_LAYER(0.9) [[ string uifolder = "Spikes", string doc = "Controls the intensity of the spikes on the splatter", float uimin = 0.0, float uimax = 1.0 ]],
    float spikePeak  DEFAULT_SPLATTER_LAYER(8) [[ string uifolder = "Spikes", string doc = "Controls the height of the peak spikes", float uimin = 1.0 ]],
    float spikeFrequency  DEFAULT_SPLATTER_LAYER(36)  [[ string uifolder = "Spikes", string doc = "Higher values increase the number of spikes", float uimin = 0.0 ]],
    float spikePerimeterSmoothness  DEFAULT_SPLATTER_LAYER(0.01) [[ string uifolder = "Spikes", float uimin = 0.0, float uimax = 1.0 ]],
    float spikeTrimWidth DEFAULT_SPLATTER_LAYER(0.02) [[ string uifolder = "Spikes", string doc = "Width of the ramp zone at angle boundaries to smooth the seam", float uimin = 0.0, float uimax = 0.5 ]],

    float basinHeight DEFAULT_SPLATTER_LAYER(0.95) [[ string uifolder = "Basin", string doc = "Base height of the splatter basin", float uimin = 0.0, float uimax = 1.0 ]],
    float basinCenter DEFAULT_SPLATTER_LAYER(0.3) [[ string uifolder = "Basin", string doc = "The the inflection point where the basin rises to a parameter", float uimin = 0.0, float uimax = 1.0 ]],
    float basinSmoothness DEFAULT_SPLATTER_LAYER(0.075) [[ string uifolder = "Basin", string doc = "The the inflection point where the basin rises to a parameter", float uimin = 0.0, float uimax = 1.0 ]],

    float splatterBumpStrength DEFAULT_SPLATTER_LAYER(0.075),
    int numSubLayers DEFAULT_SPLATTER_LAYER(1),

    color primerColor DEFAULT_SPLATTER_LAYER(color(1.0, 0.1, 0.1)),
	float baseWeight  DEFAULT_SPLATTER_LAYER(1.0) [[ string uifolder = "Base", string doc = "Weight of the paint that is suspended in the same layer as the flakes", float uimin = 0.0, float uimax = 1.0 ]],
	color baseColor  DEFAULT_SPLATTER_LAYER(color(1.0, 0.1, 0.1)) [[ string uifolder = "Base", string doc = "Flake Layer Color" ]],
    float baseRoughness  DEFAULT_SPLATTER_LAYER(0.3) [[ string uifolder = "Base", float uimin = 0.0, float uimax = 1.0 ]],
    float baseIOR  DEFAULT_SPLATTER_LAYER(1.4) [[ string uifolder = "Base", float uimin = 1.0, float uimax = 3.0 ]],

    float flakeScale  DEFAULT_SPLATTER_LAYER(0.001) [[ string uifolder = "Flake Pattern", float uimin = 0.0, float uimax = 200.0 ]],
    float flakeDensity  DEFAULT_SPLATTER_LAYER(0.2) [[ string uifolder = "Flake Pattern", float uimin = 0.0, float uimax = 1.0 ]],
    float flakeRandomize  DEFAULT_SPLATTER_LAYER(0.2) [[ string uifolder = "Flake Pattern", string doc = "Dictates the randomness of the flake orientations", float uimin = 0.0, float uimax = 1.0 ]],
    float flakeWeight  DEFAULT_SPLATTER_LAYER(1.0) [[ string uifolder = "Flakes", string doc = "Visibility of the metallic flakes", float uimin = 0.0, float uimax = 1.0 ]],
    color flakeReflectivity  DEFAULT_SPLATTER_LAYER(color(1.0, 0.1, 0.1)) [[ string uifolder = "Flakes" ]],
    color flakeEdgeTint  DEFAULT_SPLATTER_LAYER(color(1.0, 0.1, 0.1)) [[ string uifolder = "Flakes" ]],
    float flakeRoughness  DEFAULT_SPLATTER_LAYER(0.1) [[ string uifolder = "Flakes", float uimin = 0.0, float uimax = 1.0 ]],

    output float splatterMask DEFAULT_SPLATTER_LAYER(0),
    output float splatterHeight DEFAULT_SPLATTER_LAYER(0),
    output closure color splatterLayer DEFAULT_SPLATTER_LAYER(0)
) {

    point pos = transform("object", useUV ? UV : P) / flakeScale;

    int firstSubLayer = 1;

    SplatterLayerParams primaryParams = SplatterLayerParams(
        scale, seed, jitter, scaleRadius, minRadius, maxRadius, unionSmoothness,
        spikeAmount, spikePeak, spikeFrequency, spikePerimeterSmoothness, spikeTrimWidth,
        basinHeight, basinCenter, basinSmoothness,
        splatterBumpStrength, primerColor,
        baseWeight, baseColor, baseRoughness, baseIOR,
        flakeWeight, flakeReflectivity, flakeEdgeTint, flakeRoughness
    );

    for (int subIdx = 0; subIdx < numSubLayers; subIdx++) {

        SplatterLayerParams subParams = jitterSplatterParams(primaryParams, subIdx, 1.0);

        float layerHeight;
        float layerMask;

        generateSplatter(
            UV * scale,
            subParams,
            layerHeight,
            layerMask
        );

        splatterHeight += layerHeight;
        splatterMask += layerMask;

        point Pbump = P + normalize(Ng) * splatterHeight * subParams.splatterBumpStrength;
        normal splatterNormal = normalize(calculatenormal(Pbump));
        N = splatterNormal;

        float rehash;
        float outAlpha;
        normal outNormal;
        int seed = subParams.seed;

        generateFlakes(pos, seed, flakeDensity, rehash, outAlpha, outNormal);
        normal finalNormal = mix(splatterNormal, outNormal, flakeRandomize);

        closure color addFlakes;
        float finalMask = splatterHeight + 1e-6;
        
        // Track primer color from topmost layer that has splatter
        if (finalMask > 1e-6) {
            //finalPrimerColor = subParams.primerColor;
        }

        if (outAlpha > 0.5) {
            color flakeIOR, flakeExtinction;
            artistic_ior(subParams.flakeReflectivity, subParams.flakeEdgeTint, flakeIOR, flakeExtinction);
            
            addFlakes = finalMask * subParams.flakeWeight * conductor_bsdf(
                finalNormal, 0,
                subParams.flakeRoughness, // roughness_x 
                subParams.flakeRoughness, // roughness_y 
                flakeIOR, // ior 
                flakeExtinction, // extinction 
                "ggx"
            );
        } else {
            addFlakes = finalMask * subParams.baseWeight * dielectric_bsdf(
                splatterNormal, 0,
                subParams.baseColor, // reflection_tint,  
                0, // transmission_tint, 
                subParams.baseRoughness, // roughness_x, 
                subParams.baseRoughness, // roughness_y,  
                subParams.baseIOR, // ior 
                "ggx"
            );
        }

        if (firstSubLayer) {
            splatterLayer = addFlakes;
            firstSubLayer = 0;
        } else {
            splatterLayer = layer(addFlakes, splatterLayer);
        }
    }
}