#ifndef SOLO_SHADER   
    #define ENTRY_JITTER_SPLATTER_PARAMS void 
#endif

#ifndef ENTRY_JITTER_SPLATTER_PARAMS
    #define ENTRY_JITTER_SPLATTER_PARAMS surface
    #define DEFAULT_JITTER_SPLATTER_PARAMS(x) = x
#else
    #define DEFAULT_JITTER_SPLATTER_PARAMS(x)
#endif

ENTRY_JITTER_SPLATTER_PARAMS AutolibJitterSplatterParams [[
    string nodegroup = "autolib",
]] (
    int sublayerIndex  DEFAULT_JITTER_SPLATTER_PARAMS(0),
    float jitterAmount DEFAULT_JITTER_SPLATTER_PARAMS(1.0),

    // geometry
    int seed  DEFAULT_JITTER_SPLATTER_PARAMS(433) [[ string uifolder = "Pattern" ]],
    float scaleRadius  DEFAULT_JITTER_SPLATTER_PARAMS(0.8) [[ string uifolder = "Pattern" ]],
    float minRadius  DEFAULT_JITTER_SPLATTER_PARAMS(0.005) [[ string uifolder = "Pattern" ]],
    float maxRadius  DEFAULT_JITTER_SPLATTER_PARAMS(0.3) [[ string uifolder = "Pattern" ]],

    // spikes
    float spikeAmount  DEFAULT_JITTER_SPLATTER_PARAMS(0.9) [[ string uifolder = "Spikes", float uimin = 0.0, float uimax = 1.0 ]],
    float spikePeak  DEFAULT_JITTER_SPLATTER_PARAMS(8.0) [[ string uifolder = "Spikes", float uimin = 1.0 ]],

    // basin
    float basinHeight  DEFAULT_JITTER_SPLATTER_PARAMS(0.95) [[ string uifolder = "Basin", float uimin = 0.0, float uimax = 1.0 ]],

    // base paint
    float baseRoughness  DEFAULT_JITTER_SPLATTER_PARAMS(0.3) [[ string uifolder = "Base", float uimin = 0.0, float uimax = 1.0 ]],
    color baseColor  DEFAULT_JITTER_SPLATTER_PARAMS(color(1.0, 0.1, 0.1)) [[ string uifolder = "Base" ]],

    // flakes
    float flakeRoughness  DEFAULT_JITTER_SPLATTER_PARAMS(0.1) [[ string uifolder = "Flakes", float uimin = 0.0, float uimax = 1.0 ]],
    color flakeReflectivity DEFAULT_JITTER_SPLATTER_PARAMS(color(0.95, 0.95, 0.95)) [[ string uifolder = "Flakes" ]],
    color flakeEdgeTint  DEFAULT_JITTER_SPLATTER_PARAMS(color(1.0, 1.0, 1.0)) [[ string uifolder = "Flakes" ]],

    // jittered outputs
    output int outSeed DEFAULT_JITTER_SPLATTER_PARAMS(0),
    output float outScaleRadius DEFAULT_JITTER_SPLATTER_PARAMS(0.0),
    output float outMinRadius DEFAULT_JITTER_SPLATTER_PARAMS(0.0),
    output float outMaxRadius DEFAULT_JITTER_SPLATTER_PARAMS(0.0),
    output float outSpikeAmount DEFAULT_JITTER_SPLATTER_PARAMS(0.0),
    output float outSpikePeak DEFAULT_JITTER_SPLATTER_PARAMS(0.0),
    output float outBasinHeight DEFAULT_JITTER_SPLATTER_PARAMS(0.0),
    output float outBaseRoughness DEFAULT_JITTER_SPLATTER_PARAMS(0.0),
    output color outBaseColor DEFAULT_JITTER_SPLATTER_PARAMS(0),
    output float outFlakeRoughness DEFAULT_JITTER_SPLATTER_PARAMS(0.0),
    output color outFlakeReflectivity DEFAULT_JITTER_SPLATTER_PARAMS(0),
    output color outFlakeEdgeTint DEFAULT_JITTER_SPLATTER_PARAMS(0)
) {
    float rand1 = noise("hash", vector(seed + sublayerIndex, 0, 0));
    float rand2 = noise("hash", vector(seed + sublayerIndex, 1, 0));
    float rand3 = noise("hash", vector(seed + sublayerIndex, 2, 0));
    float rand4 = noise("hash", vector(seed + sublayerIndex, 3, 0));
    float rand5 = noise("hash", vector(seed + sublayerIndex, 4, 0));
    float rand6 = noise("hash", vector(seed + sublayerIndex, 5, 0));
    float rand7 = noise("hash", vector(seed + sublayerIndex, 6, 0));
    float rand8 = noise("hash", vector(seed + sublayerIndex, 7, 0));
    float rand9 = noise("hash", vector(seed + sublayerIndex, 8, 0));

    // geometry
    outSeed       = seed + sublayerIndex;
    outScaleRadius = scaleRadius * (1.0 + (rand1 - 0.5) * jitterAmount * 0.2);
    outMinRadius   = minRadius   * (1.0 + (rand2 - 0.5) * jitterAmount * 0.3);
    outMaxRadius   = maxRadius   * (1.0 + (rand3 - 0.5) * jitterAmount * 0.3);

    // spikes
    outSpikeAmount = clamp(spikeAmount + (rand4 - 0.5) * jitterAmount * 0.2, 0.0, 1.0);
    outSpikePeak   = spikePeak * (1.0 + (rand5 - 0.5) * jitterAmount * 0.4);

    // basin
    outBasinHeight = clamp(basinHeight + (rand6 - 0.5) * jitterAmount * 0.15, 0.0, 1.0);

    // paint
    outBaseRoughness  = clamp(baseRoughness  + (rand7 - 0.5) * jitterAmount * 0.1, 0.0, 1.0);
    outFlakeRoughness = clamp(flakeRoughness + (rand8 - 0.5) * jitterAmount * 0.1, 0.0, 1.0);

    color colorJitter = color(
        (rand7 - 0.5) * jitterAmount * 0.05,
        (rand8 - 0.5) * jitterAmount * 0.05,
        (rand9 - 0.5) * jitterAmount * 0.05
    );
    outBaseColor         = clamp(baseColor         + colorJitter, color(0), color(1));
    outFlakeReflectivity = clamp(flakeReflectivity + colorJitter, color(0), color(1));
    outFlakeEdgeTint     = clamp(flakeEdgeTint     + colorJitter, color(0), color(1));
}