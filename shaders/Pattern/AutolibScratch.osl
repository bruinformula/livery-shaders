// AutolibScratch
shader AutolibScratch [[ 
    string category = "autolib" 
]] (
    vector UV = vector(u, v, 0) [[ int interpolated = 1 ]],
    float Scale = 1.0 [[ float min = 0, int interactive = 1 ]],
    float Density = 0.1 [[ float min = 0, int interactive = 1 ]],
    float Width = 0.001 [[ float min = 0, int interactive = 1 ]],
    float NormalStrength = 1.0 [[ float min = 0, int interactive = 1 ]],
    float RoughnessMin = 0.0 [[ float min = 0, float max = 1, int interactive = 1 ]],
    float RoughnessMax = 0.01 [[ float min = 0, float max = 1, int interactive = 1 ]],
    float RoughnessDefault = 0.1 [[ float min = 0, float max = 1, int interactive = 1 ]],
    float AnisotropicMin = 0.1 [[ float min = 0, float max = 1, int interactive = 1 ]],
    float AnisotropicMax = 0.2 [[ float min = 0, float max = 1, int interactive = 1 ]],
    float AnisotropicDefault = 0.0 [[ float min = 0, float max = 1, int interactive = 1 ]],
    float AnisotropicRotationOffset = 0.0 [[ float min = 0, float max = 1, int interactive = 1 ]],
    output normal Normal = N,
    output float Height = 0.0,
    output float Alpha = 0.0,
    output float Roughness = 0.0,
    output float Anisotropic = 0.0,
    output vector AnisotropicDirection = 0.0
) {
    float delta = 1.0 / (40 - 1);
    float maxRadius = sqrt(Density);
    int maxSearchCell = (int)ceil(maxRadius / delta);
    point index = point(round(UV.x / delta), round(UV.y / delta), 0.0);

    // Initialize outputs to defaults
    Roughness = RoughnessDefault;
    Anisotropic = AnisotropicDefault;

    point position;
    if (Scale > 0 && isconnected(UV)) {
        position = UV * Scale;
    } else {
        position = point(u, v, 0);
    }

    vector T = normalize(dPdu);
    vector B = normalize(dPdv - dot(dPdv, T) * T);

    int found = 0;
    for (int x = -maxSearchCell; x <= maxSearchCell && !found; ++x) {
        for (int y = -maxSearchCell; y <= maxSearchCell && !found; ++y) {
            point currentIndex = index + point(x, y, 0);
            point currentOrigin = (currentIndex + (hashnoise(currentIndex) - 0.5)) * delta;

            float directionValue = hashnoise(currentIndex + vector(123, 456, 0));
            float theta = directionValue * M_PI;
            vector bitangent = vector(-sin(theta), cos(theta), 0);

            vector diff = vector(position) - vector(currentOrigin);
            float dist = dot(diff, bitangent);
            float actualWidth = Width * hashnoise(currentIndex);

            if (abs(dist) < actualWidth * 0.5) {
                float t = dist / (actualWidth * 0.5);

                // Transform UV-space bitangent into world space using surface tangent frame,
                // then perturb N along it — fixes the hardcoded Z-axis normal bug
                vector worldBitangent = normalize(bitangent.x * T + bitangent.y * B);
                Normal = normalize(N - worldBitangent * t * NormalStrength);

                Alpha = 1.0;
                Height = 1.0 - (t * t);

                Roughness = RoughnessDefault + mix(
                    RoughnessMin,
                    RoughnessMax,
                    hashnoise(currentIndex + vector(123, 456, 1))
                );
                Anisotropic = AnisotropicDefault + mix(
                    AnisotropicMin,
                    AnisotropicMax,
                    hashnoise(currentIndex + vector(123, 456, 2))
                );
                AnisotropicDirection = vector(cos(theta + AnisotropicRotationOffset * M_2PI), sin(theta + AnisotropicRotationOffset * M_2PI), 0);
                found = 1;
            }
        }
    }
}