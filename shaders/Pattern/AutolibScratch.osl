// AutolibScratch

// The mesh UVs. Arnold's u,v on a mesh are its UVs; RenderMan's are per-face parametric coordinates,
// so read the st primvar when the renderer exposes it (the default of the UV input).
point meshUV() {
    float st[2];
    if (getattribute("primvar", "st", st))
        return point(st[0], st[1], 0);
    return point(u, v, 0);
}

shader AutolibScratch [[
    string label = "Scratch",
    string help = "Random straight scratches in UV space with a V-shaped profile: a tangent space normal "
                  "(Normal), height and coverage.",
    string rfh_classification = "RenderMan/Autolib/Pattern",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/pattern"
]] (
    vector UV = meshUV() [[
        string label = "UV",
        string help = "Texture coordinates. Defaults to the mesh UVs (st); connect a Manifold to transform or replace them."
    ]],
    float Density = 0.1 [[
        string label = "Density",
        string help = "Search radius for scratches; higher values give more, longer scratches (slower).",
        float min = 0, float slidermax = 1
    ]],
    float Width = 0.001 [[
        string label = "Width",
        string help = "Maximum scratch width in UV units (each scratch gets a random width up to this).",
        float min = 0, float slidermax = 0.01
    ]],
    float NormalStrength = 1.0 [[
        string label = "Normal Strength",
        string help = "Tilt of the tangent space normal across a scratch.",
        float min = 0, float slidermax = 2
    ]],
    output normal Normal = N [[ string label = "Normal", string help = "Tangent space normal (Z up), (0,0,1) off the scratches." ]],
    output float Height = 0.0 [[ string label = "Height" ]],
    output float Alpha = 0.0 [[ string label = "Alpha", string help = "1 on a scratch." ]]
) {

    float delta = 1.0/(40 - 1);
    float maxRadius = sqrt(Density);
    int maxSearchCell = (int)ceil(maxRadius/delta);
    point index = point(round(UV.x/delta), round(UV.y/delta), 0.0);

    int found = 0;
    for (int x = -maxSearchCell; x <= maxSearchCell && !found; ++x){
        for (int y = -maxSearchCell; y <= maxSearchCell && !found; ++y){
            point currentIndex = index + point(x, y, 0);
            point currentOrigin = (currentIndex + (hashnoise(currentIndex) - 0.5)) * delta;

            float directionValue = hashnoise(currentIndex + vector(123, 456, 0));
            
            float theta = directionValue * M_PI;

            vector bitangent = vector(-sin(theta), cos(theta), 0);
            
            vector diff = UV - currentOrigin;
            float dist = dot(diff, bitangent);
            float actualWidth = Width * hashnoise(currentIndex);

            if (abs(dist) < actualWidth * 0.5) {
                float t = dist / (actualWidth * 0.5);

                Normal = normalize(normal(0,0,1) - bitangent * t * NormalStrength);
                Alpha = 1.0;
                Height = 1.0 - (t * t); // smooth parabolic dip across scratch Width
                found = 1;
            }
        }
    }
}