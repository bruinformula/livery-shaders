struct WeaveData {
    float mask;
    vector position;
    vector textureCoordinates;
    float segmentFactor;
};

WeaveData createWeaves(
    vector coordinates
) {
    float scale = 4; // dimension of the grid weave

    WeaveData weaveData;
    weaveData.mask = 0.0;
    weaveData.position = vector(0.0, 0.0, 0.0);
    weaveData.textureCoordinates = vector(0.0, 0.0, 0.0);
    weaveData.segmentFactor = 0.0;

    vector coordinatesPrime = ((coordinates * scale) / 2) + 1;

    float x = coordinatesPrime.x / scale;
    float moduloX = mod(x, 1) * scale;
    float floorModuloX = floor(moduloX);
    float xy = floorModuloX + coordinatesPrime.y;

    //float mask
    float absModuloScaledXY = abs(mod(xy / scale, 1));
    weaveData.mask = step(0.5, absModuloScaledXY);

    float scaledXY = xy / (scale / 2);
    weaveData.segmentFactor = mod(scaledXY, 1);

    float scaledSegmentFactor = weaveData.segmentFactor * (scale / 2);
    weaveData.textureCoordinates.x = mod(coordinatesPrime.x, 1);
    weaveData.textureCoordinates.y = scaledSegmentFactor;

    weaveData.position.x = floor(coordinatesPrime.x);
    weaveData.position.y = floor(scaledXY);

    return weaveData;
}

float mirrorCurve(float input, float exponent) {
    float safeExponent = max(exponent, 1e-5);
    float inverseClamp = 1.0 - clamp(input, 0.0, 1.0);
    float factor = step(0.5, input);
    float stepped = mix(input, inverseClamp, factor);
    return pow(clamp(stepped, 1e-6, 0.999999), 1.0 / safeExponent);
}

vector mirrorCurve(vector input, float exponent) {
    float safeExponent = max(exponent, 1e-5);
    vector inverseClamp = 1.0 - clamp(input, 0.0, 1.0);
    vector factor = step(0.5, input);
    vector stepped = mix(input, inverseClamp, factor);
    return pow(clamp(stepped, vector(1e-6), vector(0.999999)), 1.0 / safeExponent);
}

struct WeaveParams {
    float zGamma;
    int verticalOnly;
};

void displacedWeaves (
    WeaveParams params,
    WeaveData weaveControlData,
    WeaveData weaveData,
    output float FiberNoise,
    output float FiberBump,
    output vector FiberRotation
) {
    vector mixedTextureCoordinates = mix(weaveControlData.textureCoordinates, weaveData.textureCoordinates, weaveData.mask);
    vector mixedPositionCoordinates = mix(weaveControlData.position, weaveData.position, weaveControlData.mask);

    // Noise
    vector biasedFactor = (mixedPositionCoordinates + mixedTextureCoordinates) * vector(500, 0.0001, 0);
    FiberNoise = noise("cell", biasedFactor);

    //Bump
    float weaveFactorBump = mix(weaveControlData.segmentFactor, weaveData.segmentFactor, weaveControlData.mask);
    float iBump = mirrorCurve(weaveFactorBump, params.zGamma);
    if (!params.verticalOnly) {
        float jBump = mirrorCurve(mixedTextureCoordinates.x, 6.0);
        FiberBump = min(iBump, jBump);
    } else {
        FiberBump = iBump;
    }

    //Normal
    float iVecFactor = (1.0 - weaveControlData.segmentFactor);
    float jVecFactor = weaveData.segmentFactor;

    vector iVec = vector(iVecFactor, 0, 0);
    vector jVec = vector(0, jVecFactor, 0);
    vector iWeaveFactorNormal = mix(iVec, jVec, weaveControlData.mask);

    float anotherFactor = pow(clamp(mixedTextureCoordinates.x, 1e-6, 1.0), 0.1);

    iVec = vector(anotherFactor, 0, 0);
    jVec = vector(0, anotherFactor, 0);
    vector jWeaveFactorNormal = mix(iVec, jVec, weaveControlData.mask);

    FiberRotation = min(iWeaveFactorNormal, jWeaveFactorNormal);
}

// Bump the smooth shading normal N by a height field in world units (the surface gradient,
// Mikkelsen 2010). Building the normal from cross(Dx(P'), Dy(P')) instead gives the flat normal of
// each triangle, facing whichever way the triangle is wound, so faces wound against the mesh
// normals bump backwards (dark or see-through triangles) and the rest shade faceted.
normal bumpShadingNormal(float height) {
    vector Nn = normalize(N);
    vector dPdx = Dx(P), dPdy = Dy(P);
    vector R1 = cross(dPdy, Nn), R2 = cross(Nn, dPdx);
    float det = dot(dPdx, R1);
    vector n = abs(det) * Nn - sign(det) * (Dx(height) * R1 + Dy(height) * R2);
    return dot(n, n) > 1e-24 ? normalize(n) : Nn;
}

// The mesh UVs. Arnold's u,v on a mesh are its UVs; RenderMan's are per-face parametric coordinates,
// so read the st primvar when the renderer exposes it (the default of the UV input).
point meshUV() {
    float st[2];
    if (getattribute("primvar", "st", st))
        return point(st[0], st[1], 0);
    return point(u, v, 0);
}

shader AutolibCarbonFiberWeaves [[
    string label = "Carbon Fiber Weaves",
    string help = "Procedural 2x2 twill carbon fiber: per-tow height, a bumped normal, and the anisotropic specular "
                  "roughness and fiber direction (Rotation, feed it to a tangent field) of each tow.",
    string rfh_classification = "RenderMan/Autolib/Pattern",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/pattern"
]] (
    point UV = meshUV() [[
        string label = "UV",
        string help = "Texture coordinates. Defaults to the mesh UVs (st); connect a Manifold to transform or replace them."
    ]],

    vector FiberScale = vector(64, 32, 0) [[
        string label = "Fiber Scale",
        string help = "Number of weave tows per UV unit along U and V.",
        float slidermin = 1, float slidermax = 512,
        string page = "Weave",
        int page_open = 1
    ]],
    float FiberZGamma = 0.5 [[
        string label = "Tow Profile",
        string help = "Gamma of the height across each tow: below 1 gives flat-topped tows, above 1 rounder ones.",
        float min = 0.1, float max = 4.0, int slider = 1,
        string page = "Weave"
    ]],
    float FiberStrandBoost = 1 [[
        string label = "Strand Boost",
        string help = "Exponent on the strand noise inside each tow: higher values make individual strands stand out.",
        float min = 0, float max = 3, int slider = 1,
        string page = "Weave"
    ]],

    float FiberBumpStrength = 0.01 [[
        string label = "Bump Strength",
        string help = "Height of the weave relief in scene units (metres): the bumped normal tilts by the slope of "
                      "this height. Real carbon weave is a fraction of a millimetre deep.",
        float min = 0, float max = 1, float slidermax = 0.05,
        string page = "Bump",
        int page_open = 1
    ]],
    int VerticalBumpOnly = 0 [[
        string label = "Vertical Bump Only",
        string help = "Only bump across the V direction tows (a simpler, ribbed look).",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Bump"
    ]],

    float FiberSpecularRoughnessAlong = 0.1 [[
        string label = "Roughness Along Fiber",
        string help = "Specular roughness along the fiber direction, scaled by the strand bumpiness.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Specular",
        int page_open = 1
    ]],
    float FiberSpecularRoughnessAcross = 0.95 [[
        string label = "Roughness Across Fiber",
        string help = "Specular roughness across the fibers; the difference to Along gives the Specular Anisotropy output.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Specular"
    ]],

    output float SpecularRoughness = 0 [[ string label = "Specular Roughness", string help = "The larger of the along / across roughnesses." ]],
    output float SpecularAnisotropy = 0 [[ string label = "Specular Anisotropy", string help = "1 - along / across: 0 isotropic, toward 1 fully anisotropic." ]],
    output float Noise = 0 [[ string label = "Noise", string help = "Per-strand noise, 0-1." ]],
    output float Height = 0 [[ string label = "Height", string help = "Weave height, 0-1." ]],
    output normal BumpedNormal = 0 [[ string label = "Bumped Normal", string help = "The shading normal bumped by the weave." ]],
    output vector Rotation = 0 [[ string label = "Rotation", string help = "Fiber direction in UV space, for a tangent field (anisotropy direction)." ]]
) {
    point fiberUV = UV * FiberScale;

    point weaveControlDataCoordinates = fiberUV;
    point weaveDataCoordinates = vector(fiberUV.y, fiberUV.x, 0);
    
    point weaveControlDataCoordinatesU = weaveControlDataCoordinates + vector(Dx(weaveControlDataCoordinates));
    point weaveControlDataCoordinatesV = weaveControlDataCoordinates + vector(Dy(weaveControlDataCoordinates));

    WeaveData weaveControlData = createWeaves(weaveControlDataCoordinates);
    WeaveData weaveData = createWeaves(weaveDataCoordinates);

    WeaveParams weaveParams;
    weaveParams.zGamma = FiberZGamma;
    weaveParams.verticalOnly = VerticalBumpOnly;

    float fiberBumpU, fiberBumpV;
    float fiberNoiseU, fiberNoiseV;
    vector fiberRotationU, fiberRotationV;

    displacedWeaves(weaveParams, weaveControlData, weaveData, Noise, Height, Rotation);
    displacedWeaves(weaveParams, createWeaves(weaveControlDataCoordinatesU), weaveData, fiberNoiseU, fiberBumpU, fiberRotationU);
    displacedWeaves(weaveParams, createWeaves(weaveControlDataCoordinatesV), weaveData, fiberNoiseV, fiberBumpV, fiberRotationV);

    // NAN FIX: Clean noise range logic
    float safeNoise = max(Noise, 0.0);
    float fiberBumpiness = Height * pow(safeNoise, FiberStrandBoost);

    float roughnessAlong = FiberSpecularRoughnessAlong * fiberBumpiness;
    float roughnessAcross = FiberSpecularRoughnessAcross * fiberBumpiness;

    SpecularRoughness = max(roughnessAlong, roughnessAcross);
    
    if (roughnessAcross > 1e-6) {
        SpecularAnisotropy = 1.0 - (roughnessAlong / roughnessAcross);
    } else {
        SpecularAnisotropy = 0.0;
    }

    BumpedNormal = bumpShadingNormal(FiberBumpStrength * fiberBumpiness);
}