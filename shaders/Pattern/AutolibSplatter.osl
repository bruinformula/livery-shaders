// Bump the smooth shading normal N by a height field in world units (the surface gradient,
// Mikkelsen 2010). Building the normal from cross(Dx(P'), Dy(P')) instead gives the flat normal of
// each triangle, facing whichever way the triangle is wound, so faces wound against the mesh
// normals bump backwards (dark or see-through triangles) and the rest shade faceted.
normal bumpShadingNormal(float height) {
    vector Nn = normalize(N);
    vector dPdx = Dx(P), dPdy = Dy(P);
    vector R1 = cross(dPdy, Nn), R2 = cross(Nn, dPdx);
    float det = dot(dPdx, R1);
    vector n = abs(det) * Nn - sign(det) * (Dx(height) * R1 + Dy(height) * R2);
    return dot(n, n) > 1e-24 ? normalize(n) : Nn;
}

float safeLength(vector vec) {
    return sqrt(max(dot(vec, vec), 1e-12));
}

// The linear map used to stretch drops along SplatterDirection. Also applied to the pixel
// footprint so the LOD sees the footprint in the same  stretched space as the distances.
vector stretchDiff(vector d, vector flowDir, float dirLen) {
    float along = dot(d, flowDir);
    vector perp = d - along * flowDir;
    return (perp / (1 + dirLen * 5.0)) + flowDir * along;
}

point randomCellPosition(int x, int y, float Jitter, int Seed) {
    vector off = cellnoise(vector(x, y, 0), Seed);
    return point(x + (off[0] - 0.5) * Jitter + 0.5, 
                 y + (off[1] - 0.5) * Jitter + 0.5, 0);
}

float randomRadius(int x, int y, float MinRadius, float MaxRadius, int Seed) {
    float randomValue = noise("hash", vector(x, y, Seed));
    return MinRadius + randomValue * (MaxRadius - MinRadius);
}

float sigmoidMask(float x, float low, float center, float sharpness) {
    float k = 1 / max(1e-6, sharpness);
    float exponent = clamp(-k * (x - center), -80, 80);
    float s = 1 / (1 + exp(exponent));
    return low + (1 - low) * s;
}

float smoothMin(float a, float b, float k) {
    float polyK = 1 / max(k, 1e-5); 
    float h = clamp(0.5 + 0.5 * (b - a) / polyK, 0, 1);
    return mix(b, a, h) - polyK * h * (1 - h);
}

// Per-cell color variation. The base color is passed in as HSV so the conversion is done once per
// layer instead of once per cell.
color randomCellAlbedoHSV(int x, int y, color baseHSV, float JitterAmount, int Seed) {
    float rS = noise("hash", vector(x, y, Seed + 100));
    float rV = noise("hash", vector(x, y, Seed + 101));

    float newS = clamp(baseHSV[1] * (1 + (rS - 0.5) * JitterAmount * 0.4), 0, 1);
    float newV = clamp(baseHSV[2] * (1 + (rV - 0.5) * JitterAmount * 0.4), 0, 1);

    return transformc("hsv", "rgb", color(baseHSV[0], newS, newV));
}

struct SplatterLayerParams {
    float Scale;
    color Albedo;
    int Seed;
    float Jitter;
    float MinRadius;
    float MaxRadius;
    float UnionSmoothness;

    float SpikeAmount;
    float SpikePeak;
    float SpikeFrequency;
    float SpikePerimeterSmoothness;
    float SpikeTrimWidth;

    float BasinHeight;
    float BasinCenter;
    float BasinSmoothness;

    float BumpStrength;
};

SplatterLayerParams jitterSplatterParams(
    SplatterLayerParams baseParams,
    int sublayerIndex,
    float jitterAmount,
    float colorJitterAmount
) {
    SplatterLayerParams jittered = baseParams;
    
    float rand1 = noise("hash", vector(baseParams.Seed + sublayerIndex, 0, 0));
    float rand2 = noise("hash", vector(baseParams.Seed + sublayerIndex, 1, 0));
    float rand3 = noise("hash", vector(baseParams.Seed + sublayerIndex, 2, 0));
    float rand4 = noise("hash", vector(baseParams.Seed + sublayerIndex, 3, 0));
    float rand5 = noise("hash", vector(baseParams.Seed + sublayerIndex, 4, 0));
    
    jittered.Seed = baseParams.Seed + sublayerIndex;
    jittered.MinRadius = baseParams.MinRadius * (1 + (rand2 - 0.5) * jitterAmount * 0.3);
    jittered.MaxRadius = baseParams.MaxRadius * (1 + (rand3 - 0.5) * jitterAmount * 0.3);
    
    jittered.SpikeAmount = clamp(baseParams.SpikeAmount + (rand4 - 0.5) * jitterAmount * 0.2, 0, 1);
    jittered.SpikePeak = baseParams.SpikePeak * (1 + (rand5 - 0.5) * jitterAmount * 0.4);
    
    float rand6 = noise("hash", vector(baseParams.Seed + sublayerIndex, 5, 0));
    jittered.BasinHeight = clamp(baseParams.BasinHeight + (rand6 - 0.5) * jitterAmount * 0.15, 0, 1);
    
    float rand7 = noise("hash", vector(baseParams.Seed + sublayerIndex, 6, 0));
    jittered.BumpStrength = clamp(baseParams.BumpStrength + (rand7 - 0.5) * jitterAmount * 0.1, 0, 1);

    float rand8  = noise("hash", vector(baseParams.Seed + sublayerIndex, 7, 0));
    float rand9  = noise("hash", vector(baseParams.Seed + sublayerIndex, 8, 0));

    if (colorJitterAmount > 0) {
        color safeAlbedo = max(baseParams.Albedo, 0);
        color hsv = transformc("rgb", "hsv", safeAlbedo);

        float newS = clamp(hsv[1] * (1 + (rand8  - 0.5) * colorJitterAmount * 0.3), 0, 1);
        float newV = clamp(hsv[2] * (1 + (rand9  - 0.5) * colorJitterAmount * 0.3), 0, 1);

        jittered.Albedo = transformc("hsv", "rgb", color(hsv[0], newS, newV));
    } else {
        jittered.Albedo = baseParams.Albedo;
    }

    return jittered;
}

struct SplatterData {
    float Height;
    float Mask;
    normal BumpedNormal;
    color Albedo;
    int LayerIdx;
};

point meshUV() {
    float st[2];
    if (getattribute("primvar", "st", st))
        return point(st[0], st[1], 0);
    return point(u, v, 0);
}

shader AutolibSplatterNew [[
    string label = "Splatter",
    string help = "Paint splatter: jittered drops with spiky rims and a raised basin, smoothly unioned, giving a "
                  "mask, height, bumped normal and albedo. Chain several through Other Data to layer splatters "
                  "of different scales and colors; the last node's outputs hold the combined result.",
    string rfh_classification = "RenderMan/Autolib/Pattern",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/pattern"
]] (
    point UV = meshUV() [[
        string label = "UV",
        string help = "Texture coordinates. Defaults to the mesh UVs (st); connect a Manifold to transform or replace them."
    ]],
    color LayerAlbedo = 1 [[
        string label = "Color",
        string help = "Paint color of this splatter layer."
    ]],

    float SplatterScale = 20.0 [[
        string label = "Scale",
        string help = "Number of drop cells per UV unit.",
        float min = 0, float slidermax = 200,
        string page = "Pattern",
        int page_open = 1
    ]],
    int Seed = 433 [[
        string label = "Seed",
        string help = "Random seed for drop placement and size.",
        string page = "Pattern"
    ]],
    float ColorJitter = 0.0 [[
        string label = "Color Jitter",
        string help = "Random per-drop variation of the color.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Pattern"
    ]],
    float Jitter = 2.0 [[
        string label = "Position Jitter",
        string help = "How far drops move from their cell centres, in cells.",
        float min = 0, float slidermax = 4,
        string page = "Pattern"
    ]],
    vector SplatterDirection = 0 [[
        string label = "Direction",
        string help = "Stretches every drop along this UV direction, as if thrown at an angle.",
        float slidermin = -1, float slidermax = 1,
        string page = "Pattern"
    ]],
    float MinRadius = 0.005 [[
        string label = "Min Radius",
        string help = "Smallest drop radius, in cells.",
        float min = 0, float slidermax = 1,
        string page = "Pattern"
    ]],
    float MaxRadius = 0.3 [[
        string label = "Max Radius",
        string help = "Largest drop radius, in cells.",
        float min = 0, float slidermax = 1,
        string page = "Pattern"
    ]],
    float UnionSmoothness = 8.0 [[
        string label = "Union Smoothness",
        string help = "Smooth-minimum sharpness where drops overlap: lower values merge them into blobs.",
        float min = 0, float slidermax = 32,
        string page = "Pattern"
    ]],
    int MarchBound = 1 [[
        string label = "Search Radius",
        string help = "Neighbouring cells searched for drops. Raise it if large or jittered drops get cut off at cell borders (slower). "
                      "With Auto Search Radius on, this is only an upper limit.",
        int min = 0, int slidermax = 4,
        int connectable = 0,
        string page = "Pattern"
    ]],
    int NumLayers = 1 [[
        string label = "Layers",
        string help = "Number of offset copies of this splatter combined for more complexity.",
        int min = 0, int slidermax = 8,
        int connectable = 0,
        string page = "Pattern"
    ]],

    float SpikeAmount = 0.9 [[
        string label = "Spike Amount",
        string help = "Strength of the spikes around each drop's rim.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Spikes",
        int page_open = 1
    ]],
    float SpikePeak = 8.0 [[
        string label = "Spike Peak",
        string help = "Height of the tallest spikes.",
        float min = 1, float slidermax = 16,
        string page = "Spikes"
    ]],
    float SpikeFrequency = 36.0 [[
        string label = "Spike Frequency",
        string help = "Number of spikes around a drop.",
        float min = 0, float slidermax = 64,
        string page = "Spikes"
    ]],
    float SpikePerimeterSmoothness = 0.01 [[
        string label = "Spike Smoothness",
        string help = "Softness of the drop outline.",
        float min = 0, float max = 1, float slidermax = 0.1,
        string page = "Spikes"
    ]],
    float SpikeTrimWidth = 0.02 [[
        string label = "Spike Seam Width",
        string help = "Width of the blend zone that hides the seam where the spike angle wraps around.",
        float min = 0, float max = 0.5, int slider = 1,
        string page = "Spikes"
    ]],

    float BasinHeight = 0.95 [[
        string label = "Basin Height",
        string help = "Height of the drop's interior relative to its raised rim.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Basin",
        int page_open = 1
    ]],
    float BasinCenter = 0.3 [[
        string label = "Basin Center",
        string help = "Where (from the centre, 0, to the rim, 1) the basin rises toward the rim.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Basin"
    ]],
    float BasinSmoothness = 0.075 [[
        string label = "Basin Smoothness",
        string help = "Softness of the rise from basin to rim.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Basin"
    ]],
    float BasinBumpStrength = 1 [[
        string label = "Bump Strength",
        string help = "Height of the splatter relief in scene units for the Bumped Normal output.",
        float min = 0, float slidermax = 0.05,
        string page = "Basin"
    ]],

    float LODBias = 1.0 [[
        string label = "Detail Filtering",
        string help = "Scales the pixel footprint used to fade out detail smaller than a pixel. "
                      "0 turns pixel-size filtering off (full detail everywhere, slowest). "
                      "Higher values are faster and softer; lower values are sharper but can alias.",
        float min = 0, float slidermax = 4,
        string page = "Performance",
    ]], 

    int AutoSearchRadius = 1 [[
        string label = "Auto Search Radius",
        string help = "Shrink the neighbour search to what the current jitter and drop size actually need.",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Performance"
    ]],

    SplatterData OtherData = {} [[
        string label = "Other Data",
        string help = "Connect the Data output of another Splatter to layer this one over it.",
        string page = "Chaining"
    ]],
    int DisableChaining = 0 [[
        string label = "Disable Chaining",
        string help = "Ignore Other Data and output only this splatter.",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Chaining"
    ]],

    output SplatterData Data = {} [[ string label = "Data", string help = "Combined splatter, for the next node's Other Data." ]],
    output float Height = 0 [[ string label = "Height", string help = "Combined splatter height." ]],
    output float Mask = 0 [[ string label = "Mask", string help = "1 inside any drop." ]],
    output normal BumpedNormal = N [[ string label = "Bumped Normal", string help = "Shading normal bumped by the combined height." ]],
    output color Albedo = 0 [[ string label = "Albedo", string help = "Combined paint color." ]],
    output int LayerIdx = 0 [[ string label = "Layer Index", string help = "Index of the topmost layer at this point." ]]
) {
    point ScaledPos = SplatterScale * UV;
    int cellX = (int)floor(ScaledPos[0]);
    int cellY = (int)floor(ScaledPos[1]);

    //Drop stretching
    float dirLen = safeLength(SplatterDirection);
    int stretched = dirLen > 1e-6;
    vector flowDir = vector(1, 0, 0);
    float stretch = 1;
    if (stretched) {
        flowDir = normalize(SplatterDirection);
        stretch = 1 + dirLen * 5.0;
    }

    // Pixel footprint, in cell units
    vector footDx = Dx(ScaledPos);
    vector footDy = Dy(ScaledPos);
    if (stretched) {
        footDx = stretchDiff(footDx, flowDir, dirLen);
        footDy = stretchDiff(footDy, flowDir, dirLen);
    }
    float fullWidth = LODBias * max(length(footDx), length(footDy));
    if (!isfinite(fullWidth)) fullWidth = 0;

    // Footprint in cells over which we cross-fade from "resolve the drops" to "return the
    // statistical average". Above lodEnd several drops overlap every pixel.
    float lodStart = 1.0;
    float lodEnd = 2.0;
    float lodWidth = smoothstep(lodStart, lodEnd, fullWidth);   // 0 = full detail, 1 = average only

    SplatterLayerParams baseParams = {
        SplatterScale, LayerAlbedo, Seed, Jitter, MinRadius, MaxRadius, UnionSmoothness,
        SpikeAmount, SpikePeak, SpikeFrequency, SpikePerimeterSmoothness, SpikeTrimWidth,
        BasinHeight, BasinCenter, BasinSmoothness, BasinBumpStrength
    };

    SplatterLayerParams jitteredParams = baseParams;

    int fullBound = MarchBound + (int)ceil(Jitter);

    float finalHeight = 0;
    float finalMask = 0;
    color finalAlbedo = 0;
    float finalAlbedoWeight = 0;

    for (int layerIdx = 0; layerIdx < NumLayers; layerIdx++) {
        jitteredParams = jitterSplatterParams(jitteredParams, layerIdx, Jitter * 0.2, ColorJitter);

        // Per-layer constants
        float jSmooth = jitteredParams.UnionSmoothness;
        float polyK = 1 / max(jSmooth, 1e-5);

        float spikeW = jitteredParams.SpikeAmount;
        float peak = max(jitteredParams.SpikePeak, 1e-5);
        float peakHi = max(peak, 1 / peak);
        // Upper bound of the radius multiplier the spikes can produce (snoise is within [-1,1];
        // the 1.05 is margin).
        float spikeMaxScale = 1.05 * (1 + spikeW * (peakHi - 1));

        // Edge softness: at least the user's value, at least one pixel. The ramp is shifted so the
        // widened edge is centred on the rim instead of eating into the drop. 
        float perimSmooth = jitteredParams.SpikePerimeterSmoothness;
        float edgeWidth = max(perimSmooth, fullWidth);
        float edgeShift = 0.5 * (edgeWidth - perimSmooth);
        float minDotRadius = 0.5 * fullWidth;                  // drops thinner than a pixel render as a pixel-sized dot

        float m = 0;
        float h = 0;
        color layerAlbedo = jitteredParams.Albedo;

        // Expensive evaluation
        if (lodWidth < 1) {
            float layerMask = 0;
            float layerSmoothDist = 1e6;

            color layerAlbedoAccum = 0;
            float layerAlbedoWeight = 0;

            color baseHSV = 0;
            if (ColorJitter > 0)
                baseHSV = transformc("rgb", "hsv", max(jitteredParams.Albedo, 0));

            // Largest distance at which any drop of this layer can still affect the mask.
            float rMaxCull = max(max(jitteredParams.MinRadius, jitteredParams.MaxRadius) * spikeMaxScale,
                                 minDotRadius) + edgeShift;

            // A cell k steps away has its centre at k + 0.5 +/- Jitter/2,
            // so it can only reach us if k <= R + 0.5 + Jitter/2. R is scaled by the stretch since
            // distances are measured after the stretch.
            int bound = fullBound;
            if (AutoSearchRadius) {
                int tight = (int)floor(rMaxCull * stretch + 0.5 + 0.5 * jitteredParams.Jitter + 1e-4);
                if (tight < bound) 
                    bound = tight;
            }

            for (int x = -bound; x <= bound; x++) {
                for (int y = -bound; y <= bound; y++) {
                    int cx = cellX + x;
                    int cy = cellY + y;

                    point cellCenter = randomCellPosition(cx, cy, jitteredParams.Jitter, jitteredParams.Seed);
                    vector diff = ScaledPos - cellCenter;
                    if (stretched)
                        diff = stretchDiff(diff, flowDir, dirLen);

                    // unconditionally push diff.x slightly away from absolute zero for atan2
                    diff.x += (diff.x == 0 && diff.y == 0) ? 1e-8 : 0;

                    // Use safeLength() to prevent zero-length distance tracking
                    float dist = safeLength(diff);

                    float rad = randomRadius(cx, cy, jitteredParams.MinRadius, jitteredParams.MaxRadius, jitteredParams.Seed);

                    // Smooth union of distances. smoothMin(a, b, k) returns exactly a once
                    // b >= a + polyK, so skipping those cells does not change the result.
                    if (dist < layerSmoothDist + polyK)
                        layerSmoothDist = smoothMin(layerSmoothDist, dist, jSmooth);

                    // Albedo weights fall off as exp(-k * dist); beyond ~16 they are negligible.
                    // Without color jitter every cell has the same color, so none of this is needed.
                    if (ColorJitter > 0) {
                        float cellExp = clamp(-jSmooth * dist, -80, 80);
                        if (cellExp > -16) {
                            float cellWeight = exp(cellExp);
                            layerAlbedoAccum += cellWeight * randomCellAlbedoHSV(cx, cy, baseHSV, ColorJitter, jitteredParams.Seed);
                            layerAlbedoWeight += cellWeight;
                        }
                    }

                    // This cell's drop cannot reach the shading point: no mask contribution.
                    if (dist >= rMaxCull)
                        continue;

                    // Spikes. Fade them out when their wavelength along the rim is below the
                    // footprint; skip the atan2 / snoise / hash entirely when the weight is ~0.
                    float spikeMul = 1;
                    float wSpike = spikeW;
                    if (fullWidth > 0) {
                        float wavelength = M_2PI * rad / max(jitteredParams.SpikeFrequency, 1e-3);
                        wSpike *= smoothstep(1.0, 3.0, wavelength / fullWidth);
                    }
                    if (wSpike > 1e-4) {
                        float angle = (atan2(diff.y, diff.x) / M_2PI) + 0.5;

                        float circleSeed = noise("hash", vector(cx, cy, jitteredParams.Seed)) * 100;
                        float addNoise = noise("snoise", (angle * jitteredParams.SpikeFrequency) + circleSeed);

                        addNoise = pow(peak, addNoise);

                        if (jitteredParams.SpikeTrimWidth > 0) {
                            float edge = min(angle, 1 - angle);
                            addNoise *= smoothstep(0, jitteredParams.SpikeTrimWidth, edge);
                        }

                        spikeMul = mix(1, addNoise, wSpike);
                    }

                    // Per-cell mask, combined with max(). Because the mask is a decreasing function
                    // of distance, max over cells equals the old single smoothstep on the minimum
                    // distance when fullWidth = 0.
                    float rN = rad * spikeMul;
                    float rE = max(rN, minDotRadius);
                    float cov = (rE > rN) ? (rN / rE) * (rN / rE) : 1.0;   // area ratio for sub-pixel drops
                    float mi = (1 - smoothstep(-edgeWidth, 0, dist - rE - edgeShift)) * cov;
                    layerMask = max(layerMask, mi);
                }
            }

            m = layerMask;

            // Blur the basin ramp to at least one pixel as well.
            float basinSharp = max(jitteredParams.BasinSmoothness, fullWidth);
            h = sigmoidMask(layerSmoothDist, jitteredParams.BasinHeight, jitteredParams.BasinCenter, basinSharp) * 1.4 * m;

            if (ColorJitter > 0 && layerAlbedoWeight > 1e-6)
                layerAlbedo = layerAlbedoAccum / layerAlbedoWeight;
        }

        // Statistical average, for when a pixel covers many drops
        // Boolean-model coverage with one drop per cell: 1 - exp(-density * mean drop area).
        // Spikes are ignored as their mean effect is small and they are filtered out at this scale.
        if (lodWidth > 0) {
            float rA = jitteredParams.MinRadius;
            float rB = jitteredParams.MaxRadius;
            float meanR2 = (rA * rA + rA * rB + rB * rB) / 3;
            float covAvg = 1 - exp(-M_PI * meanR2 * stretch);
            float basinSharpAvg = max(jitteredParams.BasinSmoothness, fullWidth);
            float hAvg = covAvg * 1.4 *
                         sigmoidMask(0.667 * sqrt(meanR2), jitteredParams.BasinHeight,
                                     jitteredParams.BasinCenter, basinSharpAvg);

            m = mix(m, covAvg, lodWidth);
            h = mix(h, hAvg, lodWidth);
            layerAlbedo = mix(layerAlbedo, jitteredParams.Albedo, lodWidth);
        }

        finalHeight = max(finalHeight, h);
        finalMask = max(finalMask, m);

        finalAlbedo += layerAlbedo * m;
        finalAlbedoWeight += m;
    }

    color thisAlbedo = (finalAlbedoWeight > 1e-6) ? finalAlbedo / finalAlbedoWeight : 0;
    thisAlbedo = thisAlbedo * finalMask;

    // Bump only when it can matter.
    // Allowing osl to fold the results if the BasinBumpStrength is 0 
    normal finalNormal;
    if (BasinBumpStrength > 0 && lodWidth < 1) {
        finalNormal = bumpShadingNormal(finalHeight * jitteredParams.BumpStrength);
    } else {
        finalNormal = N;
    }
    int thisLayerIdx = 0;

    color compositeAlbedo = finalHeight * thisAlbedo;
    float compositeMask = finalMask;
    float compositeHeight = finalHeight;
    normal compositeNormal = finalNormal;

    if (isconnected(OtherData) && !DisableChaining) {
        thisLayerIdx = OtherData.LayerIdx + 1;
        compositeAlbedo = thisAlbedo + OtherData.Albedo * (1 - finalHeight);
        compositeMask = max(finalMask, OtherData.Mask);
        compositeHeight = finalHeight + OtherData.Height;
        compositeNormal = normalize(mix(vector(OtherData.BumpedNormal), vector(finalNormal), finalMask));
    }

    Data.Height = compositeHeight;
    Data.Mask = compositeMask;
    Data.BumpedNormal = compositeNormal;
    Data.Albedo = compositeAlbedo;
    Data.LayerIdx = thisLayerIdx;

    Height = compositeHeight;
    Mask = compositeMask;
    BumpedNormal = compositeNormal;
    Albedo = compositeAlbedo;
    LayerIdx = thisLayerIdx;
}
