// Bump the smooth shading normal N by a height field in world units (the surface gradient,
// Mikkelsen 2010). Building the normal from cross(Dx(P'), Dy(P')) instead gives the flat normal of
// each triangle, facing whichever way the triangle is wound, so faces wound against the mesh
// normals bump backwards (dark or see-through triangles) and the rest shade faceted.
normal bumpShadingNormal(float height) {
    vector Nn = normalize(N);
    vector dPdx = Dx(P), dPdy = Dy(P);
    vector R1 = cross(dPdy, Nn), R2 = cross(Nn, dPdx);
    float det = dot(dPdx, R1);
    vector n = abs(det) * Nn - sign(det) * (Dx(height) * R1 + Dy(height) * R2);
    return dot(n, n) > 1e-24 ? normalize(n) : Nn;
}

// The mesh UVs. Arnold's u,v on a mesh are its UVs; RenderMan's are per-face parametric coordinates,
// so read the st primvar when the renderer exposes it (the default of the UV input).
point meshUV() {
    float st[2];
    if (getattribute("primvar", "st", st))
        return point(st[0], st[1], 0);
    return point(u, v, 0);
}

shader AutolibPowdercoat [[
    string label = "Powdercoat",
    string help = "Powder coat orange peel: a fine micro noise and a broad macro noise combined into a bumped "
                  "normal, plus a banding pattern for spray streaks.",
    string rfh_classification = "RenderMan/Autolib/Pattern",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/pattern"
]] (
    point UV = meshUV() [[
        string label = "UV",
        string help = "Texture coordinates. Defaults to the mesh UVs (st); connect a Manifold to transform or replace them."
    ]],
    float MicroScale = 100 [[
        string label = "Micro Scale",
        string help = "Frequency of the fine grain noise, per UV unit.",
        float min = 0, float slidermax = 5000,
        string page = "Orange Peel",
        int page_open = 1
    ]],
    float MicroStrength = 0.1 [[
        string label = "Micro Strength",
        string help = "Amount of fine grain in the height.",
        float min = 0, float slidermax = 1,
        string page = "Orange Peel"
    ]],
    float MacroScale = 0.1 [[
        string label = "Macro Scale",
        string help = "Frequency of the broad orange peel noise, per UV unit.",
        float min = 0, float slidermax = 50,
        string page = "Orange Peel"
    ]],
    float MacroStrength = 1 [[
        string label = "Macro Strength",
        string help = "Amount of broad orange peel in the height.",
        float min = 0, float slidermax = 1,
        string page = "Orange Peel"
    ]],
    float BumpStrength = 1 [[
        string label = "Bump Strength",
        string help = "Height of the combined relief in scene units for the Normal output.",
        float min = 0, float slidermax = 0.01,
        string page = "Orange Peel"
    ]],

    float BandAngle = 0 [[
        string label = "Band Angle",
        string help = "Direction of the spray bands in UV space, in degrees.",
        float slidermin = 0, float slidermax = 180,
        string page = "Banding",
        int page_open = 1
    ]],
    float BandFrequency = 10 [[
        string label = "Band Frequency",
        string help = "Number of bands per UV unit.",
        float min = 0, float slidermax = 100,
        string page = "Banding"
    ]],

    output float Banding = 0 [[ string label = "Banding" ]],
    output float MacroBumpNoise = 0 [[ string label = "Macro Noise" ]],
    output float MicroBumpNoise = 0 [[ string label = "Micro Noise", string help = "Use for roughness variation." ]],
    output normal Normal = N [[ string label = "Normal", string help = "Shading normal bumped by the orange peel." ]]
) {

    //  Micro bump
    point microScaledUV = MicroScale * UV;
    float microBumpNoise = MicroStrength * noise("usimplex", microScaledUV);

    point macroScaledUV = MacroScale * UV;
    float macroBumpNoise = MacroStrength * noise("uperlin", macroScaledUV);

    Normal = bumpShadingNormal(BumpStrength * (macroBumpNoise + microBumpNoise));

    float bandAngleRadians = radians(BandAngle);
    vector bandDirection = vector(cos(bandAngleRadians), sin(bandAngleRadians), 0);
    float offset = min(cos(bandAngleRadians), 0) + min(sin(bandAngleRadians), 0);
    Banding = floor((dot(bandDirection, UV) - offset) * BandFrequency);

    MacroBumpNoise = macroBumpNoise;
    MicroBumpNoise = microBumpNoise;

    // TODO do shit with the bands 
}