// The mesh UVs. Arnold's u,v on a mesh are its UVs; RenderMan's are per-face parametric coordinates,
// so read the st primvar when the renderer exposes it (the default of the UV input).
point meshUV() {
    float st[2];
    if (getattribute("primvar", "st", st))
        return point(st[0], st[1], 0);
    return point(u, v, 0);
}

shader AutolibTooledSteel [[
    string label = "Tooled Steel",
    string help = "Machined metal (spot facing / engine turning): a spiral tool path with overlapping circular "
                  "tool marks, giving a mask and an anisotropy amount for brushed-metal speculars.",
    string rfh_classification = "RenderMan/Autolib/Pattern",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/pattern"
]] (
    point UV = meshUV() [[
        string label = "UV",
        string help = "Texture coordinates. Defaults to the mesh UVs (st); connect a Manifold to transform or replace them."
    ]],
    vector Offset = 0.5 [[
        string label = "Center",
        string help = "Centre of the spiral in UV space.",
        float slidermin = 0, float slidermax = 1
    ]],
    float Scale = 0.1 [[
        string label = "Scale",
        string help = "Size of the pattern in UV units.",
        float min = 0, float slidermax = 1
    ]],

    float Strength = 1 [[
        string label = "Strength",
        string help = "Contribution of the spiral path.",
        float min = 0, float slidermax = 2,
        string page = "Spiral Path",
        int page_open = 1
    ]],
    float Width = 4 [[
        string label = "Width",
        string help = "Width of the spiral path.",
        float min = 0, float slidermax = 10,
        string page = "Spiral Path"
    ]],
    float Gradient = 3 [[
        string label = "Gradient",
        string help = "Falloff across the spiral path.",
        float min = 0, float slidermax = 10,
        string page = "Spiral Path"
    ]],

    float NoiseScaleU = 0.05 [[
        string label = "Noise Scale U",
        string help = "Noise frequency along the path.",
        float min = 0, float slidermax = 1,
        string page = "Circles",
        int page_open = 1
    ]],
    float NoiseScaleV = 200 [[
        string label = "Noise Scale V",
        string help = "Noise frequency across the path.",
        float min = 0, float slidermax = 500,
        string page = "Circles"
    ]],
    int NumCircles = 100 [[
        string label = "Circles",
        string help = "Number of tool circles in one span of the path.",
        int min = 1, int slidermax = 400,
        string page = "Circles"
    ]],
    float CircleAspect = 2 [[
        string label = "Circle Aspect",
        string help = "Makes the rings more or less elliptical.",
        float min = 0, float slidermax = 4,
        string page = "Circles"
    ]],
    float CircleRingWidth = 0.01 [[
        string label = "Ring Width",
        string help = "Width of each ring's perimeter.",
        float min = 0, float slidermax = 0.1,
        string page = "Circles"
    ]],
    float CircleSoftness = 0.0 [[
        string label = "Ring Softness",
        string help = "Softness of the ring perimeters.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Circles"
    ]],

    output point SpiralCoord = 0 [[ string label = "Spiral Coord", string help = "Coordinates along / across the spiral path." ]],
    output float Spiral = 0 [[ string label = "Spiral" ]],
    output float CircleNoise = 0 [[ string label = "Circle Noise" ]],
    output float CircleMask = 0 [[ string label = "Circle Mask" ]],
    output float CircleAnisotropy = 0 [[ string label = "Anisotropy", string help = "Anisotropy amount for the tool marks." ]]
) {
    point q = (UV - Offset);
    q.z = 0;
    float radius = length(q);
    float theta = atan2(q.y, q.x);
    
    float remappedTheta = (theta < 0.0) ? theta + M_2PI : theta;
    float b = Scale / M_2PI;
    float phiAtRadius = radius / b;
    float angularDelta = mod(remappedTheta - mod(phiAtRadius, M_2PI) + 3*M_PI, M_2PI) - M_PI;
    float line = 1 - smoothstep(Gradient, Width, abs(angularDelta));
    
    float spiralU = mod(theta / M_2PI, 1.0);
    float spiralV = mod((phiAtRadius - angularDelta) / M_2PI, 1.0);
    
    SpiralCoord = point(spiralU, spiralV, 0);
    Spiral = line * Strength;
    
    float thetaSpacing = M_2PI / (float)NumCircles;
    float bestRim = 1e10;
    float bestDU = 0.0;
    float bestDV = 0.0;
    int bestC = 0;
    
    for (int c = 0; c < NumCircles; ++c) {
        float thetaC = (float)c * thetaSpacing;
        float du = mod(theta - thetaC + M_PI, M_2PI) - M_PI;
        float duScaled = (du * radius / b) * CircleAspect;
        float dvScaled = angularDelta;
        float dist = sqrt(duScaled * duScaled + dvScaled * dvScaled);
        float rim = abs(dist - Width);
        
        if (rim < CircleRingWidth) {
            float thetaNext = (float)((c + 1) % NumCircles) * thetaSpacing;
            float duNext = mod(theta - thetaNext + M_PI, M_2PI) - M_PI;
            float duNextScaled = (duNext * radius / b) * CircleAspect;
            float distNext = sqrt(duNextScaled * duNextScaled + dvScaled * dvScaled);
            
            if (distNext >= Width && rim < bestRim) {
                bestRim = rim;
                bestDU = duScaled;
                bestDV = dvScaled;
                bestC = c;
            }
        }
    }
    
    if (bestRim < CircleRingWidth) {
        float t = bestRim / CircleRingWidth;
        CircleMask = smoothstep(t, 1, CircleSoftness);
        float tangentAngle = atan2(bestDU, -bestDV);
        CircleAnisotropy = mod(tangentAngle / M_PI, 1.0) * CircleMask;
        // local circle UV: angle around the circle as U, rim distance as V
        float circleAngle = atan2(bestDV, bestDU);
        float circleV = bestRim / CircleRingWidth;
        float nu = Width * NoiseScaleU;
        CircleNoise = noise("usimplex", vector(cos(circleAngle) * nu, sin(circleAngle) * nu, (float)bestC * 137.508 + circleV * NoiseScaleV));
    }
}