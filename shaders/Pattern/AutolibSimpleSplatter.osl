// AutolibSimpleSplatter

// The mesh UVs. Arnold's u,v on a mesh are its UVs; RenderMan's are per-face parametric coordinates,
// so read the st primvar when the renderer exposes it (the default of the UV input).
point meshUV() {
    float st[2];
    if (getattribute("primvar", "st", st))
        return point(st[0], st[1], 0);
    return point(u, v, 0);
}

shader AutolibSimpleSplatter [[
    string label = "Simple Splatter",
    string help = "A cheap round-drop splatter mask and height, without spikes or chaining.",
    string rfh_classification = "RenderMan/Autolib/Pattern",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/pattern"
]] (
    vector UV = meshUV() [[
        string label = "UV",
        string help = "Texture coordinates. Defaults to the mesh UVs (st); connect a Manifold to transform or replace them."
    ]],
    float scale = 5.0 [[
        string label = "Scale",
        string help = "Number of drop cells per UV unit.",
        float min = 0, float slidermax = 50
    ]],
    float smoothness = 0.01 [[
        string label = "Smoothness",
        string help = "Softness of the drop edges.",
        float min = 0, float max = 1, float slidermax = 0.1
    ]],
    float basinHeight = 0.6 [[
        string label = "Basin Height",
        string help = "Height of the drop interior relative to the rim.",
        float min = 0, float max = 1, int slider = 1
    ]],

    output float Mask = 0.0 [[ string label = "Mask" ]],
    output float Height = 0.0 [[ string label = "Height" ]]
) {

    float speckle = noise(transform("shader", UV) * scale);

    Mask = step(0.7 - smoothness, speckle);

    float bigMask = smoothstep(0.7 - smoothness * 2.0, 0.7 - smoothness, speckle);
    float smallMask = smoothstep(0.7 - smoothness, 0.7, speckle) * basinHeight;

    Height = bigMask - smallMask;
}