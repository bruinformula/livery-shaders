// AutolibNoisyVoronoi

point fract(point p) {
    point fractional = point(0);
    float whole_x= floor(p[0]);
    float whole_y = floor(p[1]);
    float whole_z = floor(p[2]);
    fractional[0] = p[0] - whole_x;
    fractional[1] = p[1] - whole_y;
    fractional[2] = p[2] - whole_z;
    return fractional;
}

#define CELL 0
#define HASH 1
#define SIMPLEX 2

shader AutolibNoisyVoronoi [[
    string label = "Noisy Voronoi",
    string help = "Voronoi cells with noise-distorted borders, filled with two colors or random colors per cell; "
                  "optional metaball blending between cells.",
    string rfh_classification = "RenderMan/Autolib/Pattern",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/pattern"
]] (
    point UVW = transform("world", P) [[
        string label = "Position",
        string help = "Where the cells are evaluated. Defaults to world position (see Object Space)."
    ]],
    int ObjectUVW = 1 [[
        string label = "Object Space",
        string help = "Use object space position instead of world space, so cells stick to moving objects.",
        string widget = "checkBox",
        int connectable = 0
    ]],

    color Color1 = 1 [[
        string label = "Cell Color",
        string page = "Color",
        int page_open = 1,
        string conditionalVisOp = "equalTo",
        string conditionalVisPath = "../Multicolored",
        string conditionalVisValue = "0"
    ]],
    color Color2 = 0 [[
        string label = "Border Color",
        string page = "Color",
        string conditionalVisOp = "equalTo",
        string conditionalVisPath = "../Multicolored",
        string conditionalVisValue = "0"
    ]],
    int Multicolored = 0 [[
        string label = "Random Colors",
        string help = "Give every cell a random color instead of Cell / Border Color.",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Color"
    ]],

    float Scale = 1 [[
        string label = "Scale",
        string help = "Size of the cells.",
        float min = 0.001, float max = 10, int slider = 1,
        string page = "Cells",
        int page_open = 1
    ]],
    float scaleMultiplier = 1 [[
        string label = "Scale Multiplier",
        string help = "Extra multiplier on Scale for fine control.",
        float min = 0.001, float max = 10, int slider = 1,
        string page = "Cells"
    ]],
    int seed = 0 [[
        string label = "Seed",
        string help = "Random seed for the cell pattern.",
        int min = 0, int max = 32767,
        string page = "Cells"
    ]],
    float cellExpansion = 1.5 [[
        string label = "Cell Fill",
        string help = "How much of each cell is filled; lower values open up the borders.",
        float min = -2, float max = 2, int slider = 1,
        string page = "Cells"
    ]],
    int blobby = 0 [[
        string label = "Blobby",
        string help = "Blend neighbouring cells like metaballs.",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Cells"
    ]],
    float offsetMultiplier = 6 [[
        string label = "Offset Multiplier",
        string help = "Offset between the noise lookups of each octave, for pattern variations.",
        float min = 0.01, float max = 10, int slider = 1,
        string page = "Cells"
    ]],

    int noiseType = SIMPLEX [[
        string label = "Noise Type",
        string help = "Noise that distorts the cell borders.",
        string widget = "mapper",
        string options = "Cell:0|Hash:1|Simplex:2",
        int connectable = 0,
        string page = "Border Noise",
        int page_open = 1
    ]],
    float noiseScale = 1 [[
        string label = "Noise Scale",
        string help = "Frequency of the border noise.",
        float min = 0, float max = 10, int slider = 1,
        string page = "Border Noise"
    ]],
    float noiseAmount = 0.15 [[
        string label = "Noise Amount",
        string help = "How far the noise pushes the borders.",
        float min = 0, float max = 10, float slidermax = 1,
        string page = "Border Noise"
    ]],
    int octaves = 1 [[
        string label = "Octaves",
        string help = "Number of noise octaves.",
        int min = 1, int max = 20, int slidermax = 8,
        string page = "Border Noise"
    ]],

    output color Color = 0 [[ string label = "Color" ]]
) {
    point uvw = point(0);

    if (ObjectUVW == 1) {
        uvw = transform("object", P) / (Scale * scaleMultiplier); // object space uvw
    } else {
        uvw = UVW / (Scale * scaleMultiplier); // world space uvw
    }
    
    uvw += 0.0001; // prevents z-fighting on objects with no depth

    point intUVW= floor(uvw);	
    point fracUVW = fract(uvw);
    float minDistance = 1.5; 
    point minPoint = 0;     
    float positionNoise = 0;

    // noise iterations
    if (noiseScale > 0 && noiseAmount > 0){
        for (int o = 1; o < octaves + 1; o++) {
            float n = noiseScale / (o * 4); // reduce noise size by 4 each iteration
            int shift = o; // prevents spiky striations from the origin
            if (noiseType == CELL) {
                positionNoise += noise("cell", point((uvw[0] + shift) / n, (uvw[1] + shift) / n, (uvw[2] + shift )/ n)) * noiseAmount;
            } else if (noiseType == HASH) {
                positionNoise += noise("hash", point((uvw[0] + shift) / n, (uvw[1] + shift) / n, (uvw[2] + shift )/ n)) * noiseAmount;
            } else {
                positionNoise += noise("simplex", point((uvw[0] + shift) / n, (uvw[1] + shift) / n, (uvw[2] + shift )/ n)) * noiseAmount;
             }
        }
    }

    // Voronoi cells 
    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            for (int z = -1; z <= 1; z++) {
                point neighbor = point(float(x), float(y), float(z));

                point offset = fract(hashnoise(intUVW + neighbor, 1) * seed);
    
                offset = 0.5 + 0.5 * sin(offsetMultiplier * offset);
    
                // Position of the cell with added noise
                point newPoint = neighbor + offset - fracUVW + positionNoise;
                float cellDistance = length(newPoint);
                
                if(cellDistance < minDistance) {
                    minDistance = cellDistance;
                    minPoint = offset;
                }
                
               // blend circles
                if (blobby == 1) {
                    minDistance = min(minDistance, minDistance * cellDistance);
                }
            }
        }
    }
    
    // greyscale values of the cells
    float cellValue = max(dot(minPoint, point(0.25,0.5,0.0)), step(cellExpansion + positionNoise, minDistance)) ;

    if (Multicolored == 1) {
        Color = color( max(dot(minPoint, point(1,0,0)), step(cellExpansion + positionNoise, minDistance)),
                          max(dot(minPoint, point(0,1,0)), step(cellExpansion + positionNoise, minDistance)),
                          max(dot(minPoint, point(0,0,1)), step(cellExpansion + positionNoise, minDistance)) );
    } else {
      Color = mix(Color1, Color2, cellValue); 
    }
}