// Hatch space is screen space, normalized so that it doesn't depend
// on the resolution or on the aspect ratio of the image
point worldToHatch(
    point world,
    point resolution
) {
    point raster = transform("world", "raster", world);

    // One unit is the larger dimension of the image. 
    float scale = max(resolution.x, resolution.y);

    // The origin is the center of the image
    return point((raster.x - 0.5 * resolution.x) / scale,
                 (raster.y - 0.5 * resolution.y) / scale,
                 0);
}


// Clip an infinite hatch line against one edge of the boundary.
// Returns:
//     0 if the edge does not limit the line
//     1 if the edge limits the line from below (s >= bound)
//     2 if the edge limits the line from above (s <= bound)
//    -1 if the edge removes the whole line
//
// bound is the position along the hatch line:
//     s = dot(position, lineDirection)
int clipHatchEdge(
    point A, // Edge Point A
    point B, // Edge Point B
    point Q, // Shading Point
    float horizontal, // X component of the hatch normal
    float vertical, // Y component of the hatch normal
    float lineOffset, // The current line (y offset)
    float inset, // Padding between the end of the line and the edge
    float halfWidth, // Half the width of the line
    float wander, // How far the line can be shifted sideways by the squiggle
    int squareEnd, // 1 for a flat end, 0 for a round end
    output float bound
) {
    // The edge is pushed inward by inset, toward the side of the face
    // that contains the shading point, and the hatch line is cut where
    // it crosses the pushed in edge. Pushing the edge in is what lets the
    // line stop before the real boundary, no matter what angle the line
    // meets the edge at.

    // Edge goes A -> B
    vector edge = B - A;
    float edgeLength = length(edge);

    // Degenerate edge, nothing to clip against.
    if (edgeLength < 1e-9) {
        return 0;
    }

    // The normal of the edge flipped so it points at the shading
    // point, the shading point is always on the inside of the face
    // so this doesn't depend on the winding of the vertices.
    vector inward = vector(-edge.y, edge.x, 0) / edgeLength;
    if (dot(inward, Q - A) < 0) {
        inward = -inward;
    }

    // Any point on the hatch line can be written as:
    //     lineOffset * lineNormal + s * lineDirection
    vector lineNormal = vector(horizontal, vertical, 0);
    vector lineDirection = vector(-vertical, horizontal, 0);

    // How much the line is angled toward this edge. 1 means the line
    // runs straight at the edge, 0 means it runs along the edge.
    float angle = abs(dot(inward, lineNormal));

    // How far the end of the line reaches toward this edge. A round end
    // reaches one radius whatever the angle. A flat end is as wide as the
    // line, so its corner reaches toward the edge by an amount that
    // depends on the angle between the line and the edge.
    float reach = halfWidth;
    if (squareEnd) {
        reach = halfWidth * angle;
    }

    // A squiggled line is shifted sideways, which moves its end toward
    // the edge by an amount that depends on the same angle.
    float required = inset + reach + wander * angle;

    // Walking along the line the distance to the edge is linear in s:
    //     distance(s) = start + rate * s
    float rate = dot(inward, lineDirection);
    float start = lineOffset * dot(inward, lineNormal) - dot(inward, A);

    // The line is parallel to the edge so it is either always far
    // enough away from it or it is never far enough away from it.
    if (abs(rate) < 1e-6) {
        return (start >= required) ? 0 : -1;
    }

    // Solve distance(s) >= required for s. Dividing by a negative rate
    // flips the inequality so the bound becomes an upper one.
    bound = (required - start) / rate;
    return (rate > 0) ? 1 : 2;
}


shader AutolibSketchFill (
    point Position = P [[ string widget = "null", int interpolated = 1 ]],
    float Skew = 45 [[ string help = "This rotates the base space by degrees", float min = 0 ]],
    float LineSpacing = 0.05 [[ string help = "Distance between the lines as a fraction of the larger image dimension", float min = 0 ]],
    float LineWidth = 0.005 [[ string help = "Width of the lines as a fraction of the larger image dimension, independent of the spacing, the resolution and the aspect ratio", float min = 0 ]], 
    
    string TerminationType = "Square" [[ string page = "Termination", string help = "Specifies the type of termination for the lines", string widget = "mapper", string options = "Round|Square|Butt" ]],
    float TerminationTaperWidth = 0 [[ string page = "Termination", string help = "Adds a thinned termination of hatches", float min = 0 ]],
    float TerminationTaperSlope = 1 [[ string page = "Termination", string help = "Specifies the slope of the start and endpoints of the lines", float min = 0 ]],

    float SquiggleAmount = 0 [[ string page = "Noise", string help = "Moves the line sideways as it is drawn, similar to lines drawn by hand. 0 is a straight line and 1 lets the line wander through all the room between it and its neighbors", float min = 0, float max = 1 ]],
    float SquiggleScale = 0.5 [[ string page = "Noise", string help = "Defines the XAxis scale of squiggle", float min = 0, float max = 1 ]],
    float PressureAmount = 0 [[ string page = "Noise", string help = "Varys the thickness of the line", float min = 0 ]],
    float PressureFrequency = 0.5 [[ string page = "Noise", string help = "Defines the frequency at which the thickness varys", float min = 0, float max = 1 ]],
   
    float BoundaryWidth = 0.005 [[ string page = "Boundary", string help = "Width of the boundary. With constant width it is a fraction of the larger image dimension and stays the same on screen. Without constant width it is in world units and scales with the camera", float min = 0 ]],
    // Cad tesselations can have an irregular distrobution of vertices 
    // These distances are Candidate distances for the boundary edges.
    // They are compared and the closest one is used to determine the 
    // boundary proximity.
    float BoundaryEdgeDistance0 = 0 [[ string page = "Boundary", string help = "Plug in the boundaryEdgeDistance0 faceVarying float primvar. Distance from this face corner to triangle edge 0, or 0 if that edge is not a boundary. When none of the three are connected, uses primedges as a default.", string widget = "null", int interpolated = 1 ]],
    float BoundaryEdgeDistance1 = 0 [[ string page = "Boundary", string help = "Plug in the boundaryEdgeDistance1 faceVarying float primvar.", string widget = "null", int interpolated = 1 ]],
    float BoundaryEdgeDistance2 = 0 [[ string page = "Boundary", string help = "Plug in the boundaryEdgeDistance2 faceVarying float primvar.", string widget = "null", int interpolated = 1 ]],
    float BoundaryEdgeDistance3 = 0 [[ string page = "Boundary", string help = "Plug in the boundaryEdgeDistance3 faceVarying float primvar.", string widget = "null", int interpolated = 1 ]],
    float BoundaryEdgeDistance4 = 0 [[ string page = "Boundary", string help = "Plug in the boundaryEdgeDistance4 faceVarying float primvar.", string widget = "null", int interpolated = 1 ]],
    float BoundaryEdgeDistance5 = 0 [[ string page = "Boundary", string help = "Plug in the boundaryEdgeDistance5 faceVarying float primvar.", string widget = "null", int interpolated = 1 ]],

    string BoundaryEdgeType = "Triangles" [[ string page = "Boundary", string help = "Specifies the type of edge for the boundary when the distance primvars are not connected", string widget = "mapper", string options = "Triangles|Polygons|Patches" ]],    
    int BoundaryEnableConstantWidth = 1 [[ string page = "Boundary", string help = "Renders the boundary as a constant screen space size", string widget = "checkBox" ]],

    output float Value = 0,
    output float DistanceToClosestEdge = 0,
    output float BoundaryMask = 0
) {
    // First step is to establish the diagonial lines acoss the screen 
    // this could be done either using like a trig then a step function 
    // or using a predefined list of lines we want a notion of a termination 
    // so the tips can be terminated in a fillet

    // This is a bit of hacky way of getting the
    // render resoltuion reguardless of the renderer
    point resolution = transform("NDC", "raster", point(1, 1, 0));

    // One hatch unit is the larger dimension of the image, this is
    // how many pixels that is. Everything that is measured in hatch
    // units looks the same at any resolution or aspect ratio.
    float pixelsPerHatch = max(resolution.x, resolution.y);

    // Rotate the base space by a user controlled number of degrees
    float skewDegrees = radians(Skew);
    float horizontal = cos(skewDegrees);
    float vertical = sin(skewDegrees);

    // The shading point in hatch space. The aspect ratio is already
    // taken care of by normalizing with the larger dimension and
    // measuring from the center of the image.
    vector positionScaled = worldToHatch(Position, resolution);

    // To get a distance between the lines and create a modulo stipe pattern
    // becuase the pattern goes from 0...1, 0...1
    float distanceAcrossLines = (horizontal * positionScaled.x) + (vertical * positionScaled.y);
    float valueAcross = mod(distanceAcrossLines, LineSpacing) / LineSpacing;

    // Mirror the pattern so it goes from 0...1 and then back to 0...1 
    // using a simple conditional to flip the value when it exceeds 0.5
    float valueAcrossMirrored = 1.0 - abs(2.0 * valueAcross - 1.0);

    // The mirrored value is 0 on the center of a line and 1 halfway
    // between two lines, so half of it times the spacing is the actual
    // distance from the center of the nearest line.
    float distanceToLine = 0.5 * valueAcrossMirrored * LineSpacing;

    // The line width lives in the same space as the spacing, which makes
    // it independent of the spacing, the resolution and the aspect ratio.
    // It can't be wider than the spacing or neighboring lines would run
    // into each other.
    float lineHalfWidth = min(0.5 * LineWidth, 0.5 * LineSpacing);

    // A squiggled line has to stay inside its own hatch, otherwise it
    // would run into its neighbors and we would have to check them too.
    // So the squiggle is a fraction of the room that is left between
    // the lines once the widest part of the line is taken out.
    float widestHalfWidth = lineHalfWidth * (1.0 + PressureAmount);
    float squiggleRoom = max(0.5 * LineSpacing - widestHalfWidth, 0.0);
    float squiggleMax = clamp(SquiggleAmount, 0.0, 1.0) * squiggleRoom;

    if (BoundaryWidth <= 0 and TerminationTaperWidth == 0 and PressureAmount == 0 and SquiggleAmount == 0) {
        Value = (distanceToLine < lineHalfWidth) ? 1.0 : 0.0;
        return;
    }

    // Project the derivatives of P to the viewing plane defined
    // by I so we have a measure of how big is a pixel at this point
    float pixelWidthX = length(Dx(P) - dot(Dx(P), I) * I);
    float pixelWidthY = length(Dy(P) - dot(Dy(P), I) * I);
    // Take the average of both axis' length
    float worldPerPixel = (pixelWidthX + pixelWidthY) / 2;

    // How many world units are in one hatch unit at this point and
    // the other way around. The pixel size shrinks as the resolution
    // goes up and the pixels per hatch grows by the same amount so
    // this doesn't depend on the resolution.
    float worldPerHatch = max(worldPerPixel * pixelsPerHatch, 1e-9);
    float hatchPerWorld = 1.0 / worldPerHatch;

    // Use half the width as the neighbor face will render the
    // other half. The boundary is measured both in hatch space, to
    // shorten the lines, and in world space, to find the edges.
    float boundaryHalfHatch = 0.5 * BoundaryWidth;
    float boundaryHalfWorld = 0;

    if (BoundaryEnableConstantWidth) {
        // The width is already in screen space, so the width in
        // world units just follows how big a hatch unit is here.
        boundaryHalfWorld = boundaryHalfHatch * worldPerHatch;
    } else {
        // The width is fixed in world space, so it doesn't care where
        // the camera is. It gets smaller on screen as the surface moves
        // away and bigger as it comes closer. Here the width is in world
        // units, and the hatch width is whatever that looks like at
        // this point so the line ends still stop at the boundary.
        boundaryHalfWorld = 0.5 * BoundaryWidth;
        boundaryHalfHatch = boundaryHalfWorld * hatchPerWorld;
    }

    // The boundary edges of the face. Each one is kept in hatch space,
    // to cut the lines, and as a distance in world units from the
    // shading point, to draw the boundary.
    point edgeA[64];
    point edgeB[64];
    float edgeDistance[64];
    int edgeCount = 0;

    int usePrimvar = isconnected(BoundaryEdgeDistance0)
                  || isconnected(BoundaryEdgeDistance1)
                  || isconnected(BoundaryEdgeDistance2)
                  || isconnected(BoundaryEdgeDistance3)
                  || isconnected(BoundaryEdgeDistance4)
                  || isconnected(BoundaryEdgeDistance5);

    if (usePrimvar) {
        // Every corner of the triangle stores, for each of its three edges,
        // the distance to that edge, or 0 if the edge is not a boundary.
        // The distance is linear across the triangle and zero on the edge,
        // so with the derivatives we can recover the edge from the value at
        // the shading point. Its scale doesn't matter, because it is divided
        // by its own gradient below.
        //
        // Walking one pixel to the right or down we get the gradient of
        // the distance along the surface. This gradient points straight away
        // from the edge and has a length of how fast the distance grows.
        // Dividing the distance by that gives how far away the edge is in
        // world units.
        vector dPdx = Dx(P);
        vector dPdy = Dy(P);

        // To go from the shading point to the vertex
        // we need to solve for the x and y components, a
        // which is a 2x2 least squares problem since
        // the face is flat.
        float aa = dot(dPdx, dPdx);
        float ab = dot(dPdx, dPdy);
        float bb = dot(dPdy, dPdy);
        float determinant = aa * bb - ab * ab;

        // Avoid cases where the derivatives are zero and not parallel
        if (aa * bb > 1e-30 and determinant > 1e-6 * aa * bb) {
            vector planeNormal = normalize(cross(dPdx, dPdy));

            // Two points on the edge are enough to place it in hatch
            // space exactly, even with perspective. This is how far
            // apart they are, which is a tenth of the image.
            float edgeSpan = 0.1 * worldPerHatch;

            float fields[6] = {
                BoundaryEdgeDistance0, BoundaryEdgeDistance1, BoundaryEdgeDistance2,
                BoundaryEdgeDistance3, BoundaryEdgeDistance4, BoundaryEdgeDistance5
            };

            for (int k = 0; k < 6; k++) {
                float field = fields[k];
                float fieldDx = Dx(field);
                float fieldDy = Dy(field);

                // An edge that is not a boundary is 0 everywhere. It doesn't
                // change at all so there is no edge to find.
                if (fieldDx == 0.0 and fieldDy == 0.0) {
                    continue;
                }

                // The gradient of the distance along the surface
                float stepX = (bb * fieldDx - ab * fieldDy) / determinant;
                float stepY = (aa * fieldDy - ab * fieldDx) / determinant;
                vector gradient = stepX * dPdx + stepY * dPdy;
                float gradientLength = length(gradient);

                if (gradientLength > 1e-9) {
                    vector inwardWorld = gradient / gradientLength;
                    float worldDistance = field / gradientLength;

                    // Incident edges are lines, so the face can lie on the far side
                    // of one (near a slightly reflex vertex). That side is covered
                    // by the neighbouring edge, and a negative distance would
                    // otherwise count as inside the boundary.
                    if (worldDistance < 0.0) {
                        continue;
                    }

                    // The closest point on the edge, and the direction
                    // the edge runs in along the surface
                    point onEdge = P - worldDistance * inwardWorld;
                    vector alongEdge = cross(planeNormal, inwardWorld);

                    edgeA[edgeCount] = worldToHatch(onEdge, resolution);
                    edgeB[edgeCount] = worldToHatch(onEdge + alongEdge * edgeSpan, resolution);
                    edgeDistance[edgeCount] = worldDistance;
                    edgeCount += 1;
                }
            }
        }
    } else {
        // This basically ripped from the wireframe shader 
        // For every point of the hit shader we loop through 
        // the vertices to compute a distance to the current 
        // shading point. Right now this is a fallback for 
        // the case where no boundardy primvar is given.
        int np = 0;
        point p[64];
        if (BoundaryEdgeType == "Triangles") { 
            np = 3;
            // TODO add the primvar reading which doesn't work in cycles right now 
            if (!getattribute("geom:trianglevertices", p)) {
                exit();
            }
        } else if (BoundaryEdgeType == "Polygons" || BoundaryEdgeType == "Patches") { 
            getattribute("geom:numpolyvertices", np);
            if (np < 3 || !getattribute("geom:polyvertices", p)) {
                exit();
            }
        }

        for (int i = 0; i < np; i++) {
            int i2 = i ? i - 1 : np - 1;
            vector dir = P - p[i];
            vector edge = p[i] - p[i2];
            vector crs = cross(edge, dir);

            // dot(crs, crs) / dot(edge, edge) is the square of
            // area / length(edge) == square of the distance
            // to the edge.
            edgeA[edgeCount] = worldToHatch(p[i2], resolution);
            edgeB[edgeCount] = worldToHatch(p[i], resolution);
            edgeDistance[edgeCount] = sqrt(dot(crs, crs) / max(dot(edge, edge), 1e-18));
            edgeCount += 1;
        }
    }

    // Shows how far the closest boundary edge is, in hatch units
    float closestEdge = 1e30;
    for (int k = 0; k < edgeCount; k++) {
        closestEdge = min(closestEdge, edgeDistance[k]);
    }

    DistanceToClosestEdge = (edgeCount > 0) ? closestEdge * hatchPerWorld : 0.0;

    for (int k = 0; k < edgeCount; k++) {
        if (edgeDistance[k] < boundaryHalfWorld) {
            BoundaryMask = 1;
            distanceToLine = lineHalfWidth;
            break;
        }
    }

    // This is the straight line, which is the final answer when
    // nothing is shaping the line
    Value = (distanceToLine < lineHalfWidth) ? 1.0 : 0.0;

    // Early exit for when butt termination is enabled
    if (TerminationType == "Butt" and SquiggleAmount == 0 and PressureAmount == 0) {
        return;
    }

    // There are no lines inside the boundary
    if (BoundaryMask > 0.0) {
        return;
    }

    // Squiggle and pressure move the edges of the line out of the straight
    // line, so we can't reject points just because they are outside of it.
    // But the line can't get further from its center than its widest part
    // plus the squiggle, so anything past that is definitely not on a line.
    if (distanceToLine >= widestHalfWidth + squiggleMax) {
        return;
    }

    // We need to know which "hatch" is the current hatch
    // and then derive the upper and lower bounds
    // Lines are on the boundaries of the hatches
    float baseSpace = distanceAcrossLines / LineSpacing;

    // these are the offsets in the hatch line equation
    // horizontal * x + vertical * y = lineOffset
    // The current point belongs to whichever bound is closer
    // so we split the hatch in the middle to pick one.
    float upperBound = ceil(baseSpace);
    float lowerBound = floor(baseSpace);
    float middleBound = (upperBound + lowerBound) / 2;
    float lineIndex = (baseSpace < middleBound) ? lowerBound : upperBound;
    float lineOffset = lineIndex * LineSpacing;

    // The line has to stop where the boundary starts, so the end of
    // the line sits half the boundary width away from every edge.
    // How much extra room the end of the line needs on top of that
    // depends on its shape and on the squiggle, which is worked out
    // for each edge.
    float inset = boundaryHalfHatch;
    int squareEnd = (TerminationType == "Square");
    int buttEnd = (TerminationType == "Butt");

    // Walk the edges of the boundary and tighten the range along the
    // hatch line that survives. sMin and sMax (like as in s and t)
    // are the positions of the two ends of the line measured along 
    // the line direction. For a round termination these are the 
    // cap centers, for a square termination these are the flat tips.
    // A butt termination has no ends to find, the line just runs
    // out at the boundary. The same goes for a side that has no
    // boundary edge, the line carries on into the next face.
    float sMin = -1e6;
    float sMax = 1e6;

    for (int k = 0; k < edgeCount; k++) {
        if (buttEnd) {
            break;
        }

        float bound;
        int clipped = clipHatchEdge(
            edgeA[k],
            edgeB[k],
            positionScaled,
            horizontal,
            vertical,
            lineOffset,
            inset,
            lineHalfWidth,
            squiggleMax,
            squareEnd,
            bound
        );

        if (clipped < 0) {
            // This edge removed the whole line
            Value = 0.0;
            return;
        } else if (clipped == 1) {
            sMin = max(sMin, bound);
        } else if (clipped == 2) {
            sMax = min(sMax, bound);
        }
    }

    // The line is too short to fit between the boundaries
    if (sMin > sMax) {
        Value = 0.0;
        return;
    }

    // Where the current point is along the line, and how far past
    // the ends it is. Between the ends it is only the distance across
    // the line, past them it is the distance to the closest end.
    float along = -vertical * positionScaled.x + horizontal * positionScaled.y;
    float beyond = max(max(sMin - along, along - sMax), 0.0);

    // How far along the line this point is, measured from where the line
    // starts. This is in hatch units so it is scale invariant with
    // respect to the screen. Without a start in this face, or when the
    // line carries on into other faces, there is nothing to measure from
    // so it is measured from the center of the image instead. That keeps
    // the noise continuous from one face to the next.
    int hasStart = (sMin > -1e5) and !usePrimvar;
    float distanceAlong = hasStart ? along - sMin : along;

    // The squiggle moves the whole line sideways, perpendicular to the
    // direction it is drawn in, by an amount that changes smoothly
    // with the distance along the line. Every line gets its own noise
    // by using the index of the line as the second coordinate.
    float squiggle = 0.0;
    if (SquiggleAmount != 0) {
        squiggle = squiggleMax * noise("simplex", SquiggleScale * distanceAlong, lineIndex);
    }

    // The distance across the line, measured from where the line
    // has been moved to.
    float across = abs(distanceAcrossLines - lineOffset - squiggle);

    float maxWidth = lineHalfWidth;

    if (PressureAmount != 0) {
        // Different pressure pattern for different positions across the screen.
        point pressureNoiseCoordinate = {
            PressureFrequency * distanceAlong,
            PressureFrequency * distanceAcrossLines,
            lineIndex
        };

        float pressure = noise(
            "simplex", pressureNoiseCoordinate
        );

        maxWidth += maxWidth * PressureAmount * pressure;
    }

    if (TerminationTaperWidth != 0) {
        float lineLength = max(sMax - sMin, 1e-9);
        float distanceFromEnd = min(along - sMin, sMax - along);

        // Normalize the distance from either line end.
        // TerminationTaperWidth is a physical distance, so the taper length
        // is independent of the total line length.
        float uValueMirror = clamp(distanceFromEnd / TerminationTaperWidth, 0.0, 1.0);

        float taperKnots[4] = {
            0,                     // value at u=0
            TerminationTaperSlope, // tangent at u=0
            1,                     // value at u=1
            0                      // tangent at u=1
        };

        float taper = spline("hermite", uValueMirror, taperKnots);
        maxWidth *= taper;
    } 

    if (TerminationType == "Round") {
        // Distance to the closest cap center, which is what
        // makes the half circle.
        float dist = sqrt(beyond * beyond + across * across);
        Value = dist < maxWidth ? 1.0 : 0.0;
        return;
    }

    if (TerminationType == "Square") {
        int withinSquare =
            (along >= sMin) &&
            (along <= sMax) &&
            (across <= maxWidth);

        Value = withinSquare ? 1.0 : 0.0;
        return;
    }

    if (TerminationType == "Butt") {
        // Nothing ends the line, it just runs into the boundary
        Value = (across < maxWidth) ? 1.0 : 0.0;
        return;
    }
}
