// AutolibWeave

struct WeaveParams {
    float scale;
    float width;
    float roundness;
    float roundnessBump;
    float roundShadow;
    float weaveBump;
    float weaveShadow;
    float frizz;
    float frizzBump;
    float frizzScale;
    float bendyness;
    float bendynessScale;
    float opacityFade;
};

struct WeaveData {
    int onU;
    int onV;
    float uu;
    float vv;
    float frizz;
    float ubend;
    float vbend;
    int uf;
    int vf;
    int oddU;
    int oddV;
    float ubulge;
    float vbulge;
};


WeaveData computeWeaveData(
    vector uvw,
    WeaveParams params
) {
    WeaveData data;

    float frizz = noise("perlin", uvw / params.frizzScale);
    float w2 = params.width + frizz * params.frizz;
    float w = w2 * 0.5;

    int uf = int(floor(uvw[0]));
    int vf = int(floor(uvw[1]));

    float ubend = noise("perlin", uvw[1] / params.bendynessScale + uf) * params.bendyness;
    float vbend = noise("perlin", uvw[0] / params.bendynessScale + vf) * params.bendyness;

    float sx = uvw[0] - uf + ubend;
    float sy = uvw[1] - vf + vbend;

    int onU = (sy > 0.5 - w && sy < 0.5 + w);
    int onV = (sx > 0.5 - w && sx < 0.5 + w);

    float uu = (sy - (0.5 - w)) / w2;
    float vv = (sx - (0.5 - w)) / w2;

    int oddU = uf % 2;
    int oddV = vf % 2;

    data.onU = onU;
    data.onV = onV;
    data.uu = uu;
    data.vv = vv;
    data.frizz = frizz;
    data.ubend = ubend;
    data.vbend = vbend;
    data.uf = uf;
    data.vf = vf;
    data.oddU = oddU;
    data.oddV = oddV;

    data.ubulge = sin(uu * M_PI);
    data.vbulge = sin(vv * M_PI);

    return data;
}


shader AutolibWeaves [[ 
    string category = "autolib"
]] (
    point UV = point(u,v,0),

    float scale = 0.2 [[ string help = "Pattern scale", float min = 0.001, float max = 10 ]],

    color uColor = 0.2 [[ string help = "Color of U thread" ]],
    color vColor = 0.5 [[ string help = "Color of V thread" ]],

    float width = 0.5 [[ string help = "Thread width", float min = 0.0, float max = 1.0 ]],
    float roundness = 1.0 [[ string help = "Thread roundness", float min = 0.0, float max = 1.0 ]],

    float roundnessBump = 1.0 [[ string help = "Roundness outBumpiness strength", float min = 0.0, float max = 2.0 ]],
    float roundShadow = 0.5 [[ string help = "Round shading strength", float min = 0.0, float max = 1.0 ]],

    float weaveBump = 0.5 [[ string help = "Weave outBumpiness intensity", float min = 0.0, float max = 2.0 ]],
    float weaveShadow = 0.4 [[ string help = "Weave shadow strength", float min = 0.0, float max = 1.0 ]],

    float frizz = 0.0 [[ string help = "Fiber frizz amount", float min = 0.0, float max = 1.0 ]],
    float frizzBump = 0.0 [[ string help = "Frizz outBumpiness intensity", float min = 0.0, float max = 2.0 ]],
    float frizzScale = 0.1 [[ string help = "Frizz noise scale", float min = 0.0, float max = 10.0 ]],

    float bendyness = 0.2 [[ string help = "Thread bending randomness", float min = 0.0, float max = 1.0 ]],
    float bendynessScale = 3.0 [[ string help = "Bending noise scale", float min = 0.0, float max = 10.0 ]],

    float opacityFade = 0.0 [[ string help = "Thread edge opacity fade", float min = 0.0, float max = 1.0 ]],

    output color outColor = 0,
    output float outBump = 0,
    output float threadId = 0,
    output float opacity = 0,
    output vector outAnisotropicDirection = 0,
    output float outAnisotropyAmount = 0
) {
    vector uvw = UV / scale;

    WeaveParams params;

    params.scale = scale;
    params.width = width;
    params.roundness = roundness;
    params.roundnessBump = roundnessBump;
    params.roundShadow = roundShadow;
    params.weaveBump = weaveBump;
    params.weaveShadow = weaveShadow;
    params.frizz = frizz;
    params.frizzBump = frizzBump;
    params.frizzScale = frizzScale;
    params.bendyness = bendyness;
    params.bendynessScale = bendynessScale;
    params.opacityFade = opacityFade;

    WeaveData data = computeWeaveData(uvw, params);

    int onU = data.onU;
    int onV = data.onV;

    if (onU == 0 && onV == 0)
        return;

    int uOnTop = (data.oddU ^ data.oddV) == 0;

    if (onU && onV) {
        onU = uOnTop;
        onV = onU == 0;
    }

    threadId = 1 + float((cellnoise(data.uf) * onV + cellnoise(data.vf) * onU) * 1024.0) + onU;

    if (onU) {
        outColor = uColor;
    } else {
        outColor = vColor;
    }

    float weave;
    if (onU) {
        weave = sin((uvw[0] + data.oddV) * M_PI);
    } else {
        weave = sin((uvw[1] + data.oddU + 1.0) * M_PI);
    }

    float bulge;
    if (onU) {
        bulge = pow(data.ubulge, params.roundness);
    } else {
        bulge = pow(data.vbulge, params.roundness);
    }

    // When opacityFade is 0, thread is fully opaque with hard edges.
    // When > 0, edges fade out based on the bulge profile.
    // We use the active thread's bulge only, so the inactive axis doesn't bleed in.
    float rawBulge = onU ? data.ubulge : data.vbulge;
    opacity = (params.opacityFade > 0.0)
        ? pow(max(0.0, rawBulge), params.opacityFade)
        : 1.0;

    outBump = 0.2 + (weave * params.weaveBump) + (bulge * params.roundnessBump) + (data.frizz * params.frizzBump);

    outColor *= mix(1.0, bulge, params.roundShadow);
    outColor *= mix(1.0, weave, params.weaveShadow);

    // Anisotropic direction along the thread's running axis,
    // incorporating bend so the direction follows the actual fiber curve.
    // U-threads run along X
    // V-threads run along Y
    float bend;
    if (onU) {
        outAnisotropicDirection = normalize(vector(1.0, data.ubend, 0.0));
        bend = abs(data.ubend);
    } else {
        outAnisotropicDirection = normalize(vector(data.vbend, 1.0, 0.0));
        bend = abs(data.vbend);
    }

    // Anisotropy is strongest at thread center (high bulge), reduced by frizz and bending
    outAnisotropyAmount = bulge * max(0.0, 1.0 - data.frizz - bend);
}