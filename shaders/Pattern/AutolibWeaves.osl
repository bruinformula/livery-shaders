// AutolibWeave

struct WeaveParams {
    float scale;
    float width;
    float roundness;
    float roundnessBump;
    float roundShadow;
    float weaveBump;
    float weaveShadow;
    float frizz;
    float frizzBump;
    float frizzScale;
    float bendyness;
    float bendynessScale;
    float opacityFade;
};

struct WeaveData {
    int onU;
    int onV;
    float uu;
    float vv;
    float frizz;
    float ubend;
    float vbend;
    int uf;
    int vf;
    int oddU;
    int oddV;
    float ubulge;
    float vbulge;
};


WeaveData computeWeaveData(
    vector uvw,
    WeaveParams params
) {
    WeaveData data;

    float frizz = noise("perlin", uvw / params.frizzScale);
    float w2 = params.width + frizz * params.frizz;
    float w = w2 * 0.5;

    int uf = int(floor(uvw[0]));
    int vf = int(floor(uvw[1]));

    float ubend = noise("perlin", uvw[1] / params.bendynessScale + uf) * params.bendyness;
    float vbend = noise("perlin", uvw[0] / params.bendynessScale + vf) * params.bendyness;

    float sx = uvw[0] - uf + ubend;
    float sy = uvw[1] - vf + vbend;

    int onU = (sy > 0.5 - w && sy < 0.5 + w);
    int onV = (sx > 0.5 - w && sx < 0.5 + w);

    float uu = (sy - (0.5 - w)) / w2;
    float vv = (sx - (0.5 - w)) / w2;

    int oddU = uf % 2;
    int oddV = vf % 2;

    data.onU = onU;
    data.onV = onV;
    data.uu = uu;
    data.vv = vv;
    data.frizz = frizz;
    data.ubend = ubend;
    data.vbend = vbend;
    data.uf = uf;
    data.vf = vf;
    data.oddU = oddU;
    data.oddV = oddV;

    data.ubulge = sin(uu * M_PI);
    data.vbulge = sin(vv * M_PI);

    return data;
}


// The mesh UVs. Arnold's u,v on a mesh are its UVs; RenderMan's are per-face parametric coordinates,
// so read the st primvar when the renderer exposes it (the default of the UV input).
point meshUV() {
    float st[2];
    if (getattribute("primvar", "st", st))
        return point(st[0], st[1], 0);
    return point(u, v, 0);
}

shader AutolibWeaves [[
    string label = "Weaves",
    string help = "Procedural woven fabric: two thread colors with rounded, frizzy, bending threads, plus bump, "
                  "opacity and anisotropy outputs for cloth and sheen.",
    string rfh_classification = "RenderMan/Autolib/Pattern",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/pattern"
]] (
    point UV = meshUV() [[
        string label = "UV",
        string help = "Texture coordinates. Defaults to the mesh UVs (st); connect a Manifold to transform or replace them."
    ]],
    float Scale = 0.2 [[
        string label = "Scale",
        string help = "Size of one weave repeat in UV units.",
        float min = 0.001, float max = 10, float slidermax = 1,
        string page = "Weave",
        int page_open = 1
    ]],
    color UColor = 0.2 [[
        string label = "U Thread Color",
        string help = "Color of the threads running along U.",
        string page = "Weave"
    ]],
    color VColor = 0.5 [[
        string label = "V Thread Color",
        string help = "Color of the threads running along V.",
        string page = "Weave"
    ]],
    float Width = 0.5 [[
        string label = "Thread Width",
        string help = "Width of each thread as a fraction of the repeat; gaps between threads become transparent.",
        float min = 0.0, float max = 1.0, int slider = 1,
        string page = "Weave"
    ]],

    float Roundness = 1.0 [[
        string label = "Roundness",
        string help = "How round the thread cross-section is (0 flat, 1 round).",
        float min = 0.0, float max = 1.0, int slider = 1,
        string page = "Shape",
        int page_open = 1
    ]],
    float RoundnessBump = 1.0 [[
        string label = "Roundness Bump",
        string help = "Bump contributed by the round cross-section.",
        float min = 0.0, float max = 2.0, int slider = 1,
        string page = "Shape"
    ]],
    float RoundShadow = 0.5 [[
        string label = "Roundness Shadow",
        string help = "Darkens thread edges to fake self shadowing across the cross-section.",
        float min = 0.0, float max = 1.0, int slider = 1,
        string page = "Shape"
    ]],
    float WeaveBump = 0.5 [[
        string label = "Weave Bump",
        string help = "Bump from threads passing over and under each other.",
        float min = 0.0, float max = 2.0, int slider = 1,
        string page = "Shape"
    ]],
    float WeaveShadow = 0.4 [[
        string label = "Weave Shadow",
        string help = "Darkens threads where they pass under their neighbours.",
        float min = 0.0, float max = 1.0, int slider = 1,
        string page = "Shape"
    ]],

    float Frizz = 0.0 [[
        string label = "Frizz",
        string help = "Amount of loose fibers breaking up the thread edges.",
        float min = 0.0, float max = 1.0, int slider = 1,
        string page = "Frizz and Bend"
    ]],
    float FrizzBump = 0.0 [[
        string label = "Frizz Bump",
        string help = "Bump from the frizz fibers.",
        float min = 0.0, float max = 2.0, int slider = 1,
        string page = "Frizz and Bend"
    ]],
    float FrizzScale = 0.1 [[
        string label = "Frizz Scale",
        string help = "Size of the frizz noise relative to the repeat.",
        float min = 0.0, float max = 10.0, float slidermax = 1,
        string page = "Frizz and Bend"
    ]],
    float Bendyness = 0.2 [[
        string label = "Bendiness",
        string help = "Random waviness of the threads.",
        float min = 0.0, float max = 1.0, int slider = 1,
        string page = "Frizz and Bend"
    ]],
    float BendynessScale = 3.0 [[
        string label = "Bendiness Scale",
        string help = "Frequency of the waviness noise.",
        float min = 0.0, float max = 10.0, int slider = 1,
        string page = "Frizz and Bend"
    ]],
    float OpacityFade = 0.0 [[
        string label = "Opacity Fade",
        string help = "Softens the Opacity output toward the thread edges.",
        float min = 0.0, float max = 1.0, int slider = 1,
        string page = "Frizz and Bend"
    ]],

    output color Color = 0 [[ string label = "Color" ]],
    output float Bump = 0 [[ string label = "Bump", string help = "Height for a bump node." ]],
    output float ThreadId = 0 [[ string label = "Thread ID", string help = "0 on U threads, 1 on V threads." ]],
    output float Opacity = 0 [[ string label = "Opacity", string help = "1 on threads, 0 in the gaps." ]],
    output vector AnisotropicDirection = 0 [[ string label = "Anisotropy Direction", string help = "Thread direction, for anisotropic specular." ]],
    output float AnisotropyAmount = 0 [[ string label = "Anisotropy Amount" ]]
) {
    vector uvw = UV / Scale;

    WeaveParams params;

    params.scale = Scale;
    params.width = Width;
    params.roundness = Roundness;
    params.roundnessBump = RoundnessBump;
    params.roundShadow = RoundShadow;
    params.weaveBump = WeaveBump;
    params.weaveShadow = WeaveShadow;
    params.frizz = Frizz;
    params.frizzBump = FrizzBump;
    params.frizzScale = FrizzScale;
    params.bendyness = Bendyness;
    params.bendynessScale = BendynessScale;
    params.opacityFade = OpacityFade;

    WeaveData data = computeWeaveData(uvw, params);

    int onU = data.onU;
    int onV = data.onV;

    if (onU == 0 && onV == 0)
        return;

    int uOnTop = (data.oddU ^ data.oddV) == 0;

    if (onU && onV) {
        onU = uOnTop;
        onV = onU == 0;
    }

    ThreadId = 1 + float((cellnoise(data.uf) * onV + cellnoise(data.vf) * onU) * 1024.0) + onU;

    if (onU) {
        Color = UColor;
    } else {
        Color = VColor;
    }

    float weave;
    if (onU) {
        weave = sin((uvw[0] + data.oddV) * M_PI);
    } else {
        weave = sin((uvw[1] + data.oddU + 1.0) * M_PI);
    }

    float bulge;
    if (onU) {
        bulge = pow(data.ubulge, params.roundness);
    } else {
        bulge = pow(data.vbulge, params.roundness);
    }

    // When opacityFade is 0, thread is fully opaque with hard edges.
    // When > 0, edges fade out based on the bulge profile.
    // We use the active thread's bulge only, so the inactive axis doesn't bleed in.
    float rawBulge = onU ? data.ubulge : data.vbulge;
    Opacity = (params.opacityFade > 0.0)
        ? pow(max(0.0, rawBulge), params.opacityFade)
        : 1.0;

    Bump = 0.2 + (weave * params.weaveBump) + (bulge * params.roundnessBump) + (data.frizz * params.frizzBump);

    Color *= mix(1.0, bulge, params.roundShadow);
    Color *= mix(1.0, weave, params.weaveShadow);

    // Anisotropic direction along the thread's running axis,
    // incorporating bend so the direction follows the actual fiber curve.
    // U-threads run along X
    // V-threads run along Y
    float bend;
    if (onU) {
        AnisotropicDirection = normalize(vector(1.0, data.ubend, 0.0));
        bend = abs(data.ubend);
    } else {
        AnisotropicDirection = normalize(vector(data.vbend, 1.0, 0.0));
        bend = abs(data.vbend);
    }

    // Anisotropy is strongest at thread center (high bulge), reduced by frizz and bending
    AnisotropyAmount = bulge * max(0.0, 1.0 - data.frizz - bend);
}