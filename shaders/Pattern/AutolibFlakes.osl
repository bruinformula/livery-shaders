// AutolibFlakes
vector ID(vector x, int flakeSeed) {
    vector n = floor(x);
    vector f = x - floor(x);
    vector m = vector(8);
    for (int k = -1; k <= 1; k++) {
        for (int j = -1; j <= 1; j++) {
            for (int i = -1; i <= 1; i++) {
                vector g = vector(float(i), float(j), float(k));
                vector o = noise("hash", n + g, flakeSeed);
                vector r = g - f + (0.5 + (0.5 * sin(M_2PI * o)));
                float s = dot(r, r);
                s < m.x ? m = vector(s, o.x, o.y) : 0;
            }
        }
    }
    return vector(sqrt(m.x), m.y + m.z, m.y + m.x);
}

float IDs(output float x, int flakeSeed) {
    x = -1000 + x * 2000;
    x = int(trunc(x));
    float xRatio = noise("cell", vector(abs(x), abs(flakeSeed), 11));
    return mix(0, 1, xRatio);
}

normal combineNormals(normal base, normal detail) {
    normal BaseNormal   = normalize(base);
    normal detailNormal = normalize(detail);
    vector baseAdjusted   = vector(BaseNormal.x,   BaseNormal.y,   BaseNormal.z + 1.0);
    vector detailAdjusted = vector(-detailNormal.x, -detailNormal.y, detailNormal.z);
    float  projection = dot(baseAdjusted, detailAdjusted);
    vector combined   = baseAdjusted * projection - detailAdjusted * baseAdjusted.z;
    return normalize(combined);
}

shader AutolibFlakes [[
    string label = "Flakes",
    string help = "Metallic paint flakes: random cellular flakes, each with its own tilted normal, for a sparkle "
                  "lobe or a flake layer.",
    string rfh_classification = "RenderMan/Autolib/Pattern",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/pattern"
]] (
    point Position = P [[
        string label = "Position",
        string help = "Where the flake cells are evaluated. Defaults to the shading position; connect object space "
                      "position so flakes stick to moving objects."
    ]],
    normal BaseNormal = N [[
        string label = "Base Normal",
        string help = "Normal the flake normals are tilted from. Connect a bumped normal to keep the bump."
    ]],
    float Scale = 0.1 [[
        string label = "Scale",
        string help = "Flake cells per scene unit (higher is smaller flakes).",
        float min = 0, float slidermax = 5000
    ]],
    float Density = 0.1 [[
        string label = "Density",
        string help = "Fraction of cells that hold a flake (1 = every cell).",
        float min = 0.0, float max = 1.0, int slider = 1
    ]],
    float NormalStrength = 1.0 [[
        string label = "Normal Strength",
        string help = "How far the flake normals tilt away from Base Normal (0 none, 1 fully random).",
        float min = 0.0, float max = 1.0, int slider = 1
    ]],
    int Seed = 0 [[
        string label = "Seed",
        string help = "Random seed for the flake pattern."
    ]],

    output float Alpha = 1 [[ string label = "Alpha", string help = "1 on a flake, 0 between flakes." ]],
    output float Mask = 0 [[ string label = "Mask" ]],
    output normal Normal = N [[ string label = "Normal", string help = "Flake normal, or Base Normal between flakes." ]],
    output float Rehash = 0 [[ string label = "Random", string help = "Random value per flake, 0-1." ]]
) {
    point scaledPosition = Scale * Position;
    vector k = ID(scaledPosition, Seed);
    float angle = k.y * M_2PI;

    float x = 0.5 + 0.5 * cos(angle);
    float y = 0.5 + 0.5 * sin(angle);
    float z = 0.5 + 0.5 * cos(angle * 0.5);

    Normal = normalize(vector(x, y, z) * 2.0 - 1.0);
    Normal = Normal * 0.5 + 0.5;

    int Seeds[3] = {4, 4, 1};
    for (int i = 0; i < 3; i++) {
        Normal[i] = IDs(Normal[i], Seeds[i]);
    }
    Normal.z = 0.5 + 0.5 * Normal.z;

    float h = -1000.0 + Normal.x * 2000.0;
    h = int(trunc(h));
    Rehash = noise("cell", vector(abs(h), 16, 11));

    normal flakeDetail = normalize((normal)(vector(Normal) * 2.0 - 1.0));

    normal combinedNormal = combineNormals(BaseNormal, flakeDetail);

    Normal = (normal)normalize(mix(vector(BaseNormal), vector(combinedNormal), clamp(NormalStrength, 0.0, 1.0)));

    int isFlake = Density > Rehash;
    
    if (!isFlake) {
        Normal = BaseNormal;
    }
    Alpha = float(isFlake);
    Mask = Alpha > 0;
}