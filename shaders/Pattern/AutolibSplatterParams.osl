// AutolibSplatterParams

shader AutolibSplatterParams [[
    string category = "autolib"
]] (
    // geometry
    int seed = 433 [[ string page = "Pattern" ]],
    float scaleRadius = 0.8 [[ string page = "Pattern" ]],
    float minRadius = 0.005 [[ string page = "Pattern" ]],
    float maxRadius = 0.3 [[ string page = "Pattern" ]],

    // spikes
    float spikeAmount = 0.9 [[ string page = "Spikes", float min = 0.0, float max = 1.0 ]],
    float spikePeak = 8.0 [[ string page = "Spikes", float min = 1.0 ]],

    // basin
    float basinHeight = 0.95 [[ string page = "Basin", float min = 0.0, float max = 1.0 ]],

    // base paint
    float baseRoughness = 0.3 [[ string page = "Base", float min = 0.0, float max = 1.0 ]],
    color baseColor = color(1.0, 0.1, 0.1) [[ string page = "Base" ]],

    // flakes
    float flakeRoughness = 0.1 [[ string page = "Flakes", float min = 0.0, float max = 1.0 ]],
    color flakeReflectivity = color(0.95, 0.95, 0.95) [[ string page = "Flakes" ]],
    color flakeEdgeTint = color(1.0, 1.0, 1.0) [[ string page = "Flakes" ]],

    // jittered outputs
    output int outSeed = 0,
    output float outScaleRadius = 0.0,
    output float outMinRadius = 0.0,
    output float outMaxRadius = 0.0,
    output float outSpikeAmount = 0.0,
    output float outSpikePeak = 0.0,
    output float outBasinHeight = 0.0,
    output float outBaseRoughness = 0.0,
    output color outBaseColor = 0,
    output float outFlakeRoughness = 0.0,
    output color outFlakeReflectivity = 0,
    output color outFlakeEdgeTint = 0
) {
    outSeed = seed;
    outScaleRadius = scaleRadius;
    outMinRadius = minRadius;
    outMaxRadius = maxRadius;
    outSpikeAmount = spikeAmount;
    outSpikePeak = spikePeak;
    outBasinHeight = basinHeight;
    outBaseRoughness = baseRoughness;
    outBaseColor = baseColor;
    outFlakeRoughness = flakeRoughness;
    outFlakeReflectivity = flakeReflectivity;
    outFlakeEdgeTint = flakeEdgeTint;   
}