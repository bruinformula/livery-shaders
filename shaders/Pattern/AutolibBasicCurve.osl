float fractalNoise( 
    float x,
    float scale,
    int octaves,
    float lacunarity,
    float gain
) {
    float sum = 0.0;
    float amplitude = 1.0;
    float maxAmplitude = 0.0;
    float frequency = scale;
    for (int i = 0; i < octaves; i++) {
        sum += noise("uperlin", x * frequency) * amplitude;
        maxAmplitude += amplitude;
        amplitude *= gain;
        frequency *= lacunarity;
    }
    return (sum / maxAmplitude);
}

float calculateTrim(
    float x,
    float trimStart,
    float trimEnd,
    float trimLowerBound,
    float trimTransitionWidth,
    float trimExponent
) {
    float bias(float val, float b) {
        float valClamped = clamp(val, 0.0, 1.0); 
        return pow(valClamped, log(b) / log(0.5));
    }

    if (trimStart == trimEnd) {
        return 1.0; 
    }

    // Clamp X to prevent popping outside the trim zones
    float clampedX = clamp(x, min(trimStart, trimEnd), max(trimStart, trimEnd));
    
    // Normalize clampedX to a 0.0 -> 1.0 range based on start/end points
    float scaledTrimInput = (clampedX - trimStart) / (trimEnd - trimStart);

    float biased = (1 - trimLowerBound) * bias(scaledTrimInput, trimExponent) + trimLowerBound;

    if (trimTransitionWidth <= 0) 
        return biased; 

    float transitionWeight;
    if (trimStart < trimEnd) {
        transitionWeight = 1.0 - smoothstep(trimEnd - trimTransitionWidth, trimEnd, clampedX);
    } else {
        transitionWeight = smoothstep(trimEnd, trimEnd + trimTransitionWidth, clampedX);
    }

    return mix(1.0, biased, transitionWeight);
}
// The mesh UVs. Arnold's u,v on a mesh are its UVs; RenderMan's are per-face parametric coordinates,
// so read the st primvar when the renderer exposes it (the default of the UV input).
point meshUV() {
    float st[2];
    if (getattribute("primvar", "st", st))
        return point(st[0], st[1], 0);
    return point(u, v, 0);
}

shader AutolibBasicCurve [[
    string label = "Basic Curve",
    string help = "A stroke along a curve's (or ribbon's) UV: a noisy band across the width with tapered, trimmed "
                  "ends along the length. U is the length and V the width unless swapped.",
    string rfh_classification = "RenderMan/Autolib/Pattern",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/pattern"
]] (
    point UV = meshUV() [[
        string label = "UV",
        string help = "Curve coordinates: U along the length, V across the width (0-1)."
    ]],
    int SwapUAndV = 0 [[
        string label = "Swap U and V",
        string help = "Use V as the length axis and U as the width.",
        string widget = "checkBox",
        int connectable = 0
    ]],
    int UniformNoiseScale = 1 [[
        string label = "Uniform Noise Scale",
        string help = "Scale the noise by the curve's world space length so long and short curves get the same "
                      "noise size (World Length Factor output).",
        string widget = "checkBox",
        int connectable = 0
    ]],

    float NoiseScale = 1 [[
        string label = "Noise Scale",
        string help = "Frequency of the edge noise along the curve.",
        float min = 0.1, float max = 10, int slider = 1,
        string page = "Noise",
        int page_open = 1
    ]],
    int Octaves = 1 [[
        string label = "Octaves",
        string help = "Number of noise octaves.",
        int min = 1, int max = 8, int slider = 1,
        string page = "Noise"
    ]],
    float Lacunarity = 2.0 [[
        string label = "Lacunarity",
        string help = "Frequency multiplier between octaves.",
        float min = 1, float slidermax = 4,
        string page = "Noise"
    ]],
    float Gain = 0.5 [[
        string label = "Gain",
        string help = "Amplitude multiplier between octaves.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Noise"
    ]],

    float BandWidth = 0.3 [[
        string label = "Band Width",
        string help = "Width of the stroke across V (0-1).",
        float min = 0, float max = 1, int slider = 1,
        string page = "Border",
        int page_open = 1
    ]],
    float BandCenter = 0.5 [[
        string label = "Band Center",
        string help = "Position of the stroke across V.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Border"
    ]],
    float BorderSmoothness = 0 [[
        string label = "Border Smoothness",
        string help = "Softness of the stroke edges (In Region Smooth output).",
        float min = 0, float max = 1, int slider = 1,
        string page = "Border"
    ]],

    float TrimWidth = 0.1 [[
        string label = "Trim Width",
        string help = "Length of the tapered zone at each end of the curve, as a fraction of its length.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Trim",
        int page_open = 1
    ]],
    float TrimLowerBound = 0.10 [[
        string label = "Trim Lower Bound",
        string help = "Stroke width left at the very tip, as a fraction of the full width.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Trim"
    ]],
    float TrimTransitionWidth = 0.05 [[
        string label = "Trim Transition",
        string help = "Length over which the taper blends into the full width.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Trim"
    ]],
    float TrimExponent = 0.25 [[
        string label = "Trim Bias",
        string help = "Shape of the taper: 0.5 linear, lower values keep the stroke wide until close to the tip.",
        float min = 0, float max = 1, int slider = 1,
        string page = "Trim"
    ]],

    output float WorldLengthFactor = 1 [[ string label = "World Length Factor", string help = "World length of the curve per U unit." ]],
    output float InRegion = 0 [[ string label = "In Region", string help = "1 inside the stroke." ]],
    output float InRegionSmooth = 0 [[ string label = "In Region Smooth", string help = "The stroke with soft borders." ]]
) {
    float coordU = SwapUAndV ? UV.y : UV.x;
    float coordV = SwapUAndV ? UV.x : UV.y;

    // Calculate World Length Factor
    if (UniformNoiseScale) {
        if (!isconnected(UV)) { // Standard geometric derivatives
            float worldPerU = SwapUAndV ? length(dPdv) : length(dPdu);
            if (worldPerU > 1e-6) 
                WorldLengthFactor = worldPerU;
        } else { // Screen-space Jacobian
            vector dPdx = Dx(P);
            vector dPdy = Dy(P);
            vector dUVdx = Dx(UV);
            vector dUVdy = Dy(UV);

            float det = dUVdx.x * dUVdy.y - dUVdx.y * dUVdy.x;
            
            if (abs(det) > 1e-12) {
                vector dP_dLength;
                if (SwapUAndV) {
                    // We want world change relative to V
                    dP_dLength = (-dUVdy.x * dPdx + dUVdx.x * dPdy) / det;
                } else {
                    // We want world change relative to U
                    dP_dLength = (dUVdy.y * dPdx - dUVdx.y * dPdy) / det;
                }
                float len = length(dP_dLength);
                if (len > 1e-6) WorldLengthFactor = len;
            }
        }
    }

    // Object-based Randomness
    string objectName = "";
    getattribute("geom:name", objectName);
    int upperHash = hash(objectName);
    int lowerHash = hash(upperHash);
    float upperRandom = (float)(upperHash & 0x7fffffff) / (float)0x7fffffff;
    float lowerRandom = (float)(lowerHash & 0x7fffffff) / (float)0x7fffffff;

    // Noise 
    float upperNoise = fractalNoise(upperRandom + coordU, NoiseScale * WorldLengthFactor, Octaves, Lacunarity, Gain);
    float lowerNoise = fractalNoise(lowerRandom + coordU, NoiseScale * WorldLengthFactor, Octaves, Lacunarity, Gain);

    float centeredUpperNoise = (upperNoise - 0.5) * 0.2;
    float centeredLowerNoise = (lowerNoise - 0.5) * 0.2;

    float upperEdge, lowerEdge;

    if (TrimWidth != 0) {
        float leftTrim = calculateTrim(coordU, 0.0, TrimWidth, TrimLowerBound, TrimTransitionWidth, TrimExponent);
        float rightTrim = calculateTrim(coordU, 1.0, 1.0 - TrimWidth, TrimLowerBound, TrimTransitionWidth, TrimExponent);
        float trimTotal = leftTrim * rightTrim;

        float halfBand = (BandWidth * 0.5) * trimTotal;
        float trimmedUpperNoise = centeredUpperNoise * trimTotal;
        float trimmedLowerNoise = centeredLowerNoise * trimTotal;
        
        upperEdge = BandCenter + halfBand + trimmedUpperNoise;
        lowerEdge = BandCenter - halfBand + trimmedLowerNoise;
    } else {
        upperEdge = BandCenter + (BandWidth * 0.5) + centeredUpperNoise;
        lowerEdge = BandCenter - (BandWidth * 0.5) - centeredLowerNoise;
    }

    if (BorderSmoothness != 0) {
        float aboveLower = smoothstep(lowerEdge, lowerEdge + BorderSmoothness, coordV);
        float belowUpper = 1.0 - smoothstep(upperEdge - BorderSmoothness, upperEdge, coordV);
        InRegionSmooth = aboveLower * belowUpper;
    }

    InRegion = step(lowerEdge, coordV) * step(coordV, upperEdge);
}