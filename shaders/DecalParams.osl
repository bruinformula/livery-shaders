#ifndef SOLO_SHADER   
    #define ENTRY_CREATE_DECAL_PARAMS void 
#endif

#ifndef ENTRY_CREATE_DECAL_PARAMS
    #define DEFAULT_CREATE_DECAL_PARAMS(x) = x
    #define ENTRY_CREATE_DECAL_PARAMS shader
#else
    #define DEFAULT_CREATE_DECAL_PARAMS(x)
#endif

// This should probably just be autogenerated
// the materialx nodedefs are the snake and lower case versions of the OSL funcs 

struct DecalParams {
    // height is determined by the aspect ratio of the decal.
    string filename;
    float width;
    string units;
};

ENTRY_CREATE_DECAL_PARAMS CreateDecal [[ 
    string nodegroup = "autolib", 
]] (
    string filename DEFAULT_CREATE_DECAL_PARAMS(""),
    float width DEFAULT_CREATE_DECAL_PARAMS(0.1),
    string units DEFAULT_CREATE_DECAL_PARAMS("m"),
    output DecalParams params DEFAULT_CREATE_DECAL_PARAMS({})
) {
    params.filename = filename;
    params.width = width;
    params.units = units;
}