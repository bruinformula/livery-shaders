#include "OpenPBRSurface.h"

shader AutolibSurfaceCreate [[
    string category = "autolib"
]] (
    // Base
    float BaseWeight = 1  [[ string page = "Base", float min = 0, float max = 1 ]],
    color BaseColor = color(0.8)  [[ string page = "Base" ]],
    float BaseDiffuseRoughness = 0  [[ string page = "Base", float min = 0, float max = 1 ]],
    float BaseMetalness = 0  [[ string page = "Base", float min = 0, float max = 1 ]],

    // Specular
    float SpecularWeight = 1  [[ string page = "Specular", float min = 0, float max = 1 ]],
    color SpecularColor = 1  [[ string page = "Specular" ]],
    float SpecularRoughness = 0.3  [[ string page = "Specular", float min = 0, float max = 1 ]],
    float SpecularIOR = 1.5  [[ string page = "Specular", float min = 1, float max = 3.0 ]],
    float SpecularRoughnessAnisotropy = 0  [[ string page = "Specular", float min = 0, float max = 1 ]],
    float SpecularHaze = 0  [[ string page = "Specular", float min = 0, float max = 1 ]],
    float SpecularHazeSpread = 0.3  [[ string page = "Specular", float min = 0, float max = 1 ]],

    // Transmission
    float TransmissionWeight = 0  [[ string page = "Transmission", float min = 0, float max = 1 ]],
    color TransmissionColor = 1  [[ string page = "Transmission" ]],
    float TransmissionDepth = 0  [[ string page = "Transmission", float min = 0 ]],
    color TransmissionScatter = 0  [[ string page = "Transmission" ]],
    float TransmissionScatterAnisotropy = 0  [[ string page = "Transmission", float min = -1, float max = 1 ]],

    // Subsurface
    float SubsurfaceWeight = 0  [[ string page = "Subsurface", float min = 0, float max = 1 ]],
    color SubsurfaceColor = 1  [[ string page = "Subsurface" ]],
    float SubsurfaceRadius = 1  [[ string page = "Subsurface", float min = 0 ]],
    color SubsurfaceRadiusScale = 1  [[ string page = "Subsurface" ]],
    float SubsurfaceScatterAnisotropy = 0  [[ string page = "Subsurface", float min = -1, float max = 1 ]],

    // Fuzz
    float FuzzWeight = 0  [[ string page = "Fuzz", float min = 0, float max = 1 ]],
    color FuzzColor = 1  [[ string page = "Fuzz" ]],
    float FuzzRoughness = 0.5  [[ string page = "Fuzz", float min = 0, float max = 1 ]],

    // Coat
    float CoatWeight = 0  [[ string page = "Coat", float min = 0, float max = 1 ]],
    color CoatColor = 1  [[ string page = "Coat" ]],
    float CoatRoughness = 0  [[ string page = "Coat", float min = 0, float max = 1 ]],
    float CoatRoughnessAnisotropy = 0  [[ string page = "Coat", float min = 0, float max = 1 ]],
    float CoatIOR = 1.6  [[ string page = "Coat", float min = 1, float max = 3.0 ]],
    float CoatDarkening = 1  [[ string page = "Coat", float min = 0, float max = 1 ]],

    // Thin Film
    float ThinFilmWeight = 0  [[ string page = "Thin Film", float min = 0, float max = 1 ]],
    float ThinFilmThickness = 0.5  [[ string page = "Thin Film", float min = 0, float max = 1 ]],
    float ThinFilmIOR = 1.4  [[ string page = "Thin Film", float min = 1, float max = 3.0 ]],

    // Emission
    float EmissionLuminance = 0  [[ string page = "Emission", float min = 0, float max = 1000 ]],
    color EmissionColor = 1  [[ string page = "Emission" ]],

    // Geometry
    float GeometryOpacity = 1  [[ string page = "Geometry", float min = 0, float max = 1 ]],
    int GeometryThinWalled = 0  [[ string page = "Geometry", string widget = "boolean" ]],
    normal GeometryNormal = N  [[ string page = "Geometry", string widget = "null" ]],
    normal GeometryCoatNormal = N  [[ string page = "Geometry", string widget = "null" ]],
    vector GeometryTangent = dPdu  [[ string page = "Geometry", string widget = "null" ]],
    vector GeometryCoatTangent = dPdu  [[ string page = "Geometry", string widget = "null" ]],

    output OpenPBRSurface Mat = {}
) {
    // Base
    Mat.base.weight = BaseWeight;
    Mat.base.col = BaseColor;
    Mat.base.diffuse_roughness = BaseDiffuseRoughness;
    Mat.base.metalness = BaseMetalness;

    // Specular
    Mat.specular.weight = SpecularWeight;
    Mat.specular.col = SpecularColor;
    Mat.specular.roughness = SpecularRoughness;
    Mat.specular.ior = SpecularIOR;
    Mat.specular.roughness_anisotropy = SpecularRoughnessAnisotropy;
    Mat.specular.haze = SpecularHaze;
    Mat.specular.haze_spread = SpecularHazeSpread;

    // Transmission
    Mat.transmission.weight = TransmissionWeight;
    Mat.transmission.col = TransmissionColor;
    Mat.transmission.depth = TransmissionDepth;
    Mat.transmission.scatter = TransmissionScatter;
    Mat.transmission.scatter_anisotropy = TransmissionScatterAnisotropy;

    // Subsurface
    Mat.subsurface.weight = SubsurfaceWeight;
    Mat.subsurface.col = SubsurfaceColor;
    Mat.subsurface.radius = SubsurfaceRadius;
    Mat.subsurface.radius_scale = SubsurfaceRadiusScale;
    Mat.subsurface.scatter_anisotropy = SubsurfaceScatterAnisotropy;

    // Fuzz
    Mat.fuzz.weight = FuzzWeight;
    Mat.fuzz.col = FuzzColor;
    Mat.fuzz.roughness = FuzzRoughness;

    // Coat
    Mat.coat.weight = CoatWeight;
    Mat.coat.col = CoatColor;
    Mat.coat.roughness = CoatRoughness;
    Mat.coat.roughness_anisotropy = CoatRoughnessAnisotropy;
    Mat.coat.ior = CoatIOR;
    Mat.coat.darkening = CoatDarkening;

    // Thin Film
    Mat.thin_film.weight = ThinFilmWeight;
    Mat.thin_film.thickness = ThinFilmThickness;
    Mat.thin_film.ior = ThinFilmIOR;

    // Emission
    Mat.emission.luminance = EmissionLuminance;
    Mat.emission.col = EmissionColor;

    // Geometry
    Mat.geometry.opacity = GeometryOpacity;
    Mat.geometry.thin_walled = GeometryThinWalled;
    Mat.geometry.norm = GeometryNormal;
    Mat.geometry.coat_normal = GeometryCoatNormal;
    Mat.geometry.tangent = GeometryTangent;
    Mat.geometry.coat_tangent = GeometryCoatTangent;
}
