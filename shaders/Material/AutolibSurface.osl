#include "OpenPBRSurface.h"

// Anisotropy helper — returns AlphaX and AlphaY as separate floats
void openpbr_anisotropy(
    float roughness, 
    float anisotropy,
    output float AlphaX, 
    output float AlphaY
) {
    float roughSq = roughness * roughness;
    float inv = 1 - anisotropy;
    float sq = sqrt(2.0 / (pow(inv, 2) + 1));
    AlphaX = roughSq * sq;
    AlphaY = inv * AlphaX;
}

surface AutolibSurface [[
    string category = "autolib",
    string help = "OpenPBR surface with uberstruct input"
]] (
    OpenPBRSurface In = {} [[ string widget = "null" ]],
    output closure color Cout = 0
) {
    // Thin-film thickness in nanometres
    float tfNm = In.thin_film.thickness * 1000;

    // Coat roughness alphas
    float coatAx, coatAy;
    openpbr_anisotropy(In.coat.roughness, In.coat.roughness_anisotropy, coatAx, coatAy);

    // Coat F0
    float CoatIORM1 = In.coat.ior - 1;
    float CoatIORP1 = In.coat.ior + 1;
    float coat_F0Sqrt = CoatIORM1 / CoatIORP1;
    float coat_F0 = coat_F0Sqrt * coat_F0Sqrt;
    float CoatIORSqr = In.coat.ior * In.coat.ior;

    // Coat roughening of specular
    float coatR4 = pow(In.coat.roughness, 4.0);
    float specR4 = pow(In.specular.roughness, 4.0);
    float combinedR4 = min(1, 2.0 * coatR4 + specR4);
    float coatedSpecRoughness = pow(combinedR4, 0.25);
    float effSpecRoughness = mix(In.specular.roughness, coatedSpecRoughness, In.coat.weight);

    // Haze roughness (secondary specular lobe)
    float hazeBase = mix(In.specular.roughness, 1.0, In.specular.haze_spread);
    float hazeR4 = pow(hazeBase, 4.0);
    float combinedHazeR4 = min(1, 2.0 * coatR4 + hazeR4);
    float coatedHazeRoughness = pow(combinedHazeR4, 0.25);
    float effHazeRoughness = mix(hazeBase, coatedHazeRoughness, In.coat.weight);

    // Main specular alphas
    float specAx, specAy;
    openpbr_anisotropy(effSpecRoughness, In.specular.roughness_anisotropy, specAx, specAy);

    // Haze specular alphas
    float hazeAx, hazeAy;
    openpbr_anisotropy(effHazeRoughness, In.specular.roughness_anisotropy, hazeAx, hazeAy);

    // Modulated specular IOR
    float s2c = In.specular.ior / In.coat.ior;
    float c2s = In.coat.ior / In.specular.ior;
    float tirFix = (s2c > 1) ? s2c : c2s;
    float etaS = mix(In.specular.ior, tirFix, In.coat.weight);

    float etaM1 = etaS - 1;
    float etaP1 = etaS + 1;
    float F0Sqrt = etaM1 / etaP1;
    float F0 = F0Sqrt * F0Sqrt;
    float sF0 = clamp(In.specular.weight * F0, 0, 0.99999);
    float eps = sign(etaM1) * sqrt(sF0);
    float modETA = (1 + eps) / (1 - eps);

    // Volume / transmission coefficients
    color tcSafe = max(In.transmission.col, 1e-6);
    float tdSafe = max(In.transmission.depth, 1e-6);

    vector extNum = -log(tcSafe);
    vector extCoeff = extNum / tdSafe;
    vector scaCoeff = In.transmission.scatter / tdSafe;
    vector absCoeff = extCoeff - scaCoeff;

    // Shift absorption so minimum channel > = 0
    float absMin = min(min(absCoeff.x, absCoeff.y), absCoeff.z);
    vector absShifted = absCoeff - vector(absMin, absMin, absMin);
    vector finalAbs = (0 > absMin) ? absShifted : absCoeff;

    vector volAbsorption = (In.transmission.depth > 0) ? finalAbs : vector(0);
    vector volScattering = (In.transmission.depth > 0) ? scaCoeff : vector(0);

    color transTint = (In.transmission.depth > 0) ? color(1) : In.transmission.col;

    // Coat darkening
    float oneM_F0 = 1 - coat_F0;
    float Kcoat = 1 - oneM_F0 / CoatIORSqr;
    float oneM_Kcoat = 1 - Kcoat;

    color Emetal = In.base.col * In.specular.weight;
    color Edielectric = mix(In.base.col, In.subsurface.col, In.subsurface.weight);
    color Ebase = mix(Edielectric, Emetal, In.base.metalness);

    color baseDarkening = color(oneM_Kcoat, oneM_Kcoat, oneM_Kcoat) / (color(1) - Ebase * Kcoat);

    color modDarkening = mix(1, baseDarkening, In.coat.weight * In.coat.darkening);
    color coatAtten = mix(1, In.coat.col, In.coat.weight);

    // Safe nonnegative inputs
    color BaseColorNn = max(In.base.col, 0);
    color sssColorNn = max(In.subsurface.col, 0);

    // Fuzz
    closure color fuzz_bsdf = In.fuzz.weight * sheen_bsdf(In.geometry.norm, In.fuzz.col, In.fuzz.roughness);

    // Coat
    closure color coat_bsdf = In.coat.weight * dielectric_bsdf(
        In.geometry.coat_normal,  
        In.geometry.coat_tangent,
        color(1), color(0),
        coatAx, coatAy, 
        In.coat.ior, 
        "ggx", 
        "thinfilm_thickness", 0, 
        "thinfilm_ior", 1.5
    );

    // Metal
    closure color metalMix;
    if (In.base.metalness > 0) {
        color metalR0 = In.base.col * In.base.weight;
        color metalR90 = In.specular.col;

        closure color metal_bsdf = In.specular.weight * generalized_schlick_bsdf(
            In.geometry.norm, 
            In.geometry.tangent, 
            color(1), color(0), 
            specAx, specAy, 
            metalR0, metalR90, 5.0, 
            "ggx", 
            "thinfilm_thickness", 0, 
            "thinfilm_ior", 1.5
        );

        closure color metal_bsdfTf = In.specular.weight * generalized_schlick_bsdf(
            In.geometry.norm, 
            In.geometry.tangent, 
            color(1), color(0), 
            specAx, specAy, 
            metalR0, metalR90, 5.0, 
            "ggx", 
            "thinfilm_thickness", tfNm, 
            "thinfilm_ior", In.thin_film.ior
        );

        closure color metalMain = mix(metal_bsdf, metal_bsdfTf, In.thin_film.weight);

        if (In.specular.haze > 0) {
            closure color metal_haze = In.specular.weight * generalized_schlick_bsdf(
                In.geometry.norm, 
                In.geometry.tangent, 
                color(1), color(0), 
                hazeAx, hazeAy, 
                metalR0, metalR90, 5.0, 
                "ggx", 
                "thinfilm_thickness", 0, 
                "thinfilm_ior", 1.5
            );

            closure color metal_hazeTf = In.specular.weight * generalized_schlick_bsdf(
                In.geometry.norm, 
                In.geometry.tangent, 
                color(1), color(0), 
                hazeAx, hazeAy, 
                metalR0, metalR90, 5.0, 
                "ggx", 
                "thinfilm_thickness", tfNm, 
                "thinfilm_ior", In.thin_film.ior
            );

            closure color metalHaze = mix(metal_haze, metal_hazeTf, In.thin_film.weight);
            metalMix = mix(metalMain, metalHaze, In.specular.haze);
        } else {
            metalMix = metalMain;
        }
    }


    // Dielectric reflection (base + thin-film variant)
    closure color dielRefl = dielectric_bsdf(
        In.geometry.norm, 
        In.geometry.tangent, 
        In.specular.col, color(0), 
        specAx, specAy, 
        modETA, "ggx", 
        "thinfilm_thickness", 0, 
        "thinfilm_ior", 1.5
    );
    
    closure color dielReflMain;
    if (In.thin_film.weight > 0) {
        closure color dielReflTf = dielectric_bsdf(
            In.geometry.norm, In.geometry.tangent,
            In.specular.col, color(0),
            specAx, specAy,
            modETA, "ggx",
            "thinfilm_thickness", tfNm,
            "thinfilm_ior", In.thin_film.ior
        );
        dielReflMain = mix(dielRefl, dielReflTf, In.thin_film.weight);
    } else {
        dielReflMain = dielRefl;
    }

    closure color dielReflMix;
    if (In.specular.haze > 0) {
        closure color dielReflHaze = dielectric_bsdf(
            In.geometry.norm, 
            In.geometry.tangent, 
            In.specular.col, color(0), 
            hazeAx, hazeAy, 
            modETA, "ggx", 
            "thinfilm_thickness", 0, 
            "thinfilm_ior", 1.5
        );

        closure color dielReflHazeMix;
        if (In.thin_film.weight > 0) {
            closure color dielReflHazeTf = dielectric_bsdf(
                In.geometry.norm, In.geometry.tangent,
                In.specular.col, color(0),
                hazeAx, hazeAy,
                modETA, "ggx",
                "thinfilm_thickness", tfNm,
                "thinfilm_ior", In.thin_film.ior
            );
            dielReflHazeMix = mix(dielReflHaze, dielReflHazeTf, In.thin_film.weight);
        } else {
            dielReflHazeMix = dielReflHaze;
        }

        dielReflMix = mix(dielReflMain, dielReflHazeMix, In.specular.haze);
    } else {
        dielReflMix = dielReflMain;
    }

    // Dielectric transmission + participating medium
    closure color dielVolumeTrans;
    if (In.transmission.weight > 0) {
        closure color dielTrans = dielectric_bsdf(
            In.geometry.norm, 
            In.geometry.tangent, 
            color(0), transTint, 
            specAx, specAy, 
            modETA, 
            "ggx", 
            "thinfilm_thickness", 0, 
            "thinfilm_ior", 1.5
        );

        vector extinction = volAbsorption + volScattering;
        vector safe_ext = max(extinction, 1e-8);

        closure color vol = anisotropic_vdf(volScattering / safe_ext, extinction, In.transmission.scatter_anisotropy);

        dielVolumeTrans = layer(dielTrans, vol);
    }

    // Diffuse base
    closure color diffuse_bsdf;
    if (In.base.weight > 0 && In.subsurface.weight < 1) {
        diffuse_bsdf = In.base.weight * oren_nayar_diffuse_bsdf(In.geometry.norm, BaseColorNn, In.base.diffuse_roughness);
    }

    // Subsurface — volumetric path
    closure color sss;
    if (In.subsurface.weight > 0) {
        if (In.geometry.thin_walled) {
            float sssInv = 1 - In.subsurface.scatter_anisotropy;
            float sssPlus = 1 + In.subsurface.scatter_anisotropy;
            closure color sssTwR = sssInv * oren_nayar_diffuse_bsdf(
                In.geometry.norm, sssColorNn, In.base.diffuse_roughness);
            closure color sssTwT = sssPlus * translucent_bsdf(
                In.geometry.norm, sssColorNn);
            sss = In.subsurface.col * mix(sssTwT, sssTwR, 0.5);
        } else {
            color sssRadiusFinal = In.subsurface.radius * In.subsurface.radius_scale;
            #if (OSL_VERSION_MAJOR == 1 && OSL_VERSION_MINOR >= 14) || (OSL_VERSION_MAJOR > 1)
                sss = subsurface_bssrdf(In.geometry.norm, sssColorNn, sssRadiusFinal, In.subsurface.scatter_anisotropy);
            #else
                sss = subsurface_bssrdf(In.geometry.norm, sssColorNn, 1.0, sssRadiusFinal, In.subsurface.scatter_anisotropy);
            #endif
        }
    }

    // Layer stack (outermost -> innermost):  fuzz -> coat -> darkened(metal <-> dielectric) -> opaque <-> transmission
    closure color opaqueBase = mix(diffuse_bsdf, sss, In.subsurface.weight);
    closure color dielSubstrate = mix(opaqueBase, dielVolumeTrans, In.transmission.weight);
    closure color dielBase = layer(dielReflMix, dielSubstrate);
    closure color baseSub = mix(dielBase, metalMix, In.base.metalness);
    closure color darkened = modDarkening * baseSub;
    closure color coatAttenuated = coatAtten * darkened;
    closure color coatLayer = layer(coat_bsdf, coatAttenuated);
    closure color fuzzLayer = layer(fuzz_bsdf, coatLayer);

    // Emission with Schlick Fresnel modulation through coat
    closure color uncoated_edf = uniform_edf(In.emission.col * In.emission.luminance);
    closure color tinted_edf = In.coat.col * uncoated_edf;

    float NdotV = fabs(dot(In.geometry.norm, -I));
    float x5 = pow(clamp(1 - NdotV, 0, 1), 5.0);
    color fCoat = mix(color(oneM_F0), color(0), x5);
    closure color coated_edf = tinted_edf * fCoat;

    closure color emission_edf = mix(uncoated_edf, coated_edf, In.coat.weight);

    // Outputs
    closure color bsdf = fuzzLayer;
    closure color edf = emission_edf;
    float opacity = clamp(In.geometry.opacity, 0, 1);

    Cout = (bsdf + edf) * opacity + transparent() * (1 - opacity);
}
