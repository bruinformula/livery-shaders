#include "OpenPBRSurface.h"

// wmix — weight-aware blend factor.
// See "Putting the Pieces Together" — Lee Kerley, Sony Pictures Imageworks.
// this returns the amount we should mix parameters of A and B,
// knowing that A and B only exist according to their weights
float wmix(float weight_A, float weight_B, float x) {
    if (weight_A == weight_B)
        return x; // both A and B exist in equally, just return x. aka LERP.
    if (weight_A == 0)
        return 1; // A has nothing, take everything from B
    if (weight_B == 0)
        return 0; // B has nothing, take everything from A
    // NOTE: the ifs above just avoid numerical singularities
    // but are otherwise continuous with this general formula
    float a = (1 - x) * weight_A; // how much of A
    float b = x * weight_B; // how much of B
    return b / (a + b);
}

// ior_lerp — blend two IOR values in reflectance space.
float ior_lerp(float ior_A, float ior_B, float t) {
    float r_A = pow((ior_A - 1) / (ior_A + 1), 2);
    float r_B = pow((ior_B - 1) / (ior_B + 1), 2);
    float r_mix = mix(r_A, r_B, t);
    float sqrtR = sqrt(max(r_mix, 0));
    return (1 + sqrtR) / max(1 - sqrtR, 1e-6);
}

// Base
OpenPBRBase mix_base(OpenPBRBase a, OpenPBRBase b, float x) {
    float lx = wmix(a.weight, b.weight, x);

    OpenPBRBase result;
    result.weight = mix(a.weight, b.weight, x);
    result.col = mix(a.col, b.col, lx);
    result.diffuse_roughness = mix(a.diffuse_roughness, b.diffuse_roughness, lx);
    result.metalness = mix(a.metalness, b.metalness, lx);
    return result;
}

// Specular
OpenPBRSpecular mix_specular(OpenPBRSpecular a, OpenPBRSpecular b, float x) {
    float lx = wmix(a.weight, b.weight, x);

    OpenPBRSpecular result;
    result.weight = mix(a.weight, b.weight, x);
    result.col = mix(a.col, b.col, lx);
    result.roughness = mix(a.roughness, b.roughness, lx);
    result.roughness_anisotropy = mix(a.roughness_anisotropy, b.roughness_anisotropy, lx);
    result.haze = mix(a.haze, b.haze, lx);
    result.haze_spread = mix(a.haze_spread, b.haze_spread, lx);
    result.ior = ior_lerp(a.ior, b.ior, lx);
    return result;
}

// Transmission
//   depth is treated as a secondary gate for scatter — if depth is 0 on one
//   side the scatter parameters on that side are irrelevant, so wmix is used
//   for scatter parameters separately using depth as their local weight.
OpenPBRTransmission mix_transmission(OpenPBRTransmission a, OpenPBRTransmission b, float x) {
    float lx = wmix(a.weight, b.weight, x);
    float scatter_lx = wmix(a.depth, b.depth, x);

    OpenPBRTransmission result;
    result.weight = mix(a.weight, b.weight, x);
    result.col = mix(a.col, b.col, lx);
    result.depth = mix(a.depth, b.depth, lx);
    result.scatter = mix(a.scatter, b.scatter, scatter_lx);
    result.scatter_anisotropy = mix(a.scatter_anisotropy, b.scatter_anisotropy, scatter_lx);
    result.dispersion_scale = mix(a.dispersion_scale, b.dispersion_scale, lx);
    result.dispersion_abbe_number = mix(a.dispersion_abbe_number, b.dispersion_abbe_number, lx);
    return result;
}

// Subsurface
//   radius_scale is only meaningful when radius > 0, so it uses wmix with
//   radius as the local weight, matching the scatter depth treatment above.
OpenPBRSubsurface mix_subsurface(OpenPBRSubsurface a, OpenPBRSubsurface b, float x) {
    float lx = wmix(a.weight, b.weight, x);
    float radius_lx = wmix(a.radius, b.radius, x);

    OpenPBRSubsurface result;
    result.weight = mix(a.weight, b.weight, x);
    result.col = mix(a.col, b.col, lx);
    result.radius = mix(a.radius, b.radius, lx);
    result.radius_scale = mix(a.radius_scale, b.radius_scale, radius_lx);
    result.scatter_anisotropy = mix(a.scatter_anisotropy, b.scatter_anisotropy, lx);
    return result;
}

// Coat
OpenPBRCoat mix_coat(OpenPBRCoat a, OpenPBRCoat b, float x) {
    float lx = wmix(a.weight, b.weight, x);

    OpenPBRCoat result;
    result.weight = mix(a.weight, b.weight, x);
    result.col = mix(a.col, b.col, lx);
    result.roughness = mix(a.roughness, b.roughness, lx);
    result.roughness_anisotropy = mix(a.roughness_anisotropy, b.roughness_anisotropy, lx);
    result.ior = ior_lerp(a.ior, b.ior, lx);
    result.darkening = mix(a.darkening, b.darkening, lx);
    return result;
}

// Fuzz
OpenPBRFuzz mix_fuzz(OpenPBRFuzz a, OpenPBRFuzz b, float x) {
    float lx = wmix(a.weight, b.weight, x);

    OpenPBRFuzz result;
    result.weight = mix(a.weight, b.weight, x);
    result.col = mix(a.col, b.col, lx);
    result.roughness = mix(a.roughness, b.roughness, lx);
    return result;
}

// Thin Film
OpenPBRThinFilm mix_thin_film(OpenPBRThinFilm a, OpenPBRThinFilm b, float x) {
    float lx = wmix(a.weight, b.weight, x);

    OpenPBRThinFilm result;
    result.weight = mix(a.weight, b.weight, x);
    result.thickness = mix(a.thickness, b.thickness, lx);
    result.ior = ior_lerp(a.ior, b.ior, lx);
    return result;
}

// Emission
OpenPBREmission mix_emission(OpenPBREmission a, OpenPBREmission b, float x) {
    float lx = wmix(a.luminance, b.luminance, x);

    OpenPBREmission result;
    result.luminance = mix(a.luminance, b.luminance, x);
    result.col = mix(a.col, b.col, lx);
    return result;
}

// Geometry
//   thin_walled is a boolean and cannot be interpolated. We take A when
//   x < 0.5 and B otherwise. Some enforcement is needed.
//   normals and tangents are lerped then renormalized; a SLERP is not needed
//   because the two normals at any surface point will rarely be on opposite
//   hemispheres given how the data is structured.
OpenPBRGeometry mix_geometry(OpenPBRGeometry a, OpenPBRGeometry b, float x) {
    OpenPBRGeometry result;
    result.opacity = mix(a.opacity, b.opacity, x);
    result.thin_walled = (x < 0.5) ? a.thin_walled : b.thin_walled;
    result.norm = normalize(mix(a.norm, b.norm, x));
    result.coat_normal  = normalize(mix(a.coat_normal, b.coat_normal, x));
    result.tangent = normalize(mix(a.tangent, b.tangent, x));
    result.coat_tangent = normalize(mix(a.coat_tangent, b.coat_tangent, x));
    return result;
}

shader AutolibSurfaceCombine [[
    string category = "autolib"
]] (
    float Factor = 0.5  [[ float min = 0.0, float max = 1.0 ]],
    OpenPBRSurface MaterialA = {},
    OpenPBRSurface MaterialB = {},
    output OpenPBRSurface mat = {}
) {
    float x = clamp(Factor, 0, 1);

    if (!isconnected(MaterialA) || x == 1) {
        mat = MaterialB;
        return;
    }
    if (!isconnected(MaterialB) || x == 0) {
        mat = MaterialA;
        return;
    }

    if (MaterialA.geometry.thin_walled != MaterialB.geometry.thin_walled) {
        printf(
            "Error in AutolibSurfaceCombine: cannot combine thin-walled" 
            "and non-thin-walled materials. MaterialA thin_walled = %d, "
            "MaterialB thin_walled = %d\n", 
            MaterialA.geometry.thin_walled, 
            MaterialB.geometry.thin_walled);
        exit();
    }

    mat.base = mix_base(MaterialA.base, MaterialB.base, x);
    mat.specular = mix_specular(MaterialA.specular, MaterialB.specular, x);
    mat.transmission = mix_transmission(MaterialA.transmission, MaterialB.transmission, x);
    mat.subsurface = mix_subsurface(MaterialA.subsurface, MaterialB.subsurface, x);
    mat.coat = mix_coat(MaterialA.coat, MaterialB.coat, x);
    mat.fuzz = mix_fuzz(MaterialA.fuzz, MaterialB.fuzz, x);
    mat.thin_film = mix_thin_film(MaterialA.thin_film, MaterialB.thin_film, x);
    mat.emission = mix_emission(MaterialA.emission, MaterialB.emission, x);
    mat.geometry = mix_geometry(MaterialA.geometry, MaterialB.geometry, x);
}
