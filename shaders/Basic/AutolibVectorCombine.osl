shader AutolibVectorCombine [[
    string label = "Vector Combine",
    string help = "Builds a vector from X, Y and Z.",
    string rfh_classification = "RenderMan/Autolib/Convert",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/convert"
]] (
    float X = 0 [[ string label = "Result" ]],
    float Y = 0 [[ string label = "Y" ]],
    float Z = 0 [[ string label = "Z" ]],

    output vector Out = 0 [[ string label = "Result" ]]
) {
    Out.x = X;
    Out.y = Y;
    Out.z = Z;
}