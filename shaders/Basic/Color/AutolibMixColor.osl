shader AutolibMixColor [[
    string label = "Mix Color",
    string help = "Linear blend from Color A (Mixer 0) to Color B (Mixer 1).",
    string rfh_classification = "RenderMan/Autolib/Color",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/color"
]] (
    float Mixer = 0 [[ string label = "Mixer", float min = 0, float max = 1 ]],
    color ColorA = 0 [[ string label = "Color A" ]],
    color ColorB = 1 [[ string label = "Color B" ]],
    int Clamp = 0 [[ string label = "Clamp", string widget = "checkBox" ]],

    output color RGB = 0 [[ string label = "Result" ]]
) {
    float clampedMixer = Mixer;
    if (Clamp == 1) {
        clampedMixer = clamp(Mixer, 0.0, 1.0);
    }

    if (clampedMixer <= 0.0) {
        RGB = ColorA;
        return;
    } else if (clampedMixer >= 1.0) {
        RGB = ColorB;
        return;
    }

    RGB = mix(ColorA, ColorB, clampedMixer);
}