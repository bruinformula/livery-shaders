shader AutolibVectorSeparate [[
    string label = "Vector Separate",
    string help = "Splits a vector into X, Y and Z.",
    string rfh_classification = "RenderMan/Autolib/Convert",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/convert"
]] (
    vector Input = 0 [[ string label = "Input" ]],

    output float X = 0 [[ string label = "Result" ]],
    output float Y = 0 [[ string label = "Y" ]],
    output float Z = 0 [[ string label = "Z" ]]
) {
    X = Input[0];
    Y = Input[1];
    Z = Input[2];
}