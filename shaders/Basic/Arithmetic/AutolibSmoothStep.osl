shader AutolibSmoothStep [[
    string label = "Smooth Step",
    string help = "Hermite smooth step: 0 below Low, 1 above High (per component).",
    string rfh_classification = "RenderMan/Autolib/Math",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/math"
]] (
    vector Low = 0 [[ string label = "Low" ]],
    vector High = 1 [[ string label = "High" ]],
    vector Input = 0 [[ string label = "Input" ]],

    output vector Output = 0 [[ string label = "Output" ]]
) {
    Output = smoothstep(Low, High, Input);
}