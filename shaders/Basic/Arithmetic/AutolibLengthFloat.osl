shader AutolibLengthFloat [[
    string label = "Length Float",
    string help = "Length (magnitude) of the input.",
    string rfh_classification = "RenderMan/Autolib/Math",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/math"
]] (
    float Input = 0.0 [[ string label = "Input" ]],

    output float Length = 0 [[ string label = "Length" ]]
) {
    Length = abs(Input);
}