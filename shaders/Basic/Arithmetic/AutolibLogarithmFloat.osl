shader AutolibLogarithmFloat [[
    string label = "Logarithm Float",
    string help = "Natural logarithm (inputs below zero are clamped to a small positive value).",
    string rfh_classification = "RenderMan/Autolib/Math",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/math"
]] (
    float Input = 1 [[ string label = "Input" ]],

    output float Output = 0 [[ string label = "Output" ]]
) {
    Output = log(max(Input, 0.000001));
}