shader AutolibMix [[
    string label = "Mix",
    string help = "Linear blend from A (Mixer 0) to B (Mixer 1).",
    string rfh_classification = "RenderMan/Autolib/Math",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/math"
]] (
    float Mixer = 0 [[ string label = "Mixer", float min = 0, float max = 1 ]],
    vector VectorA = 0 [[ string label = "Vector A" ]],
    vector VectorB = 1 [[ string label = "Vector B" ]],
    int Clamp = 0 [[ string label = "Clamp", string widget = "checkBox" ]],

    output vector XYZ = 0 [[ string label = "Result" ]]
) {
    float clampedMixer = Mixer;
    if (Clamp == 1) {
        clampedMixer = clamp(Mixer, 0.0, 1.0);
    }

    if (clampedMixer <= 0.0) {
        XYZ = VectorA;
        return;
    } else if (clampedMixer >= 1.0) {
        XYZ = VectorB;
        return;
    }

    XYZ = mix(VectorA, VectorB, clampedMixer);
}