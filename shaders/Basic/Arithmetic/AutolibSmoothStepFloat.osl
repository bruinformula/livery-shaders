shader AutolibSmoothStepFloat [[
    string label = "Smooth Step Float",
    string help = "Hermite smooth step: 0 below Low, 1 above High.",
    string rfh_classification = "RenderMan/Autolib/Math",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/math"
]] (
    float Low = 0 [[ string label = "Low" ]],
    float High = 1 [[ string label = "High" ]],
    float Input = 0 [[ string label = "Input" ]],

    output float Output = 0 [[ string label = "Output" ]]
) {
    Output = smoothstep(Low, High, Input);
}