shader AutolibCosineFloat [[
    string label = "Cosine Float",
    string help = "cos(Adjacent / Hypotenuse).",
    string rfh_classification = "RenderMan/Autolib/Math",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/math"
]] (
    float Adjacent = 1 [[ string label = "Adjacent" ]],
    float Hypotenuse = 0 [[ string label = "Hypotenuse" ]],

    output float Output = 0 [[ string label = "Output" ]]
) {
    Output = cos(Adjacent / Hypotenuse);
}