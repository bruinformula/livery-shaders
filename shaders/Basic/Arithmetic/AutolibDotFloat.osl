shader AutolibDotFloat [[
    string label = "Dot Float",
    string help = "Dot product of A and B.",
    string rfh_classification = "RenderMan/Autolib/Math",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/math"
]] (
    float ValueA = 0 [[ string label = "Value A" ]],
    float ValueB = 0 [[ string label = "Value B" ]],

    output float Result = 0 [[ string label = "Result" ]]
) {
    Result = ValueA * ValueB;
}