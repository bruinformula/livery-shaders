shader AutolibPower [[
    string label = "Power",
    string help = "Base raised to Exponent (per component).",
    string rfh_classification = "RenderMan/Autolib/Math",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/math"
]] (
    vector Base = 0 [[ string label = "Base" ]],
    vector Exponent = 1 [[ string label = "Exponent" ]],

    output vector Output = 0 [[ string label = "Output" ]]
) {
    Output = pow(Base, Exponent);
}