
// Helper: Float Bias logic
float computeBias(float x, float b) {
    float biasClamped = clamp(b, 1e-4, 0.9999);
    return x / ((1.0 / biasClamped - 2.0) * (1.0 - x) + 1.0);
}

// Helper: Float Gain logic
float computeGain(float x, float g) {
    float gainClamped = clamp(g, 1e-4, 0.9999);
    float result;
    if (x < 0.5)
        result = x / ((1.0 / gainClamped - 2.0) * (1.0 - 2.0 * x) + 1.0);
    else
        result = ((1.0 / gainClamped - 2.0) * (1.0 - 2.0 * x) - x) /
                 ((1.0 / gainClamped - 2.0) * (1.0 - 2.0 * x) - 1.0);
    return clamp(result, 0.0, 1.0);
}

float safeDivide(float a, float b) {
    return (b != 0.0) ? a / b : 0.0;
}

float smootherstep(float edge0, float edge1, float x) {
    float t = clamp(safeDivide((x - edge0), (edge1 - edge0)), 0.0, 1.0);
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

#define LINEAR 0
#define STEPPED 1
#define SMOOTHSTEP 2
#define SMOOTHERSTEP 3

float mapRangeScalar(
    float value,
    float inputMin,
    float inputMax,
    int clampInput,
    int rangeType,
    float steps,
    float bias,
    float gain,
    float outputMin,
    float outputMax,
    int clampOutput
) {
    if (inputMin == outputMin && inputMax == outputMax) {
        return value;
    }

    float factor = value;

    if (inputMax != inputMin) {
        if (rangeType == STEPPED) {
            factor = safeDivide((value - inputMin), (inputMax - inputMin));
            factor = (steps > 0) ? floor(factor * (steps + 1.0)) / steps : 0.0;
        } else if (rangeType == SMOOTHSTEP) {
            factor = (inputMin > inputMax)
                ? 1.0 - smoothstep(inputMax, inputMin, value)
                : smoothstep(inputMin, inputMax, value);
        } else if (rangeType == SMOOTHERSTEP) {
            factor = (inputMin > inputMax)
                ? 1.0 - smootherstep(inputMax, inputMin, value)
                : smootherstep(inputMin, inputMax, value);
        } else {
            factor = safeDivide((value - inputMin), (inputMax - inputMin));
        }
    } else {
        factor = (value < inputMin) ? 0.0 : 1.0;
    }

    if (clampInput) {
        factor = clamp(factor, 0.0, 1.0);
    }

    if (bias != 0.5) {
        factor = computeBias(factor, bias);
    }
    if (gain != 0.5) {
        factor = computeGain(factor, gain);
    }

    float result = mix(outputMin, outputMax, factor);

    if (clampOutput) {
        result = clamp(result, min(outputMin, outputMax), max(outputMin, outputMax));
    }

    return result;
}

shader AutolibMapRange [[
    string label = "Map Range",
    string help = "Remaps each component of a vector from an input range to an output range, with optional stepped, "
                  "smoothstep or smootherstep interpolation and bias / gain shaping in between.",
    string rfh_classification = "RenderMan/Autolib/Math",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/math"
]] (
    vector Value = 1 [[
        string label = "Value",
        string help = "The value to remap."
    ]],

    vector InputMin = 0 [[
        string label = "Input Min",
        string help = "Input value that maps to Output Min.",
        float slidermin = -1, float slidermax = 1,
        string page = "Input Range",
        int page_open = 1
    ]],
    vector InputMax = 1 [[
        string label = "Input Max",
        string help = "Input value that maps to Output Max. Swapping Min and Max inverts the mapping.",
        float slidermin = -1, float slidermax = 1,
        string page = "Input Range"
    ]],
    int ClampInput = 1 [[
        string label = "Clamp Input",
        string help = "Clamp the normalized position in the input range to 0-1 before shaping.",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Input Range"
    ]],

    int RangeType = LINEAR [[
        string label = "Interpolation",
        string help = "How the normalized input is shaped: Linear, Stepped (quantized into Steps "
                      "levels), Smoothstep or Smootherstep.",
        string widget = "mapper",
        string options = "Linear:0|Stepped:1|Smoothstep:2|Smootherstep:3",
        int connectable = 0,
        string page = "Remap",
        int page_open = 1
    ]],
    float Steps = 4.0 [[
        string label = "Steps",
        string help = "Number of steps in Stepped mode.",
        float min = 0, float slidermax = 16,
        string page = "Remap",
        string conditionalVisOp = "equalTo",
        string conditionalVisPath = "../RangeType",
        string conditionalVisValue = "1"
    ]],
    float Bias = 0.5 [[
        string label = "Bias",
        string help = "Perlin bias of the normalized value; 0.5 leaves it unchanged, lower values push it toward 0.",
        float min = 0.01, float max = 0.99, int slider = 1,
        string page = "Remap"
    ]],
    float Gain = 0.5 [[
        string label = "Gain",
        string help = "Perlin gain (S-curve) of the normalized value; 0.5 leaves it unchanged, higher values steepen the middle.",
        float min = 0.01, float max = 0.99, int slider = 1,
        string page = "Remap"
    ]],

    vector OutputMin = 0 [[
        string label = "Output Min",
        string help = "Result for an input at Input Min.",
        float slidermin = -1, float slidermax = 1,
        string page = "Output Range",
        int page_open = 1
    ]],
    vector OutputMax = 1 [[
        string label = "Output Max",
        string help = "Result for an input at Input Max.",
        float slidermin = -1, float slidermax = 1,
        string page = "Output Range"
    ]],
    int ClampOutput = 1 [[
        string label = "Clamp Output",
        string help = "Clamp the result between Output Min and Output Max.",
        string widget = "checkBox",
        int connectable = 0,
        string page = "Output Range"
    ]],

    output vector Result = 0 [[ string label = "Result" ]]
) {
    Result = vector(
        mapRangeScalar(Value[0], InputMin[0], InputMax[0], ClampInput, RangeType, Steps, Bias, Gain, OutputMin[0], OutputMax[0], ClampOutput),
        mapRangeScalar(Value[1], InputMin[1], InputMax[1], ClampInput, RangeType, Steps, Bias, Gain, OutputMin[1], OutputMax[1], ClampOutput),
        mapRangeScalar(Value[2], InputMin[2], InputMax[2], ClampInput, RangeType, Steps, Bias, Gain, OutputMin[2], OutputMax[2], ClampOutput)
    );
}