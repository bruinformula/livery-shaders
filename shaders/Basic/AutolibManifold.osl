#define UV 0
#define PRIMVAR 1
#define POBJECT 2
#define PWORLD 3

// Arnold's u,v on a mesh are its UVs; RenderMan's are per-face parametric coordinates,
// so read the st primvar when the renderer exposes it ("primvar" scope, as PxrPrimvar does:
// a plain "st" lookup is not the mesh st in RenderMan's pattern bake).
point meshUV() {
    float st[2];
    if (getattribute("primvar", "st", st))
        return point(st[0], st[1], 0);
    return point(u, v, 0);
}

shader AutolibManifold [[
    string label = "Manifold",
    string help = "Texture coordinates for downstream patterns: the mesh UVs (st), any primvar, or object / world "
                  "position, then rotated, scaled, repeated and offset. Connect Other Coord to transform "
                  "coordinates from another node instead.",
    string rfh_classification = "RenderMan/Autolib/Manifold",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/manifold"
]] (
    int CoordType = UV [[
        string label = "Coordinates",
        string help = "Where the coordinates come from. UV reads the mesh st primvar; Primvar reads "
                      "the primvar named below (float2 or float3); Object / World use the shading "
                      "position in that space.",
        string widget = "mapper",
        string options = "UV:0|Primvar:1|Object Position:2|World Position:3",
        int connectable = 0,
        string page = "Coordinates",
        int page_open = 1
    ]],
    string PrimvarName = "st" [[
        string label = "Primvar Name",
        string help = "The primvar to read when Coordinates is Primvar.",
        int connectable = 0,
        string page = "Coordinates",
        string conditionalVisOp = "equalTo",
        string conditionalVisPath = "../CoordType",
        string conditionalVisValue = "1"
    ]],
    point OtherCoord = 0 [[
        string label = "Other Coord",
        string help = "When connected, these coordinates are used instead of the Coordinates source.",
        string page = "Coordinates"
    ]],
    vector Scale = 1.0 [[
        string label = "Scale",
        string help = "Multiplies the coordinates (after rotation).",
        float slidermin = 0, float slidermax = 10,
        string page = "Transform",
        int page_open = 1
    ]],
    vector Repeat = 1.0 [[
        string label = "Repeat",
        string help = "Tiling factor, applied after Scale.",
        float slidermin = 0, float slidermax = 10,
        string page = "Transform"
    ]],
    vector Offset = 0.0 [[
        string label = "Offset",
        string help = "Added to the coordinates last, in the scaled space.",
        float slidermin = -1, float slidermax = 1,
        string page = "Transform"
    ]],
    float Rotate = 0.0 [[
        string label = "Rotate",
        string help = "Rotation in degrees about the coordinate origin (in the XY / st plane), applied first.",
        float slidermin = 0, float slidermax = 360,
        string page = "Transform"
    ]],

    output point Result = 0 [[ string label = "Result", string help = "The transformed coordinates." ]]
) {
    point p = 0;

    if (isconnected(OtherCoord)) {
        p = OtherCoord;
    } else if (CoordType == UV) {
        p = meshUV();
    } else if (CoordType == PRIMVAR) {
        float st[2] = {0, 0};
        point pv = 0;
        if (getattribute("primvar", PrimvarName, pv) || getattribute(PrimvarName, pv)) {
            p = pv;
        } else if (getattribute("primvar", PrimvarName, st) || getattribute(PrimvarName, st)) {
            p = point(st[0], st[1], 0);
        }
    } else if (CoordType == POBJECT) {
        p = transform("object", P);
    } else if (CoordType == PWORLD) {
        p = transform("world", P);
    } else {
        p = meshUV();
    }
    
    // Rotate
    if (Rotate != 0.0) {
        float angle = radians(Rotate);
        float s = sin(angle);
        float c = cos(angle);
        float x = p[0];
        float y = p[1];
        p[0] = x * c - y * s;
        p[1] = x * s + y * c;
    }

    // Scale and Offset
    if (Scale != 1.0) {
        p *= Scale;
    }
    if (Repeat != vector(1.0)) {
        p *= Repeat;
    }
    if (Offset != vector(0.0)) {
        p += Offset;
    }

    Result = p;
}