#define COMMON 0
#define OBJECT 1
#define SHADER 2
#define WORLD 3
#define CAMERA 4
#define SCREEN 5
#define RASTER 6
#define NDC 7

string spaceIntToString(int space) {
    if (space == COMMON) {
        return "common";
    } else if (space == OBJECT) {
        return "object";
    } else if (space == SHADER) {
        return "shader";
    } else if (space == WORLD) {
        return "world";
    } else if (space == CAMERA) {
        return "camera";
    } else if (space == SCREEN) {
        return "screen";
    } else if (space == RASTER) {
        return "raster";
    } else if (space == NDC) {
        return "NDC";
    } else {
        return "common";
    }
}

shader AutolibTransform [[
    string label = "Transform",
    string help = "Transforms a point from one coordinate system to another.",
    string rfh_classification = "RenderMan/Autolib/Vector",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/vector"
]] (
    point Input = P [[
        string label = "Input",
        string help = "The point to transform. Defaults to the shading position."
    ]],
    int From = COMMON [[
        string label = "From Space",
        string help = "Coordinate system the input is in. Common is the renderer's shading space (world in RenderMan renders).",
        string widget = "mapper",
        string options = "Common:0|Object:1|Shader:2|World:3|Camera:4|Screen:5|Raster:6|NDC:7",
        int connectable = 0
    ]],
    int To = OBJECT [[
        string label = "To Space",
        string help = "Coordinate system to transform into.",
        string widget = "mapper",
        string options = "Common:0|Object:1|Shader:2|World:3|Camera:4|Screen:5|Raster:6|NDC:7",
        int connectable = 0
    ]],

    output point Result = 0 [[ string label = "Result" ]]
) {
    string fromString;
    Result = transform(spaceIntToString(From), spaceIntToString(To), Input);
}