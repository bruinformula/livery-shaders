shader AutolibFloatToColor [[
    string category = "autolib",
]] (
    float Input = 0.0 [[ string label = "Input", string help = "The float to convert to a triple (copied to all channels)."  ]],
    float InputR = 0.0 [[ string label = "Input R", string help = "The float to place in the R component."  ]],
    float InputG = 0.0 [[ string label = "Input G", string help = "The float to place in the G component."  ]],
    float InputB = 0.0 [[ string label = "Input B", string help = "The float to place in the B component."  ]],

    output color RGB = 0
) {
    // Check if the primary 'Input' or the individual channels are connected
    int inputConnected = isconnected(Input);
    int rConnected = isconnected(InputR);
    int gConnected = isconnected(InputG);
    int bConnected = isconnected(InputB);

    if (inputConnected) {
        // If the main float is connected, use it for all three channels
        RGB = color(Input);
    } else if (rConnected || gConnected || bConnected || Input == 0.0) {
        // If any specific channel is connected, or Input is just at default 0
        // build the color from the R, G, and B parameters
        RGB = color(InputR, InputG, InputB);
    } else {
        // Fallback: Use the main input value
        RGB = color(Input);
    }
}