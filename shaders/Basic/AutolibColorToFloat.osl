
#define CHANNEL_R 0
#define CHANNEL_G 1
#define CHANNEL_B 2
#define LUMINANCE 3
#define AVERAGE 4

shader AutolibColorToFloat [[
    string label = "Color To Float",
    string help = "Reduces a color (or vector) to a float: one channel, the luminance or the channel average.",
    string rfh_classification = "RenderMan/Autolib/Convert",
    string rfm_classification = "rendernode/RenderMan/pattern/autolib/convert"
]] (
    color Input = 0.0 [[ string label = "Input", string help = "The color or vector to extract a float from." ]],
    int Mode = AVERAGE [[
        string label = "Mode",
        string help = "Which float to produce.",
        string widget = "mapper",
        string options = "Red:0|Green:1|Blue:2|Luminance:3|Average:4",
        int connectable = 0
    ]],

    output float ResultF = 0 [[ string label = "Result" ]]
) {
    if (Mode == CHANNEL_R) {
        ResultF = Input.r;
    } else if (Mode == CHANNEL_G) {
        ResultF = Input.g;
    } else if (Mode == CHANNEL_B) {
        ResultF = Input.b;
    } else if (Mode == LUMINANCE) {
        ResultF = luminance(Input);
    } else if (Mode == AVERAGE) {
        ResultF = (Input.r + Input.g + Input.b) / 3.0;
    } else {
        ResultF = 0.5;
    }
}