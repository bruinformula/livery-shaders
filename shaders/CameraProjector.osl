#ifndef SOLO_SHADER   
    #define ENTRY_CAMERA_PROJECTOR void 
#endif

#ifndef ENTRY_CAMERA_PROJECTOR
    #define  DEFAULT_CAMERA_PROJECTOR(x) = x
    #define ENTRY_CAMERA_PROJECTOR shader
#else
    #define  DEFAULT_CAMERA_PROJECTOR(x)
#endif

#include "Decal.h"

ENTRY_CAMERA_PROJECTOR CameraProjector [[ 
    string nodegroup = "autolib", 
]] (
    DecalParams decalParams  DEFAULT_CAMERA_PROJECTOR({}),

    // Texture
    int stickerMode  DEFAULT_CAMERA_PROJECTOR(0) [[ int uimin = 0, int uimax = 1, string doc = "UV sizing correction for images to maintain their size in world space" ]],
    vector aspect  DEFAULT_CAMERA_PROJECTOR(vector(1, 1, 0)) [[ string doc = "Aspect ratio (width/height) of the projection" ]],
    int useWidthImageAspect  DEFAULT_CAMERA_PROJECTOR(1) [[ int uimin = 0, int uimax = 1 ]],
    int autoGamma  DEFAULT_CAMERA_PROJECTOR(1) [[ int uimin = 0, int uimax = 1 ]],
    float manualGamma  DEFAULT_CAMERA_PROJECTOR(1.0) [[ float uimin = 0 ]],

    // Camera parameters
    point cameraPosition   DEFAULT_CAMERA_PROJECTOR(0),
    point targetPosition   DEFAULT_CAMERA_PROJECTOR(0),
    vector rightDirection   DEFAULT_CAMERA_PROJECTOR(vector(0,1,0)),
    vector upDirection   DEFAULT_CAMERA_PROJECTOR(vector(0,0,1)),

    // Projection controls
    float fov   DEFAULT_CAMERA_PROJECTOR(1) [[ float uimin = 0 ]],
    float overScan   DEFAULT_CAMERA_PROJECTOR(0.0) [[ float uimin = 0 ]],
    int backface   DEFAULT_CAMERA_PROJECTOR(0) [[ string uiname = "Project on Back", int uimin = 0, int uimax = 1 ]],
    int objectSpace  DEFAULT_CAMERA_PROJECTOR(0) [[ int uimin = 0, int uimax = 1 ]],

    // Outputs
    output point outUV   DEFAULT_CAMERA_PROJECTOR(0),
    output float outAlpha  DEFAULT_CAMERA_PROJECTOR(0),
    output color outColor  DEFAULT_CAMERA_PROJECTOR(0),
) {
    point camPos, targetPos, surfacePos;
    vector rightDir, upDir, surfaceNormal;
    
    if (objectSpace) {
        // initializes camera parameters in object space
        camPos = transform("", "object", cameraPosition);
        targetPos = transform("", "object", targetPosition);
        rightDir = normalize(transform("", "object", rightDirection));
        upDir = normalize(transform("", "object", upDirection));
        surfacePos = transform("object", P);  // P is in "common" space
        surfaceNormal = normalize(transform("", "object", N));
    } else {
        // common space by default
        camPos = cameraPosition;
        targetPos = targetPosition;
        rightDir = normalize(rightDirection);
        upDir = normalize(upDirection);
        surfacePos = P;
        surfaceNormal = N;
    }

    vector toTarget = normalize(targetPos - camPos);

    // Backface culling
    if (dot(surfaceNormal, toTarget) > 0.0 && backface == 0)
        return;

    vector toRight = normalize(rightDir);
    vector toTop   = cross(toRight, toTarget);

    vector toPoint = normalize(surfacePos - camPos);
    float dotTarget = dot(toTarget, toPoint);

    // Must be in front of cameraPosition
    if (dotTarget <= 0.0)
        return;

    // Project to unit distance
    toPoint /= dotTarget;

    float aspectRatio;         
    if (useWidthImageAspect) {
        int resolution[2]; // X, Y
        gettextureinfo(decalParams.filename, "resolution", resolution);
        aspectRatio = (float)resolution[1] / (float)resolution[0];
    } else {
        aspectRatio = aspect[1] / aspect[0];
    }

    float U = dot(toPoint, toRight);
    float V = dot(toPoint, toTop) / aspectRatio;

    float fovRadians = fov > M_PI ? radians(fov) : fov;
    float invTan = 1.0 / tan(fovRadians * 0.5);

    U *= invTan / (1.0 + overScan / 100.0);
    V *= invTan / (1.0 + overScan / 100.0);

    // Convert to 0–1 UV space
    U = (U + 1.0) * 0.5;
    V = (V + 1.0) * 0.5;

    outUV = point(U, V, 0);

    vector decalTest;

    Decal(
        outUV,
        decalParams,  
        0, // stretchCorrection – projector already handles sizing
        autoGamma,
        manualGamma,
        outColor,
        outAlpha,
        decalTest
    );
}
