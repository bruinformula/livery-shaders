#ifndef SOLO_SHADER   
    #define ENTRY_CREATE_DECAL void 
#endif

#ifndef ENTRY_CREATE_DECAL
    #define DEFAULT_CREATE_DECAL(x) = x
    #define ENTRY_CREATE_DECAL shader
#else
    #define DEFAULT_CREATE_DECAL(x)
#endif

#include "Decal.h"

// This should probably just be autogenerated
// the materialx nodedefs are the snake and lower case versions of the OSL funcs 

ENTRY_CREATE_DECAL CreateDecal [[ 
    string nodegroup = "autolib", 
]] (
    string filename DEFAULT_CREATE_DECAL(""),
    float width DEFAULT_CREATE_DECAL(0.1),
    string units DEFAULT_CREATE_DECAL("m"),
    output DecalParams params DEFAULT_CREATE_DECAL({})
) {
    params.filename = filename;
    params.width = width;
    params.units = units;
}