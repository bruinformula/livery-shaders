<?xml version="1.0"?>
<materialx version="1.38" colorspace="lin_rec709">

  <implementation name="IM_carbon_fiber_genosl" nodedef="ND_carbon_fiber" file="CarbonFiber.osl" function="CarbonFiber" target="genosl" />

  <nodedef name="ND_carbon_fiber" node="carbon_fiber" nodegroup="shader">
    <input name="scaleU" type="float" value="128.0" doc="Scale U axis of the carbon fiber pattern" />
    <input name="scaleV" type="float" value="64.0" doc="Scale V axis of the carbon fiber pattern" />
    <input name="roughness" type="float" value="0.15" doc="Surface roughness" />
    <input name="metalness" type="float" value="1.0" doc="Metalness of the surface" />
    <input name="resinAmount" type="float" value="0.25" doc="Amount of resin in the carbon fiber" />
    <input name="resinRoughness" type="float" value="0.35" doc="Roughness of the resin" />
    <input name="bumpStrength" type="float" value="0.1" doc="Strength of the bump effect" />
    <output name="out" type="surfaceshader" />
  </nodedef>

  <carbon_fiber name="carbon_fiber_shader" type="surfaceshader">
    <input name="scaleU" type="float" value="128.0" />
    <input name="scaleV" type="float" value="64.0" />
    <input name="roughness" type="float" value="0.15" />
    <input name="metalness" type="float" value="1.0" />
    <input name="resinAmount" type="float" value="0.25" />
    <input name="resinRoughness" type="float" value="0.35" />
    <input name="bumpStrength" type="float" value="0.1" />
  </carbon_fiber>

  <surfacematerial name="CarbonFiberMaterial" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="carbon_fiber_shader" />
  </surfacematerial>
  
</materialx>