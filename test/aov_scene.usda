        }
        def RenderVar "lpe35"
        {
            uniform string sourceName = "C<TD>[DS]*[<L.>O]"
            uniform token sourceType = "lpe"
            uniform token dataType = "color3f"
        }
        def RenderVar "lpe36"
        {
            uniform string sourceName = "C<TS>.*[<L.>O]"
            uniform token sourceType = "lpe"
            uniform token dataType = "color3f"
        }
        def RenderVar "occluded"
        {
            uniform string sourceName = "holdouts;C[DS]+<L.>"
            uniform token sourceType = "lpe"
            uniform token dataType = "color3f"
        }
        def RenderVar "unoccluded"
        {
            uniform string sourceName = "holdouts;unoccluded;C[DS]+<L.>"
            uniform token sourceType = "lpe"
            uniform token dataType = "color3f"
        }
        def RenderVar "shadow"
        {
