<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodedef name="ND_auto_paint_bsdf" node="auto_paint_bsdf">
    <input name="paint_color" type="color3" value="1.0, 0.1, 0.1" />
    <input name="mix_amount" type="float" value="0.5" />
    <output name="out" type="BSDF" />
  </nodedef>
  <nodegraph name="IMP_auto_paint_bsdf" nodedef="ND_auto_paint_bsdf">
    <carbon_fiber name="carbon" type="multioutput">
      <output name="Cout" type="BSDF" />
    </carbon_fiber>
    <metallic_paint name="metallic_paint" type="BSDF">
      <input name="primerColor" type="color3" interfacename="paint_color" />
    </metallic_paint>
    <mix name="mix_bsdf" type="BSDF">
      <input name="fg" type="BSDF" nodename="metallic_paint" />
      <input name="bg" type="BSDF" nodename="carbon" output="Cout" />
      <input name="mix" type="float" interfacename="mix_amount" />
    </mix>
    <output name="out" type="BSDF" nodename="mix_bsdf" />
  </nodegraph>
</materialx>
