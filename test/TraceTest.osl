
void traceIncomingRadiance(point pos, 
							  vector dir, float maxDist, 
							  output int didHit, 
							  output normal hitNormal,
							  output color result)
{
    // Trace with shade enabled to get shader data
    int hit = trace(pos, dir,
                    "mindist", 0.001,
                    "maxdist", maxDist,
                    "shade", 1);
    
    didHit = hit;
    hitNormal = normal(0, 0, 1);
    
    if (hit) {
        float hitdist = 0;
        point hitP = point(0);
        normal hitN = normal(0);
		closure color hitCi = 0;
        
        getmessage("trace", "hitdist", hitdist);
        getmessage("trace", "P", hitP);
        getmessage("trace", "N", hitNormal);
		getmessage("trace", "Ci", hitCi);
        
        // Try to get color/emission from the shader
        color radiance = color(0);
        color emission = color(0);
        color surfColor = color(0);
        
        // Try different possible output names
        if (getmessage("trace", "Ci", radiance)) {
            result = radiance;
        } else if (getmessage("trace", "out", radiance)) {
            result = radiance;
        } else if (getmessage("trace", "emission", emission)) {
            result = emission;  // Got emission directly!
        } else if (getmessage("trace", "Cs", surfColor)) {
            result = surfColor;
        } else {
            // fallback - compute a basic "lighting" based on surface orientation
            // This at least tells us we hit something and where it's facing
            float ndotl = max(0.0, dot(hitN, -dir));
            result = color(ndotl);  // White if facing light, black if facing away
        }
    }
}

shader TraceTest (
	output int didHit = 0, 
	output normal hitNormal = 0,
	output color incomingRadiance = 0,
    output float result = 0
) {
    vector lightDir = normalize(vector(0, 0, 1));  // Direction toward light
    float lightDist = 1000.0;  // Max distance to check
    
    traceIncomingRadiance(P + Ng * 0.001, lightDir, lightDist, didHit, hitNormal, incomingRadiance);


    if (raytype("shadow")) {
        result = 1;
    }
}