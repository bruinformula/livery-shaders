                    )
                    color3f[] primvars:displayColor = [(0.8, 0.8, 0.8)]
                    uniform token type = "linear"
                    float[] widths = [0.1, 0.1, 0.1, 0.1]
                    uniform token wrap = "nonperiodic"
                }
            }
        }
    }
}

