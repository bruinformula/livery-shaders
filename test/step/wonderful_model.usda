#usda 1.0
(
    defaultPrim = "Wonderful"
    metersPerUnit = 0.001
    subLayers = [
        @model1-assembly.usdc@
    ]
    upAxis = "Z"
)

def StepTesselationOptions "OptionsA"
{
    float step:meshAngularDeflection = 15
    float step:meshLinearDeflection = 0.1
}

def StepTesselationOptions "OptionsB"
{
    float step:meshAngularDeflection = 0.1
    float step:meshLinearDeflection = 0.1
}

def StepFileContainer "Wonderful"
{
    rel step:defaultParams = </OptionsA>
    asset step:sourceAsset = @model1.STEP@

    over "Prototypes" (
        active = false
        prepend payload = @model1-prototypes.usda@</Prototypes>
    )
    {
        over "rod0" (
            variantSets = "quality"
        )
        {
            variantSet "quality" = {
                "draft" (
                    references = </OptionsA>
                ) {

                }
                "final" (
                    references = </OptionsB>
                ) {

                }
            }
        }
    }
}

