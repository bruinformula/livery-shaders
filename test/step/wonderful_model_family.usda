#usda 1.0
(
    defaultPrim = "AmazingAssembly"
    metersPerUnit = 0.001
    subLayers = [
        @model1-assembly.usdc@,
        @model2-assembly.usdc@
    ]
    upAxis = "Z"
)

def Xform "AmazingAssembly"
{
    def StepTesselationOptions "OptionsA"
    {
        float step:meshAngularDeflection = 15
        float step:meshLinearDeflection = 0.1
    }

    def StepTesselationOptions "OptionsB"
    {
        float step:meshAngularDeflection = 0.1
        float step:meshLinearDeflection = 0.1
    }

    def StepFileContainer "Wonderful"
    {
        rel step:defaultParams = </AmazingAssembly/OptionsA>
        asset step:sourceAsset = @model1.STEP@

        over "Prototypes" (
            active = false
            prepend payload = @model1-prototypes.usdc@</Prototypes>
        )
        {
            over "rod0" (
                variantSets = "quality"
            )
            {
                variantSet "quality" = {
                    "draft" (
                        references = </AmazingAssembly/OptionsA>
                    ) {

                    }
                    "final" (
                        references = </AmazingAssembly/OptionsB>
                    ) {

                    }
                }
            }
        }
    }

    def StepFileContainer "Incredible"
    {
        rel step:defaultParams = </AmazingAssembly/OptionsA>
        asset step:sourceAsset = @model2.STEP@

        over "Prototypes" (
            active = false
            prepend payload = @model2-prototypes.usdc@</Prototypes>
        )
        {
            over "rod0" (
                variantSets = "quality"
            )
            {
                variantSet "quality" = {
                    "draft" (
                        references = </AmazingAssembly/OptionsA>
                    ) {

                    }
                    "final" (
                        references = </AmazingAssembly/OptionsB>
                    ) {

                    }
                }
            }
        }
    }
}

