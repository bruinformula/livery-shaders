#usda 1.0

over Xform "Mk11"
{
    over Scope "mtl"
    {
        over Scope "lib"
        {
            def Material "MetallicPaint"
            {
                token outputs:arnold:surface.connect = </Mk11/mtl/lib/MetallicPaint/MetallicPaintOSLShader.outputs:Cout>

                def Shader "MetallicPaintOSLShader"
                {
                    uniform token info:id = "arnold:MetallicPaintShader"
                    color3f inputs:baseColor = (1, 1, 1)
                    float inputs:baseIOR = 1.4
                    float inputs:baseRoughness = 0.5
                    float inputs:baseWeight = 1
                    float inputs:clearcoatAnisotropy = 0
                    float inputs:clearcoatExponent = 5
                    float inputs:clearcoatIOR = 1.4
                    float inputs:clearcoatRotation = 0
                    float inputs:clearcoatRoughness = 0.05
                    float inputs:clearcoatWeight = 1
                    color3f inputs:flakeColor = (1, 0.0224, 0)
                    float inputs:flakeDensity = 0.3133
                    float inputs:flakeRandomize = 0.5166
                    float inputs:flakeRoughness = 0.33
                    float inputs:flakeScale = 0.001
                    int inputs:flakeSeed = 1
                    color3f inputs:flakesIOR = (0, 0.9291, 0.9291)
                    float inputs:flakeWeight = 1
                    int inputs:numMetallicLayers = 2
                    color3f inputs:primerColor = (0, 0, 0)
                    float inputs:primerRoughness = 1
                    float inputs:primerWeight = 1
                    int inputs:useUV = 1
                    color3f outputs:Cout
                }
            }
        }
    }
}

